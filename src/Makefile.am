bin_SCRIPTS = dep

# 'dep' is generated by config.status from dep.in via @VAR@ substitution.
# AC_CONFIG_FILES doesn't preserve the source's permission bits (dep.in is
# 755, dep lands as 644), so we have to chmod after generation. bin_SCRIPTS
# handles install-time correctly via INSTALL_SCRIPT (mode 755), but the
# in-tree binary is also run by tests/smoke.sh and the bats suite, so the
# build-tree chmod has to be explicit. all-local fires after 'make all',
# the chmod is idempotent, and it's cheap enough to run unconditionally.
all-local: dep
	@chmod +x dep

