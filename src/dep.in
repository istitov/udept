# ============================================================================
# === PRELUDE & PATH CONSTANTS
# === PROG/VERSION/TAG vars, bash 4.2+ runtime check, shopt extglob, default
# === path constants (EPREFIX/EROOT/VARDB_DIR/EDB_DIR/PORTAGE_LIB_DIR/...).
# === resolve_eroot_paths() below reruns these assignments after probing
# === portageq, for Gentoo Prefix and chroot layouts.
# ============================================================================

PROG="dep"
SYNOPSIS="an inappropriate Portage engine"
VERSION="@PACKAGE_VERSION@"
TAG="@PACKAGE_TAG@"
DESCRIPTION="List dependencies and reverse dependencies of packages, and clean the world file and the set of installed packages."

# Need bash 4.2+ for `declare -gA` (used by read_repos_config), nameref-ish
# patterns, and various ${var//pat/repl} forms. Fail clearly rather than
# producing garbage on bash 3 (still default on macOS, some BSDs).
if (( BASH_VERSINFO[0] < 4 \
      || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2) )); then
	echo "$0: needs bash >= 4.2 (have ${BASH_VERSION})" >&2
	exit 1
fi

shopt -s extglob
# Bash 5.2's patsub_replacement option makes an unquoted '&' in the
# replacement side of ${parameter//pattern/replacement} expand to the matched
# text.  udept's output escaping must have identical semantics on every
# supported Bash, so keep the historical literal-replacement behaviour.
shopt -u patsub_replacement 2>/dev/null || true

spaces="                                                                                "
spaces="${spaces:0:${COLUMNS:=80}}"

# Path constants default to the standard EROOT=/ EPREFIX='' layout so the
# usage/version/help short-circuits don't have to call portageq just to
# print text. resolve_eroot_paths (below) reruns the assignments after
# asking portageq about the real EROOT/EPREFIX — the result is identical
# for /-rooted setups but correct on Gentoo Prefix and chroot.
EPREFIX="${EPREFIX:-}"
EROOT="${EROOT:-}"
PORTAGE_CONFIGROOT="${PORTAGE_CONFIGROOT:-}"
VARDB_DIR="/var/db/pkg"
# EDB_DIR is set as part of the path-roots scaffolding (mirrors the
# others, updated by resolve_eroot_paths for Gentoo Prefix / chroot
# layouts) but currently unread inside dep.in itself. Kept for
# downstream callers and for the deferred EDB-cache integration on
# the post-0.7.0 roadmap (native depclean).
# shellcheck disable=SC2034
EDB_DIR="/var/cache/edb"
PORTAGE_LIB_DIR="/var/lib/portage"
PORTAGE_LOG_DIR="/var/log/portage"
ETC_PORTAGE_DIR="/etc/portage"
WORLD_FILE="${PORTAGE_LIB_DIR}/world"
WORLD_SETS_FILE="${PORTAGE_LIB_DIR}/world_sets"
ETC_PORTAGE_SETS_DIR="${ETC_PORTAGE_DIR}/sets"

# Called from main() after the help/version/usage short-circuit so a
# trivial 'dep --version' doesn't pay portageq's ~150ms startup.
# ============================================================================
# === EROOT RESOLUTION
# === resolve_eroot_paths — called from main() after the help/version/usage
# === short-circuit so trivial 'dep --version' doesn't pay portageq's startup.
# ============================================================================

# resolve_eroot_paths: probe portageq for EROOT/EPREFIX and rebind path constants for Prefix/chroot.
function resolve_eroot_paths() {
	# Fast path for the standard /-rooted layout — the defaults at the
	# top of the script are already correct, and we save a portageq
	# round-trip per invocation. The directory check is cheap.
	local explicit_roots="${EROOT:+yes}${EPREFIX:+yes}${PORTAGE_CONFIGROOT:+yes}"
	[[ -z "$explicit_roots" \
		&& -z "${PORTAGE_CONFIGROOT:-}" \
		&& -d /var/db/pkg && ! "${PORTAGE_OVERRIDE_EPREFIX:-}" ]] && return
	if [[ -z "$explicit_roots" ]] && command -v portageq >/dev/null 2>&1; then
		eval "$(portageq envvar -v EPREFIX EROOT 2>/dev/null)"
	fi
	case "${EROOT:-/}" in /*) ;; *)
		format_error <<<"dep: EROOT must be absolute: $EROOT" >&2; return 1;;
	esac
	case "${EPREFIX:-/}" in /*) ;; *)
		format_error <<<"dep: EPREFIX must be absolute: $EPREFIX" >&2; return 1;;
	esac
	case "${PORTAGE_CONFIGROOT:-/}" in /*) ;; *)
		format_error <<<"dep: PORTAGE_CONFIGROOT must be absolute: $PORTAGE_CONFIGROOT" >&2; return 1;;
	esac
	EPREFIX="${EPREFIX:-}"; EPREFIX="${EPREFIX%/}"
	EROOT="${EROOT:-/}";   EROOT="${EROOT%/}"
	PORTAGE_CONFIGROOT="${PORTAGE_CONFIGROOT:-}"; PORTAGE_CONFIGROOT="${PORTAGE_CONFIGROOT%/}"
	# With no explicit roots, the standard /-layout defaults above are already
	# correct. A standalone PORTAGE_CONFIGROOT still needs to relocate
	# /etc/portage, even when EROOT and EPREFIX are empty.
	[[ -z "$EROOT" && -z "$EPREFIX" && -z "$PORTAGE_CONFIGROOT" ]] && return
	VARDB_DIR="${EROOT}/var/db/pkg"
	# Same scaffolding-for-future-EDB-integration as the global decl.
	# shellcheck disable=SC2034
	EDB_DIR="${EROOT}/var/cache/edb"
	PORTAGE_LIB_DIR="${EROOT}/var/lib/portage"
	PORTAGE_LOG_DIR="${EROOT}/var/log/portage"
	ETC_PORTAGE_DIR="${PORTAGE_CONFIGROOT}${EPREFIX}/etc/portage"
	WORLD_FILE="${PORTAGE_LIB_DIR}/world"
	WORLD_SETS_FILE="${PORTAGE_LIB_DIR}/world_sets"
	ETC_PORTAGE_SETS_DIR="${ETC_PORTAGE_DIR}/sets"
}

# html_render_stream: escape an arbitrary byte stream and translate only the
# SGR/OSC sequences emitted by udept into fixed HTML markup.  All package
# metadata, paths, argv, diagnostics, and control characters pass through this
# one boundary, so none can be interpreted as markup.  A colour change closes
# the previous span before opening another; EOF closes a still-active span.
function html_render_stream() {
	LC_ALL=C awk '
	BEGIN {
		esc = sprintf("%c", 27); bel = sprintf("%c", 7)
		sgr[esc "[0;01m"] = "BR"
		sgr[esc "[31;01m"] = "RD"; sgr[esc "[00;31m"] = "dkRd"
		sgr[esc "[32;01m"] = "GR"; sgr[esc "[00;32m"] = "dkGr"
		sgr[esc "[33;01m"] = "YL"; sgr[esc "[00;33m"] = "dkYl"
		sgr[esc "[34;01m"] = "BL"; sgr[esc "[00;34m"] = "dkBl"
		sgr[esc "[35;01m"] = "FC"; sgr[esc "[00;35m"] = "dkFc"
		sgr[esc "[36;01m"] = "CY"; sgr[esc "[00;36m"] = "dkCy"
	}
	function escaped(s) {
		gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s)
		gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s)
		gsub(/\047/, "\\&#39;", s)
		gsub(/[\001-\010\013\014\016-\037\177]/, "", s)
		return s
	}
	function close_span() { if (active) { printf "</span>"; active = 0 } }
	{
		s = $0; i = 1
		while (i <= length(s)) {
			if (substr(s, i, 1) != esc) {
				j = index(substr(s, i), esc)
				if (!j) { printf "%s", escaped(substr(s, i)); i = length(s) + 1 }
				else { printf "%s", escaped(substr(s, i, j - 1)); i += j - 1 }
				continue
			}
			matched = 0
			for (seq in sgr) if (substr(s, i, length(seq)) == seq) {
				close_span(); printf "<span class=\"%s\">", sgr[seq]
				active = 1; i += length(seq); matched = 1; break
			}
			if (matched) continue
			if (substr(s, i, 6) == esc "[0;0m" || substr(s, i, 4) == esc "[0m") {
				close_span(); i += (substr(s, i, 6) == esc "[0;0m" ? 6 : 4)
				continue
			}
			if (substr(s, i, 4) == esc "]2;") {
				rest = substr(s, i + 4); end = index(rest, bel)
				if (end) {
					close_span()
					printf "<div class=\"titlebar\">%s</div>", escaped(substr(rest, 1, end - 1))
					i += 3 + end + 1; continue
				}
			}
			# Unknown terminal controls are data neither HTML nor a terminal
			# should execute.  Drop the introducer and continue escaping.
			i++
		}
		printf "\n"
	}
	END { close_span() }
	'
}

function html_escape_text() {
	printf '%s' "$*" | html_render_stream
}

# ============================================================================
# === HELP / USAGE / ARG DECLARATION
# === help_fmt, fmt_w, print_version, print_usage, shopt_help, print_help,
# === arg, handle_arg_action, handle_arg_info, handle_arg_opt — plus the 42
# === source-time `arg ...` invocations between arg() and handle_arg_action
# === that populate the option tables driving --help, the man page, and
# === bash + zsh completions (same arrays dumped into completion/_dep).
# === Adding a flag = one new `arg ...` line in that block.
# ============================================================================

# help_fmt: stdin -> stdout sed: colourise headings, options, usage tokens for --help output.
function help_fmt() {
	PLUSMINUS="$(iconv -c -f UTF-8 <<<$'\xc2\xb1')" || PLUSMINUS="+-"
	sed -r -e "
	s![[:upper:]_]{2,}!${RD}\\0${NO}!g
	s!( |^)$PROG( |$)!$Cy\\0$NO!
	s!^[^[:space:]].*:!$YL\\0$NO!
	s!((^|,|\\()[[:space:]]*)(-[[:alpha:]?-]+)!\\1${FC}\\3${NO}!g
	s!\\\\\\(\\+-([[:alnum:]])!${FC}${PLUSMINUS}\\1${NO}!g
	s!( |^)/[^[:space:]]+!$GR\\0$NO!
	s![[:alpha:]]+\([[:digit:]]+\)!${BL}\\0${NO}!
	s!^(An? ([[:alpha:]]+ ){1,3}is )([[:alpha:]]+)!\\1${BR}\\3${NO}!
	s!(\\[=?|,)([[:alpha:]]+)(,|\\])!\\1${FC}\\2${NO}\\3!g
	s!(\\[|,)([[:alpha:]]+)(,|\\])!\\1${FC}\\2${NO}\\3!g
	s!<[[:alnum:]._-]+@[[:alnum:]._-]+>!${Fc}\\0${NO}!g
	"
}

# Yes, a word wrap algorithm. I rock.
function fmt_w() {
	local cols=${1:-$COLUMNS} l1indent=${2:-0} lxindent=${3:0}
	local l n i c esc nlesc line lnum=1 indent
	while read line; do
		((lnum == 1)) \
		&& { ((n = l1indent)); echo -n "${spaces:0:$l1indent}"; } \
		|| { ((n = lxindent)); echo -n "${spaces:0:$lxindent}"; }
		((i = 0)); c=${line:0:1}; esc=""; nlesc=""
		while ((i<${#line})); do case "$c" in
			$'\x1b')
				echo -n "$esc"
				while [[ "$c" != 'm' ]]; do
					esc="$esc$c"
					((++i)); ((i > ${#line})) && break
					c="${line:$i:1}"
				done; esc="$esc$c"
				((++i)); c="${line:$i:1}";;
			$'\x9') 
				echo -n "$c"
				((n += 8)); ((n >= cols)) && ((n = cols-1))
				((++i)); c="${line:$i:1}";;
			[[:space:]])
				if ((n < cols)); then echo -n "$c"; ((++n)); fi
				((++i)); c="${line:$i:1}";;
			[^[:print:]]) 
				echo -n "$c"
				((++i)); c="${line:$i:1}";;
			[[:graph:]]) 
				word=""; ((l=0))
				while [[ "$c" == [[:graph:]] ]]; do
					word="$word$c"; ((++l))
					((++i)); ((i <= ${#line})) || break
					c="${line:$i:1}"
				done || continue
				if (( n == cols )); then
					echo; echo -n "${spaces:0:$lxindent}"
					echo -n "$nlesc"
					((++lnum, n = lxindent))
				fi
				if (( n + l <= cols )); then
					echo -n "$esc$word"
					((n += l))
				elif (( n <= cols * 3 / 4 )); then
					if [[ "$esc" ]]; then
						echo "$esc${word:0:$((cols-n))}"
						echo -n "$esc${word:$((cols-n))}"
					else
						echo -n "$word"
					fi
					((++lnum, n += l - cols))
				else
					echo; echo -n "${spaces:0:$lxindent}"
					echo -n "$nlesc$esc$word"
					((++lnum, n = l + lxindent))
				fi
				[[ "$esc" ]] && nlesc="$esc"; esc="";;
			*) echo Oops: fmt_w: $i >&2; ((++i));;
		esac; done
		echo "$esc"
		((++lnum))
		continue
	done
	[[ "$line" ]] && echo -n "$line" 	# unterminated last line
}

# print_version: echo 'PROG vVERSION "TAG"' header.
function print_version() {
	cat <<END
${PROG} v. ${VERSION} "${TAG}"
END
}
# print_usage: print version + synopsis + wrapped usage line + description.
function print_usage() {
	print_version
	echo "    ${SYNOPSIS}!"
	echo
	fmt_w '' '' 40 <<<"Usage: ${PROG} ${USELINE}"
	fmt_w <<<"${DESCRIPTION}"
}

# shopt_help: format a column of options for one shopt_category ($1: action/info/opt) at widths $2,$3.
function shopt_help() {
	local line i j c1=$2 c2=$3
	for ((i=0; i<shopt_count; ++i)); do
		[[ "${shopt_category[$i]}" == "$1" ]] || continue
		line="  "
		for ((j=0; j<${#shopt_short[$i]}; ++j)); do
			[[ "${shopt_category[$i]}" == opt ]] \
				&& line="${line}\\(+-" || line="${line}-"
			line="${line}${shopt_short[$i]:$j:1}"
			[[ "${shopt_itype[$i]}" == "NUMBER" ]] && line="${line}[num]"
			line="${line}, "
		done
		(( ${#shopt_short[$i]} )) || line="${line}    "
		line="${line}--${shopt_long[$i]}"
		if [[ "${shopt_itype[$i]}" == "NUMBER" ]]; then
			line="${line}[=num]"
		elif [[ "${shopt_itype[$i]}" == [[:lower:]]* ]]; then
			line="${line}[=${shopt_itype[$i]}]"
		fi
		(( ${#line} < c1 )) && line="${line}${spaces:0:$((c1-${#line}))}"
		line="${line} ${shopt_desc[$i]}"
		if [[ "${shopt_idefault[$i]}" ]]; then
			(( (${#line}+${#shopt_idefault[$i]}) < c2 )) && line="${line}${spaces:0:$((c2-(${#line}+${#shopt_idefault[$i]})))}"
			line="${line} (${shopt_idefault[$i]})"
		fi
		echo "$line"
	done
}

INSTRUCTIONS="A package is unneeded if there is no installed package that depends on it. As a special case, the running kernel's sources are needed.
A world file entry is redundant if another installed package depends on it. The world-file path follows the resolved Portage root (EROOT). In --ask mode, selecting Merge invokes sdiff(1); direct replacement does not.
Spring-clean will help find large sets of unneeded packages and orphaned circular dependency loops.
Environment variables such as USE and ACCEPT_KEYWORDS override values resolved from the active Portage configuration."
# print_help: drive the full --help layout: usage, then action/info/opt sections via shopt_help.
function print_help() {
	echo
	print_usage
	echo; echo "Action selection:"
	shopt_help action 28 77
	echo; echo "Info types:"
	shopt_help info 28 77
	echo; echo "Options: (--option=[yes,no] unless otherwise indicated)                (default)"
	shopt_help opt 28 77
	fmt_w <<<"$INSTRUCTIONS"
	cat <<END

$PROG is copyright Ed Catmur <ed@catmur.co.uk> and contributors. Distributed
under the terms of the GNU General Public License version 3. NO WARRANTY given.
END
}

declare -i shopt_count=0
declare -a shopt_category shopt_short shopt_long shopt_desc shopt_type shopt_itype shopt_idefault
# arg: register one CLI flag into the shopt_* parallel arrays (and predefault opt_arg_* on yes/auto).
function arg() { 
	shopt_category[$shopt_count]="$1"
	shopt_short[$shopt_count]="$2"
	shopt_long[$shopt_count]="$3"
	shopt_desc[$shopt_count]="$4"
	shopt_type[$shopt_count]="$5"
	shopt_itype[$shopt_count]="$6"
	shopt_idefault[$shopt_count]="$7"
	if [[ "$1" == opt ]]; then
		shopt_varname[$shopt_count]="opt_arg_${3//-/_}"
		[[ "$7" == @(yes|auto) ]] && eval ${shopt_varname[$shopt_count]}="$7"
	fi
	((shopt_count++))
}

# remaining option letters:
# -            m           y  +  cdefghijklm    rstu wxyz
# -AB    GHIJ  MNO       W YZ +ABCDEFGHIJ LMNOPQRSTUVWXYZ
# - 234567890                 + 234567890
USELINE="[OPTION]... [ACTION | INFO-TYPE [PACKAGE | VIRTUAL | FILE | USE | CATEGORY | PATTERN]...]"

arg action '' usage		"Display usage"
arg action 'h?' help	"Display this help"
arg action V version 	"Show version"
arg action P purge 	"Unmerge unneeded SLOTted packages (of PACKAGE...)" PNAME
arg action d depclean 	"Unmerge all unneeded packages (of PACKAGE...)" PNAME
arg action w pruneworld "Remove redundant entries from the world file"
arg action E filter-etc-portage "Remove redundant entries from files in /etc/portage"
arg action s spring-clean "An incredibly slow recursive depclean"
arg action O overlay-clean "Identify unused ebuilds in an overlay" DIRECTORY

do_arg_info=""
do_package_sizes=""
arg info c category 	"Show category resolutions of PACKAGE" 	  PNAME,PACKAGE 
arg info C catpackages 	"Show packages in CATEGORY" 				   CATEGORY 
arg info e versions 	"List versions of PACKAGE, with status" 		PNAME
arg info f contents 	"List contents of PACKAGE" 						XPACKAGE
arg info F owners 		"List packages owning FILE"					FILE,STRING
arg info g search 		"Search for packages matching PATTERN"			STRING
arg info i info    "Display PACKAGE info (HOMEPAGE, DESCRIPTION, etc.)" PACKAGE
arg info j changelog 	"Display Portage ChangeLog entries for PACKAGE" PACKAGE,PNAME NUMBER
arg info k keywords		"Show per-arch keyword status for PACKAGE" 		PNAME
arg info l depends		"(default) List dependencies of PACKAGE" 		PACKAGE
arg info L rev-depends 	"List reverse dependencies of PACKAGE" 	  PNAME,PACKAGE
arg info r provides 	"List virtuals PACKAGE provides" 				PACKAGE
arg info Q required-use "Check REQUIRED_USE of PACKAGE against active USE" PACKAGE
arg info R virtuals		"List packages providing VIRTUAL" 				VIRTUAL
arg info S depstrings	"Display the dependency strings for PACKAGE" 	PACKAGE
arg info t tree-depends "Display the full dependency tree for PACKAGE" 	PACKAGE
arg info T reverse-tree "Display the reverse dependency tree for PACKAGE" PACKAGE,PNAME
arg info u usedesc		"Show USE flags and descriptions of PACKAGE" 	PACKAGE
arg info U iuse			"List packages that (say they) respect USE" 	USE
arg info x exists		"Show whether PACKAGE depends on later PACKAGEs" PACKAGE LEGION
arg info X rev-exists	"Show whether later PACKAGEs depend on PACKAGE" PNAME,PACKAGE LEGION
arg info z size			"Display disk space used by PACKAGE" 			PACKAGE

arg opt K colour 		"Colour output" 			    '' yes,no,auto,html auto
arg opt v verbose  	"Verbosity level (cumulative)" '' NUMBER "1 console, 0 pipe"
arg opt 1 "for-emerge" "Produce output suitable for emerge --oneshot" '' BINARY no
arg opt '' "full-atoms" "With --for-emerge, append :slot and ::repo to atoms" '' BINARY no
arg opt b build-time "Include deps needed to build PACKAGE" 	   '' BINARY yes
arg opt o original-depends "Calculate deps as when PACKAGE was merged" '' BINARY no
arg opt q unique-depends "Show dependencies that only PACKAGE requires" '' BINARY no
arg opt D depth "Depth to follow dependency trees" '' NUMBER unlimited
arg opt n uninstalled 	"Include uninstalled packages in searches" '' BINARY no
arg opt a ask 			"Prompt before applying changes" '' BINARY no
arg opt p pretend 		"Preview changes without applying them" '' BINARY no
arg opt '' force          "Apply changes without prompting" '' BINARY no

# handle_arg_action: argv-parser callback: set do_arg_action when $1 matches the long/short name at idx $2.
function handle_arg_action() {
	case "$1" in
		"--${shopt_long[$2]}" | "-"[${shopt_short[$2]}] )
			do_arg_action="${shopt_long[$2]}";;
		*) 						return 1;;
	esac
}

# handle_arg_info: argv-parser callback for info flags; also harvests --changelog/-j NUMBER into changelog_entries and --size/-z into do_package_sizes.
function handle_arg_info() {
	case "$1" in
		"--size" | "-z" ) 
			do_package_sizes="yes";;
		"--changelog="+([[:digit:]]) )
			do_arg_info="${shopt_long[$2]}"; changelog_entries=${1#*=};;
		-j )
		  	do_arg_info="${shopt_long[$2]}"
			if ((j+1 == ${#optargs[$i]})); then
				if [[ "${optargs[$((i+1))]}" == +([[:digit:]]) ]]; then
					changelog_entries=${optargs[$((++i))]}
					[[ $changelog_entries == 0 ]] \
						|| changelog_entries=${changelog_entries##+(0)}
					# `continue` here targets the caller's argv `for` loop
					# (around line 359) — bash propagates `continue` up
					# through function calls to the nearest enclosing loop.
					# shellcheck disable=SC2104
					continue
				fi
			else
				for ((k=++j; j<${#optargs[$i]}; ++j)); do
					[[ "${optargs[$i]:$j:1}" == [[:digit:]] ]] || break
				done
				((j > k)) && changelog_entries=${optargs:$k:$((j-k))}
				((--j))
			fi;;
		"--${shopt_long[$2]}" | "-"[${shopt_short[$2]}] )
			do_arg_info="${shopt_long[$2]}";;
		*) 
			return 1;;
	esac
}

# handle_arg_opt: argv-parser callback for opts; handles +/-/-=yes/no/NUMBER variants and sets opt_arg_* globals.
function handle_arg_opt() {
	case "$1" in
		+K ) 							opt_arg_colour="no";;
		--colour=@(yes|no|auto|html) ) 	opt_arg_colour="${1#*=}";;
		--verbose | -v ) 				((++opt_arg_verbose));;
				    +v ) 				((--opt_arg_verbose));;
		--verbose=yes ) 				opt_arg_verbose=1;;
		--verbose=no ) 					opt_arg_verbose=0;;
		@(--verbose|-v)=+([[:digit:]]) ) opt_arg_verbose="${1#*=}";;
		--depth@(|=unlimited) )			opt_arg_depth=;;
		-D )							((++opt_arg_depth));;
		+D )							((--opt_arg_depth));;
		@(--depth|-D)=+([[:digit:]]) )	opt_arg_depth="${1#*=}";;
		"--${shopt_long[$2]}"?(=yes) | "-"[${shopt_short[$2]}] )
										eval ${shopt_varname[$2]}="yes";;
		"--${shopt_long[$2]}"=no | "+"[${shopt_short[$2]}] )
										eval ${shopt_varname[$2]}="";;
		* )								return 1;;
	esac
}

optargs=("$@")
# ============================================================================
# === ARGV PARSER
# === args=() and the optargs case-loop translating user-supplied argv into
# === do_arg_action / do_arg_info / args[] state for main() to dispatch on.
# === Source-time block (runs on every `dep` invocation).
# ============================================================================

args=()
(( ${#optargs[@]} == 0 )) && do_arg_action="usage" || do_arg_action=""
for ((i=0; i<${#optargs[@]}; ++i)); do case "${optargs[$i]}" in
	--exec )
		do_arg_action="exec"; args=("${optargs[@]:$((i+1))}"); break;;

	-- )
		args=("${args[@]}" "${optargs[@]:$((i+1))}"); break;;
	
	--* )
		happy=""
		for ((j=0; j<shopt_count; ++j)); do
			[[ "${optargs[$i]}" == "--${shopt_long[$j]}"?(=*) ]] || continue
			[[ "${shopt_itype[$j]}" == NUMBER \
				&& "${optargs[$i]}" == "--${shopt_long[$j]}" \
				&& "${optargs[$((i+1))]}" == +([[:digit:]]) ]] \
				&& optargs[$i]="${optargs[$i]}=${optargs[$((++i))]}"
			case "${shopt_category[$j]}" in 
				action) handle_arg_action "${optargs[$i]}" $j && happy="yes";;
				info) handle_arg_info "${optargs[$i]}" $j && happy="yes";;
				opt) handle_arg_opt "${optargs[$i]}" $j && happy="yes";;
			esac
			[[ "$happy" ]] && break
		done
		[[ "$happy" ]] || do_arg_action="usage";;

	[+-]* ) 
		for ((j=1; j<${#optargs[$i]}; ++j)); do 
			happy=""
			for ((k=0; k<shopt_count; ++k)); do
				[[ ${shopt_short[$k]} == *"${optargs[$i]:$j:1}"* ]] || continue
				myarg="${optargs[$i]:0:1}${optargs[$i]:$j:1}"
				if [[ "${shopt_itype[$k]}" == NUMBER ]]; then
					if [[ "${optargs[$i]:$((j+1)):1}" == [[:digit:]] ]]; then
						myarg="${myarg}=${optargs[$i]:$((++j)):1}"
						while [[ "${optargs[$i]:$((j+1)):1}" == [[:digit:]] ]]
						do myarg="${myarg}${optargs[$i]:$((++j)):1}"; done
					elif (( j == ${#optargs[$i]} - 1 )) \
						&& [[ "${optargs[$((i+1))]}" == +([[:digit:]]) ]]; then
						myarg="${myarg}=${optargs[$((++i))]}"
						j=${#optargs[$i]}
					fi
				fi
				case "${shopt_category[$k]}" in 
					action) handle_arg_action "$myarg" $k && happy="yes";;
					info) handle_arg_info "$myarg" $k && happy="yes";;
					opt) handle_arg_opt "$myarg" $k && happy="yes";;
				esac
				[[ "$happy" ]] && break
			done
			[[ "$happy" ]] || do_arg_action="usage"
		done;;
	
	* ) args[${#args[@]}]="${optargs[$i]}";;
esac; done

if [[ -z "$do_arg_info" ]]; then
	[[ "$do_package_sizes" ]] \
		&& do_arg_info="size" \
		|| do_arg_info="depends"
fi

for ((i=0; i<shopt_count; ++i)); do
	[[ "${shopt_long[$i]}" == "${do_arg_info}" ]] || continue
	do_info_shopt_idx=$i
done

action_mode_count=0
[[ "$opt_arg_pretend" ]] && ((++action_mode_count))
[[ "$opt_arg_ask" ]] && ((++action_mode_count))
[[ "$opt_arg_force" ]] && ((++action_mode_count))
if (( action_mode_count > 1 )); then
	arg_error="--pretend, --ask, and --force are mutually exclusive"
	do_arg_action="usage"
fi

if [[ "$opt_arg_force" ]]; then
	do_action="force"; portage_action_arg=""
elif [[ "$opt_arg_ask" ]]; then
	do_action="ask"; portage_action_arg="--ask"
else
	do_action="pretend"; portage_action_arg="--pretend"
fi

[[ "$do_arg_info" == "owners" ]] && load_config="" || load_config="yes"

[[ "$do_arg_info" == "search" && -z "${args[*]}" ]] && args=('*')

[[ -z "$do_arg_action" && "${args[*]}" ]] && do_arg_action="info"

[[ -t 1 ]] && outputtoterminal="yes" || outputtoterminal=""

[[ "$opt_arg_colour" == auto ]] && opt_arg_colour=$outputtoterminal

if [[ -z "$opt_arg_verbose" ]]; then
	[[ "$outputtoterminal" ]] && opt_arg_verbose=1 || opt_arg_verbose=0
fi

if [[ "$opt_arg_for_emerge" ]]; then
	opt_arg_verbose=0
	opt_arg_colour=""
	outputtoterminal=""
fi

if [[ "$opt_arg_colour" == "yes" || "$opt_arg_colour" == "html" ]]; then
	NO=$'\x1b[0;0m'
	BR=$'\x1b[0;01m'
	RD=$'\x1b[31;01m' Rd=$'\x1b[00;31m'
	GR=$'\x1b[32;01m' Gr=$'\x1b[00;32m'
	YL=$'\x1b[33;01m' Yl=$'\x1b[00;33m'
	BL=$'\x1b[34;01m' Bl=$'\x1b[00;34m'
	FC=$'\x1b[35;01m' Fc=$'\x1b[00;35m'
	CY=$'\x1b[36;01m' Cy=$'\x1b[00;36m'
else
	for x in NO BR RD Rd GR Gr YL Yl BL Bl FC Fc CY Cy; do
		eval $x=""
	done
fi

# HTML is implemented as an outer encoder process around an otherwise normal
# coloured invocation.  Start it before the help/version short-circuit so
# those paths receive the same escaping as full Portage-backed commands.
if [[ "$0" == */dep && "$opt_arg_colour" == "html" \
	&& -z "${UDEPT_HTML_RENDERING:-}" ]]; then
	UDEPT_HTML_RENDERING=1 "$0" "$@" 2>&1 | html_render_stream
	exit "${PIPESTATUS[0]}"
fi

# short-circuit portage import
[[ "$0" == */dep ]] && case "$do_arg_action" in
	help) print_help | help_fmt; exit;;
	version) print_version | help_fmt; exit;;
	usage)
		[[ "$arg_error" ]] && printf 'dep: %s\n' "$arg_error" >&2
		print_usage | help_fmt
		[[ "$arg_error" ]] && exit 2 || exit 0;;
esac

# ============================================================================
# === HTML & STACK UTILS
# === html_wrap, stacking_sort, kill_comments_and_blanks.
# ============================================================================

# html_wrap: wrap a 'dep ...' run as a styled <pre>; re-execs dep with --colour=html and the original argv.
function html_wrap() {
	local escaped_title escaped_command
	escaped_title=$(html_escape_text "$PROG $*")
	escaped_command=$(html_escape_text "$PROG $*")
	cat <<END
<html>
<head>
	<title>${escaped_title}</title>
	<style>
		pre.terminal { background-color: white; border: solid thin; 
			padding-left: 2px; padding-right: 2px; 
			text-wrap: unrestricted; }
		span.BR { font-weight: bold; }
		span.RD { font-weight: bold; color: #FF5555; }
		span.dkRd { color: #AA0000; }
		span.GR { font-weight: bold; color: #55FF55; }
		span.dkGr { color: #00AA00; }
		span.YL { font-weight: bold; color: #E9D643; }
		span.dkYl { color: #BB6C1C; }
		span.BL { font-weight: bold; color: #5555FF; }
		span.dkBl { color: #0000AA; }
		span.FC { font-weight: bold; color: #FF55FF; }
		span.dkFc { color: #AA00AA; }
		span.CY { font-weight: bold; color: #25E2E2; }
		span.dkCy { color: #018686; }
		div.titlebar { background-color: #e0e0e0; 
			border-top: solid thin; 
			border-bottom: solid thin; 
			margin-top: 1px; margin-bottom: 1px; 
			padding-left: 2px; padding-right: 2px;
			position: relative; left: -2px; width: 100%;
		}
		pre.terminal > div.titlebar:first-child {
			margin-top: 0px; border-top: none;
		
	</style>
</head>
<body>
	<pre class="terminal">
<span class="BL">$([[ "$EUID" == 0 ]] && echo '#' || echo '$')</span> ${escaped_command}
END
	$PROG --verbose --colour=html "$@"
cat <<END
	</pre>
</body>
</html>
END
}

trap 'exit 1' SIGINT

# TODO split this into a separate libportage.sh package

# A Portage library written in bash, for bash scripts.
# Designed to be lightweight yet full-featured.
# Copyright (c) 2004 Ed Catmur <ed@catmur.co.uk>
# Licensed under the GPL, version 3.

# Conventions:
# Whenever you see "mlsr" that means a full version specifier:
# mega.macro.major.minor.micro(letter)-status-revision
# When constructing pipelines, do not leave | tokens as the last character of
# the feeding line; they should begin the next line. Similar for && and ||.
# Keep if and then, for/while and do, on the same line where possible
# (think 1TBS)
# needle is being sought (in a haystack, normally)

temp_dir="$(mktemp -t -d dep.XXXXXXXX)" || exit 1
# Cleanup runs from the EXIT trap only; SIGTERM (like the SIGINT trap
# above) just exits so it fires exactly once and the script stops there.
# Previously TERM shared this rm WITHOUT exiting, so after deleting the
# dir the script kept running and reading/writing it — spewing 'No such
# file' errors when a long --pruneworld / --spring-clean was cut short by
# timeout(1) or kill. 2>/dev/null still guards the dir already being gone
# (e.g. /tmp reaped). Double-quote (vs single) snapshots $temp_dir at
# trap-set time — the dir was just created so the value is known good;
# SC2064 hints at single-quoting for deferred expansion, but we want the
# snapshot semantic.
# shellcheck disable=SC2064
trap "rm -rf $temp_dir 2>/dev/null" EXIT
# 143 = 128 + SIGTERM(15); mirrors the `exit 1` SIGINT trap above so the
# EXIT cleanup runs once and execution doesn't continue past the signal.
trap 'exit 143' TERM

# A useful trick to stack e.g. USE flags
# 0. Concatenate the lists, from highest to lowest priority (i.e. in reverse 
# order of application)
function stacking_sort() {
	discard_negatives="$1"
# 1. Transform removals from `-foo' to `foo -':
	sed 's/^-\(.*\)$/\1 -/' | \
# 2. Pipe the resulting mess through the `stacking sort':
	sort -s -k1,1 -u | \
# this is a stable sort on first column, unique i.e. output first for each key
# 3. Finally reverse the transform:
	if [[ "$discard_negatives" ]]; then
		sed -e '/ -$/d'
	else
		sed -e 's/^\(.*\) -$/-\1/'
	fi 2>/dev/null
# Example:
#	AFTER 0.	AFTER 1.	AFTER 2.	AFTER 3.
# 	foo		foo		foo		foo
#	-bar		bar -		bar -		-bar (if not $1)
#	-foo		foo -
#	baz		baz		baz		baz
#	bar		bar
}

# kill_comments_and_blanks: sed-strip '#...' comments and blank lines from named files (no-op when no files given).
function kill_comments_and_blanks() {
	[[ $# -gt 0 ]] && sed -e 's/#.*//;/^$/d' "$@"
}

# Neither POSIX [ nor the bash [[ operator accept the output of wildcard 
# expansion when testing for file existence. This is damn annoying, as we
# often want to test for the existence of foo* and don't care whether there
# are 1 or 100 files that match that wildcard.
# ============================================================================
# === LIST & STRING UTILS
# === car, cdr, abl, has, pads, pad, rpad, set_xterm_title, format_error,
# === log_message, memoise, backtrace.
# ============================================================================

# car: echo the first positional arg.
function car() { echo "$1"; }
# cdr: echo all positional args from $2 on.
function cdr() { echo "${@:2}"; }
# abl: echo all positional args except the last (mnemonic: 'all but last').
function abl() { echo "${@:1:$(($#-1))}"; }

# has: return 0 if $1 appears literally among $2..$N; else 1.
function has() {
	local a="$1" x; shift;
	for x in "${@}"; do
		[[ "${x}" == "${a}" ]] && return 0
	done
	return 1
}

# pads: echo just enough spaces to pad string $2 out to width $1 (no string).
function pads() {
	local n=$1; shift; local s="$*"; ((n=n<${#s}?0:n-${#s}))
	echo -n "${spaces:0:$n}"
}

# pad: echo $2 followed by spaces padding it out to width $1 (left-justify).
function pad() {
	echo -n "$2"; pads $1 "$2"
}

# rpad: echo spaces padding $2 to width $1 then $2 with newline (right-justify).
function rpad() {
	pads $1 "$2"; echo "$2"
}

# set_xterm_title: emit OSC title sequence on stderr to update xterm/screen titlebar (or html titlebar div).
function set_xterm_title() {
	if [[ "$opt_arg_colour" == "html" ]]; then
		printf '\033]2;%s\007' "$*" >&2
	else
		[[ "$TERM" = @(@(x|E|a|k)term|rxvt|gnome|screen)* ]] \
			&& echo -n $'\x1b']"2;$*"$'\x07' >&2
		[[ "$TERM" = screen* ]] \
			&& echo -n $'\x1b']"k$*"$'\x1b'"\\" >&2
		true
	fi
}

# format_error: stdin wrapped to COLUMNS-4, each line prefixed with red '!!!'; for error output.
function format_error() {
	fmt_w $((COLUMNS-4)) \
	| while read line; do echo ${RD}!!!${NO} "$line"; done
}

# log_message: if opt_arg_verbose >= $1, send ${*:2} through format_error to stderr.
function log_message() {
	(( opt_arg_verbose >= $1 )) && format_error <<<"${*:2}" >&2
}

# memoise: wrap function $1: cache stdout per-arglist in $temp_dir/$1, on hit cat the file; replaces $1 in place.
function memoise() {
	mkdir $temp_dir/$1
	eval "__memoised__$1() { $(typeset -f $1 | sed '1,2d;$d'); }
	$1() {
		[[ -d $temp_dir ]] || return 1
		mkdir -p \"$temp_dir/$1\" || return 1
		local x=\"$temp_dir/$1/_\${*//\//:}\"
		(( \${#x} > 255 )) && x=\"$temp_dir/$1/\$(sha1sum <<<\"\$*\")\"
		RETVAL=0
		trap return SIGPIPE
		if [[ -e \"\$x\" ]]; then
			cat \"\$x\" 2>&-
		else
			__memoised__$1 \"\$@\" | tee \"\$x\"
			# Both the inner function and tee must succeed; otherwise the
			# cache file may be partial (or empty) and would shortcut every
			# subsequent call to the wrong answer. Capture both statuses
			# in one go because any simple command (incl. assignment) resets
			# PIPESTATUS.
			local pstatus=( \"\${PIPESTATUS[@]}\" )
			RETVAL=\${pstatus[0]}
			((RETVAL == 0 && pstatus[1] == 0)) || rm \"\$x\"
		fi
		trap - SIGPIPE
		return \$RETVAL
	}"
}

# memoise_predicate: cache only the status of a stdout-free predicate.
function memoise_predicate() {
	mkdir -p "$temp_dir/$1"
	eval "__memoised_predicate__$1() { $(typeset -f "$1" | sed '1,2d;$d'); }
	$1() {
		[[ -d \"\$temp_dir\" ]] || return 1
		mkdir -p \"\$temp_dir/$1\" || return 1
		local x=\"\$temp_dir/$1/_\${*//\//:}\" rc
		if [[ -r \"\$x\" ]]; then
			read -r rc <\"\$x\"
		else
			__memoised_predicate__$1 \"\$@\"; rc=\$?
			printf '%s\\n' \"\$rc\" >\"\$x\"
		fi
		return \"\$rc\"
	}"
}

shopt -s extdebug
# backtrace: dump FUNCNAME stack with sources/linenos/args (with quoted argv) to stderr; needs extdebug.
function backtrace() {
	for (( j=${BASH_ARGC[0]}, i=1; i < ${#FUNCNAME[@]}; j+=${BASH_ARGC[$i]}, ++i )); do
		args=""; for (( k=${BASH_ARGC[$i]}-1; k >= 0; --k )); do
			args="$args \"${BASH_ARGV[$j + $k]}\""
		done
		echo "${Rd}$i)${NO} ${BASH_SOURCE[$i]##*/}:${BASH_LINENO[$i-1]}	${FUNCNAME[$i]}$args" >&2
	done
}

# Version specifier: 
# 	(cvs.)?([[:digit:]]+.)*[[:digit:]]+[[:lower:]]?(_(alpha|beta|pre|rc|p)[[:digit:]]*)?(-r[[:digit:]]+)?
# as: 	(cvs.)(...,mega,macro),major,(minor,micro,nano,...),(letter),(status(number)),(ebuild revision) 
# e.g. 3.57.2.20030722c_beta37-r12
VER_SHPAT='?(cvs.)*(+([[:digit:]]).)+([[:digit:]])?([[:lower:]])*(_@(alpha|beta|pre|rc|p)*([[:digit:]]))?(-r+([[:digit:]]))'
VER_REGEXP='\(cvs\.\)\?\([[:digit:]]\+\.\)*[[:digit:]]\+[[:lower:]]\?\(_\(alpha\|beta\|pre\|rc\|p\)[[:digit:]]*\)*\(-r[[:digit:]]\+\)\?'

# ============================================================================
# === CPV / ATOM FORMATTING
# === format_cpv, format_atom_for_emerge, format_taint, format_depatom,
# === format_revdep.
# ============================================================================

# format_cpv: echo coloured cat/pn[-version] for a cpv (default cat=CY, pn=GR, version=CY).
function format_cpv() {
	cpv="$1"; cat="${cpv%/*}"; pv="${cpv#$cat/}"; pn="${pv/%-$VER_SHPAT}"
	cat_col=${2:-CY}; pn_col=${3:-GR}; mlsr_col=${4:-CY}
	if [[ "$pv" == "$pn" ]]; then
		echo ${!cat_col}"$cat"${NO}/${!pn_col}"$pn"${NO}
	else
		echo ${!cat_col}"$cat"${NO}/${!pn_col}"$pn"${NO}-${!mlsr_col}"${pv#$pn-}"${NO}
	fi
}

# Build an emerge-feedable atom for $cpv. Default is '=cat/pkg-version'.
# With --full-atoms on, append ':slot' and '::repo' when known so the atom
# disambiguates packages with multiple installed slots and pinpoints the
# source repository. Sub-slots are stripped (they're rebuild-tracking, not
# selection).
function format_atom_for_emerge() {
	local cpv="$1"
	[[ "$cpv" ]] || return
	local atom="=$cpv"
	if [[ "$opt_arg_full_atoms" ]]; then
		local slot
		slot="$(slot_for "$cpv" 2>/dev/null)"
		[[ "$slot" ]] && atom="${atom}:${slot%/*}"
		local repo
		repo=$(repo_for_cpv "$cpv" 2>/dev/null)
		[[ "$repo" ]] && atom="${atom}::${repo}"
	fi
	echo "$atom"
}

# format_taint: print coloured USE-condition tokens for cpv $1; colour reflects active/!/inverted USE state.
function format_taint() {
	local cpv="$1" tok
	local -a taint_tokens=() active_use=()
	read -r -a taint_tokens <<<"${*:2}"
	read -r -a active_use <<<"$(dbuse "$cpv")"
	for tok in "${taint_tokens[@]}"; do
		if [[ $tok != *\? ]]; then
			printf '%s ' "${Gr}$tok${NO}"
			continue
		fi
		tok=${tok%\?}
		if [[ $tok == \!* ]]; then
			if has "${tok:1}" "${active_use[@]}"; then
				printf '%s? ' "${Bl}$tok${NO}"
			else
				printf '%s? ' "${BL}$tok${NO}"
			fi
		else
			if has "$tok" "${active_use[@]}"; then
				printf '%s? ' "${RD}$tok${NO}"
			else
				printf '%s? ' "${Rd}$tok${NO}"
			fi
		fi
	done
}

# format_depatom: print a coloured depatom; colour varies for virtuals and blockers.
function format_depatom() {
	local batom=$1 asvirtual=$2 col cpv suffix star=''
	local ATOM_RAW ATOM_BLOCKER ATOM_OP ATOM_CP ATOM_VERSION
	local ATOM_SLOT ATOM_REPO ATOM_USE
	atom_parse "$batom" || { printf '%s\n' "$batom"; return; }
	if [[ "$ATOM_VERSION" == *\* ]]; then
		star='*'
		ATOM_VERSION=${ATOM_VERSION%\*}
	fi
	cpv=$ATOM_CP${ATOM_VERSION:+-$ATOM_VERSION}
	suffix=$star
	[[ "$ATOM_SLOT" ]] && suffix="${suffix}:$ATOM_SLOT"
	[[ "$ATOM_REPO" ]] && suffix="${suffix}::$ATOM_REPO"
	[[ "$ATOM_USE" ]] && suffix="${suffix}[$ATOM_USE]"
	if [[ "$asvirtual" ]]; then col=FC
	elif [[ "$ATOM_BLOCKER" ]]; then col=RD
	else col=Gr
	fi
	printf '%s%s%s%s%s%s\n' \
		"$ATOM_BLOCKER" "$ATOM_OP" "${!col}" "$cpv" "$NO" "$suffix"
}

# format_revdep: read 'deppkg depatom taint' lines on stdin; print one formatted revdep per line, return count via $?.
function format_revdep() {
	asvirtual="$1"
	indent="${2:-	}"
	ndeps=0
	while read deppkg depatom taint; do
		((++ndeps))
		if [[ "$opt_arg_for_emerge" ]]; then
			# Flat atom list for piping into emerge; skip non-atom
			# sentinels (WORLD/SYSTEM/KERNEL).
			[[ "$deppkg" == @(WORLD|SYSTEM|KERNEL) ]] || format_atom_for_emerge "$deppkg"
			continue
		fi
		case $deppkg in
			WORLD )
			echo "$indent${BL}$(pad 35 "WORLD FILE")${NO}  $(format_depatom "$depatom" "$asvirtual")";;
			SYSTEM )
			echo "$indent${YL}$(pad 35 "SYSTEM PROFILE")${NO}  $(format_depatom "$depatom" "$asvirtual")";;
			KERNEL )
			echo "$indent${RD}RUNNING KERNEL${NO}";;
			* )
			echo "$indent$(format_cpv "$deppkg")$(pads 35 "$deppkg")  $(format_taint "$deppkg" "$taint")$(format_depatom "$depatom" "$asvirtual")";;
		esac
	done
	return $ndeps
}

# Structure of /var/cache/edb/dep:
# 
# In portage 2.0.51, cache files are /var/cache/edb/dep/${TREE}/${P}
# e.g. /var/cache/edb/dep/usr/portage/x11-base/xorg-x11-6.7.0
#
# The files themselves have a simple line-based structure:
# 	1. DEPEND
#	2. RDEPEND
#	3. SLOT
#	4. SRC_URI
#	5. RESTRICT
#	6. HOMEPAGE
#	7. LICENSE
#	8. DESCRIPTION
#	9. KEYWORDS
#	10. INHERITED
#	11. IUSE
#	12. CDEPEND (blank in portage 2.1)
#	13. PDEPEND
#	14. PROVIDE
#	15. EAPI (since portage 2.1)
#	16-22. <unused>
#
# See /usr/lib/portage/bin/ebuild.sh @@ 1516: for myarg in $*; do... depend)...
# and /usr/lib/portage/pym/portage.py @@ 4844: auxdbkeys=[...]
#
# In portage 2.1, the structure changes to a key=value format, where value is 
# unquoted and keys are _eclasses_, LICENSE, RESTRICT, etc.: the same as for
# 2.0.51, with the addition of EAPI and the replacement of INHERITED by 
# _eclasses_.
#
# Extract these with extract_var(name, cpv, tree).
deplines=('' DEPEND RDEPEND SLOT SRC_URI RESTRICT HOMEPAGE LICENSE DESCRIPTION KEYWORDS INHERITED IUSE CDEPEND PDEPEND PROVIDE BDEPEND IDEPEND)
for ((i=0;i<${#deplines[@]};++i)); do declare depline_${deplines[$i]}=$i; done

# New inheriting profiles work thus: /etc/portage/make.profile is a symlink to a 
# directory somewhere in $PORTDIR; this has a file "parent" which contains the
# relative path to the parent profile. Follow until you run out of parents.
# profile_files() returns a profile stack for the named file, highest precedence
# first (the correct way for stacking_sort). Each file returned exists.

# handles multiple inheritance - probably pointless
# Modern parent files may also reference another repository's profile via
# `<repo-name>:<profile-path>` (path relative to that repo's profiles/ dir).
# ============================================================================
# === PROFILE & PORTAGE CONFIG
# === profile_stack_read, profile_files, etc_portage_files, profile_files_extra,
# === read_repos_config, load_portage_config.
# ============================================================================

# profile_stack_read: recursively walk profile parent links from $1+$@, emit each profile dir; supports repo:path refs.
function profile_stack_read() {
	dir="$1"; shift
	for rel in "$@"; do
		case "$rel" in
		*:*)	repo="${rel%%:*}"; subpath="${rel#*:}"
			[[ "${repo_loc[$repo]:-}" ]] || continue
			pdir="$(readlink -f "${repo_loc[$repo]}/profiles/$subpath")"
			;;
		*)	pdir="$(readlink -f "$dir/$rel")";;
		esac
		echo "$pdir"
		[[ -r "$pdir/parent" ]] && profile_stack_read "$pdir" \
				$(kill_comments_and_blanks "$pdir/parent")
	done
}

# profile_files: for each profile in $profile_stack, emit readable $profile/$1 (files inside if directory).
function profile_files() {
	while read path; do
		if [[ -d "$path/$1" ]]; then
			# Modern profiles split many of these (use.mask, package.use,
			# package.use.mask, etc.) into directories of files.
			find "$path/$1" -type f -readable
		elif [[ -r "$path/$1" ]]; then
			echo "$path/$1"
		fi
	done <<<"$profile_stack"
}

# etc_portage_files: emit readable file(s) at $ETC_PORTAGE_DIR/$1 (Prefix-aware), expanding directory into a find -type f.
function etc_portage_files() {
	name="$1"
	if [[ -d "$ETC_PORTAGE_DIR/$name" ]]; then
		find "$ETC_PORTAGE_DIR/$name" -type f -readable
	elif [[ -r "$ETC_PORTAGE_DIR/$name" ]]; then
		echo "$ETC_PORTAGE_DIR/$name"
	fi
}

# profile_files with trees as well
function profile_files_extra() {
	name="$1"
	etc_portage_files "$name"
	profile_files "$name"
	for x in $portage_trees; do
		if [[ -d "${x%/}/profiles/$name" ]]; then
			find "${x%/}/profiles/$name" -type f -readable
		elif [[ -r "${x%/}/profiles/$name" ]]; then
			echo "${x%/}/profiles/$name"
		fi
	done
}

# Read repository configuration via portageq. Populates:
#   PORTDIR        — location of [DEFAULT] main-repo
#   portage_trees  — space-separated list of all repo locations, ordered
#                    highest-priority-first (ties broken by name ascending)
#   repo_masters   — space-separated master repository names for each repo
# Hard-fails if portageq is missing or main-repo can't be resolved.
function read_repos_config() {
	local section="" line k v n
	local main_repo=""
	declare -gA repo_loc=() repo_prio=() repo_masters=()
	if ! command -v portageq >/dev/null 2>&1; then
		format_error >&2 <<-END
		dep needs sys-apps/portage installed: portageq is missing from
		\$PATH, so /etc/portage/repos.conf can't be read.
		END
		exit 1
	fi
	while IFS= read -r line; do
		case "$line" in
		\[*\])	section="${line#\[}"; section="${section%\]}";;
		'')	;;
		*=*)	k="${line%%=*}"; v="${line#*=}"
			k="${k% }"; v="${v# }"
			case "$section/$k" in
				DEFAULT/main-repo)	main_repo="$v";;
				*/location)		repo_loc[$section]="$v";;
				*/masters)		repo_masters[$section]="$v";;
				*/priority)		repo_prio[$section]="$v";;
			esac;;
		esac
	done < <(portageq repos_config "${EROOT:-/}/" 2>/dev/null)
	if [[ -z "$main_repo" || -z "${repo_loc[$main_repo]:-}" ]]; then
		echo "load_portage_config: portageq repos_config / failed or missing main-repo" \
			| format_error >&2
		exit 1
	fi
	PORTDIR="${repo_loc[$main_repo]}"
	portage_trees=""
	while read -r _ n; do
		portage_trees="${portage_trees}${portage_trees:+ }${repo_loc[$n]}"
	done < <(
		for n in "${!repo_loc[@]}"; do
			printf '%d %s\n' "${repo_prio[$n]:-0}" "$n"
		done | sort -k1,1nr -k2,2
	)
}

# load_portage_config: delegate to portageq envvar for make.conf vars; populate USE_EXPAND, profile categories/provided/masks.
function load_portage_config() {
	# Portage's own resolution of make.conf / make.globals / profile
	# make.defaults stack (with source directives, additive USE, etc.) is
	# delegated to portageq. portageq envvar -v emits shell-quoted KEY=VALUE
	# pairs that are safe to eval — replaces the previous custom sed+eval
	# scrape, which mishandled make.conf entries containing $-substitutions
	# and was a remote-execution risk if dep ever read an attacker-supplied
	# make.conf-shaped file.
	read_repos_config
	# Walk the profile stack after repo_loc is populated so cross-repo
	# `<repo>:<path>` parent entries can be resolved.
	[[ -h "$ETC_PORTAGE_DIR/make.profile" ]] && profile_stack="$(profile_stack_read "$ETC_PORTAGE_DIR/profile" .
		profile_stack_read "$ETC_PORTAGE_DIR/make.profile" .)"
	# Round 1: the static set of vars we always want plus USE_EXPAND, which
	# we need read first so we can ask for its expansions in round 2.
	eval "$(portageq envvar -v \
		DISTDIR PKGDIR PORTAGE_TMPDIR CCACHE_DIR \
		CHOST ARCH ACCEPT_KEYWORDS \
		FEATURES USE_EXPAND USE_ORDER USE 2>/dev/null)"
	__conf_USE="$USE"
	# Round 2: each USE_EXPAND'd var (LINGUAS, PYTHON_TARGETS, …).
	if [[ "$USE_EXPAND" ]]; then
		eval "$(portageq envvar -v $USE_EXPAND 2>/dev/null)"
	fi
	read -a ACCEPT_KEYWORDS <<<"$ARCH $ACCEPT_KEYWORDS"
	categories=$(sort -u $(profile_files_extra categories))

	allprofilepackages=$(
		kill_comments_and_blanks $(profile_files packages) \
		| stacking_sort yes
	)

	profileprovided=$(
		kill_comments_and_blanks $(profile_files package.provided) \
		| stacking_sort yes
	)

}

# Cache reads now flow through metadata/md5-cache (per-repo) and the vardb;
# the legacy ebuild_dep_to_stdout / ebuild_dep_to_edb / ebuild_dep_from_vardb
# functions and the populate_from_tree helper were removed in phase 2.
# /usr/lib/portage/bin/ebuild.sh has moved into the python sub-tree and we no
# longer regenerate cache files on demand — Portage already maintains them.

# ============================================================================
# === VERSION COMPARISON + DEP MATCH
# === vercmp, dep_satisfies_mlsr, dep_satisfies, slot_satisfies,
# === dep_satisfies_slot, accept_for.
# ============================================================================

# vercmp: test version1 ($1) op ($2) version2 ($3); op in =,~,<=,<,>=,>; via comm_ver convention.
function vercmp() {
	comm_ver "$1" "$3"
	case "$2" in
		"=" ) (( $? == 0 ));;
		"~" ) (( $? == 255 || $? == 0 || $? == 1 ));;
		"<=" ) (( $? == 0 || $? >= 128 ));;
		"<" ) (( $? >= 128 ));;
		">=" ) (( $? < 128 ));;
		">" ) (( $? > 0 && $? < 128 ));;
		* ) format_error <<<"Unrecognised version comparator: $2" >&2
	esac
}

# dep_satisfies_mlsr: test whether candidate mlsr $1 (any source: installed/available/injected) satisfies operator $2 + dep-mlsr $3 (handles star-glob and '').
function dep_satisfies_mlsr() {
	local t_mlsr="$1"; local vs="$2"; local d_mlsr="$3"
	[[ "$vs" == @(<|>)* ]] && d_mlsr="${d_mlsr%\*}"  # >=foo-2* idiocy
	if [[ "$d_mlsr" == *\* ]]; then
		# Intentional glob match: $d_mlsr ends with '*' here (the if
		# above gates that), so the unquoted RHS is the pattern.
		# shellcheck disable=SC2053
		[[ "$t_mlsr" == $d_mlsr ]] && return 0 || return 1
	fi
	[[ "$vs" == "" ]] && return 0
	vercmp "${t_mlsr}" "${vs}" "${d_mlsr}"
}

# atom_parse: split an EAPI 8 atom into blocker/operator/CP/version/slot/repo/
# USE-dependency fields.  Results use the ATOM_* prefix so callers can copy
# the fields they need before invoking helpers which may parse another atom.
function atom_parse() {
	local atom=$1 body
	# ATOM_RAW and ATOM_BLOCKER are part of the parser interface used by
	# diagnostics/tests even though the matcher does not need them directly.
	# shellcheck disable=SC2034
	ATOM_RAW=$atom ATOM_BLOCKER='' ATOM_OP='' ATOM_CP='' ATOM_VERSION=''
	ATOM_SLOT='' ATOM_REPO='' ATOM_USE=''
	# shellcheck disable=SC2034
	case "$atom" in !!*) ATOM_BLOCKER=!!; atom=${atom#!!};; !*) ATOM_BLOCKER=!; atom=${atom#!};; esac
	if [[ "$atom" == *\[*\] ]]; then
		ATOM_USE=${atom##*\[}; ATOM_USE=${ATOM_USE%\]}
		atom=${atom%%\[*}
	fi
	if [[ "$atom" == *::* ]]; then
		ATOM_REPO=${atom##*::}; atom=${atom%%::*}
	fi
	if [[ "$atom" == *:* ]]; then
		ATOM_SLOT=${atom##*:}; atom=${atom%%:*}
	fi
	case "$atom" in
		'>='*|'<='*) ATOM_OP=${atom:0:2}; body=${atom:2};;
		'='*|'~'*|'>'*|'<'*) ATOM_OP=${atom:0:1}; body=${atom:1};;
		*) body=$atom;;
	esac
	ATOM_CP=${body/%-$VER_SHPAT?(\*)}
	if [[ "$ATOM_CP" != "$body" ]]; then
		ATOM_VERSION=${body#"$ATOM_CP"-}
		# A concrete CPV supplied on the CLI has exact-version meaning even
		# without a leading '='. Dependency metadata itself always uses an
		# operator for versioned atoms.
		[[ "$ATOM_OP" ]] || ATOM_OP='='
	fi
	[[ "$ATOM_CP" ]]
}

function repo_name_for_tree() {
	local tree=${1%/} repo
	for repo in "${!repo_loc[@]}"; do
		[[ "${repo_loc[$repo]%/}" == "$tree" ]] && { echo "$repo"; return 0; }
	done
	return 1
}

function repo_for_cpv() {
	local cpv=$1 tree=${2-}
	if [[ -r "$VARDB_DIR/$cpv/repository" ]]; then
		cat "$VARDB_DIR/$cpv/repository"
	else
		[[ "$tree" ]] || tree=$(best_tree "$cpv" 2>/dev/null)
		repo_name_for_tree "$tree"
	fi
}

# atom_use_satisfies: enforce EAPI 8 USE dependencies against candidate $1.
# The optional parent package supplies the state used by ?, !?, =, and !=.
function atom_use_satisfies() {
	local candidate=$1 spec=$2 parent=$3 candidate_use parent_use iuse tok
	local flag default candidate_on parent_on require_on conditional invert
	[[ "$spec" ]] || return 0
	if [[ -d "$VARDB_DIR/$candidate" ]]; then
		candidate_use=$(extract_var_from_vardb USE "$candidate")
		iuse=$(extract_var_from_vardb IUSE "$candidate" | strip_iuse_prefixes)
	else
		candidate_use=$(dbuse "$candidate")
		iuse=$(extract_var IUSE "$candidate" 2>/dev/null | strip_iuse_prefixes)
	fi
	parent_use=${parent:+$(dbuse "$parent")}
	while IFS= read -r tok; do
		[[ "$tok" ]] || continue
		conditional='' invert='' require_on=''
		case "$tok" in
			'!'*'?') invert=yes; conditional='?'; tok=${tok#!}; tok=${tok%\?};;
			'!'*'=') invert=yes; conditional='='; tok=${tok#!}; tok=${tok%=};;
			*'?') conditional='?'; tok=${tok%\?};;
			*'=') conditional='='; tok=${tok%=};;
		esac
		default=unknown
		case "$tok" in
			*\(\+\)) default=on; tok=${tok%\(\+\)};;
			*\(-\)) default=off; tok=${tok%\(-\)};;
		esac
		case "$tok" in
			-*) require_on=no; flag=${tok#-};;
			*) require_on=yes; flag=$tok;;
		esac
		if has "$flag" $iuse; then
			has "$flag" $candidate_use && candidate_on=yes || candidate_on=no
		else
			case "$default" in on) candidate_on=yes;; off) candidate_on=no;; *) return 1;; esac
		fi
		if [[ "$conditional" ]]; then
			has "$flag" $parent_use && parent_on=yes || parent_on=no
			if [[ "$conditional" == '?' ]]; then
				if [[ "$invert" ]]; then
					[[ "$parent_on" == no ]] || continue
					require_on=no
				else
					[[ "$parent_on" == yes ]] || continue
					require_on=yes
				fi
			else
				require_on=$parent_on
				[[ "$invert" ]] && { [[ "$require_on" == yes ]] && require_on=no || require_on=yes; }
			fi
		fi
		[[ "$candidate_on" == "$require_on" ]] || return 1
	done < <(tr ',' '\n' <<<"$spec")
}

# dep_satisfies: compatibility name for the shared atom matcher.
#
# Older out-of-tree callers may still source dep and invoke this name.  Keep
# the interface, but do not retain a second, lenient interpretation of atoms.
function dep_satisfies() {
	dep_satisfies_atom "$@"
}

# dep_satisfies_atom: the shared EAPI 8 matcher. Optional arguments supply
# candidate SLOT, repository, parent CPV, and the candidate repository tree.
function dep_satisfies_atom() {
	local testpkg=$1 depatom=$2 pkg_slot=${3-} pkg_repo=${4-} parent=${5-} tree=${6-}
	atom_parse "$depatom" || return 2
	local cp=$ATOM_CP version=$ATOM_VERSION op=$ATOM_OP slot=$ATOM_SLOT
	local repo=$ATOM_REPO use=$ATOM_USE
	local test_cp=${testpkg/%-$VER_SHPAT} test_version=${testpkg#${testpkg/%-$VER_SHPAT}-}
	[[ "$test_cp" == "$cp" ]] || return 2
	[[ -z "$version" ]] || dep_satisfies_mlsr "$test_version" "$op" "$version" || return 1
	if [[ "$slot" ]]; then
		[[ "$pkg_slot" ]] || pkg_slot=$(slot_for "$testpkg" "$tree" 2>/dev/null)
		slot_satisfies "$pkg_slot" "$slot" || return 1
	fi
	if [[ "$repo" ]]; then
		[[ "$pkg_repo" ]] || pkg_repo=$(repo_for_cpv "$testpkg" "$tree" 2>/dev/null)
		[[ "$pkg_repo" == "$repo" ]] || return 1
	fi
	atom_use_satisfies "$testpkg" "$use" "$parent" || return 1
}

# slot_satisfies pkg_slot dep_spec
#
# Test whether a package with SLOT pkg_slot satisfies a slot-dependency
# spec dep_spec (the substring of a depatom from the first ':' up to a
# trailing USE-dep '[' or end-of-atom; the leading ':' is already
# stripped). Returns 0 on match, 1 otherwise.
#
# Per PMS 8.2.6.3:
#   ''            → no slot constraint, matches any slot
#   '='           → bind-operator only, matches any slot
#   '*'           → any-slot operator
#   'NAME'        → exact match on main slot (sub-slot ignored on both sides)
#   'NAME='       → match on main slot; the trailing '=' is the bind-on-rebuild
#                   marker and is irrelevant for satisfaction
#   'NAME/SUB'    → exact match on slot AND sub-slot
#   'NAME/SUB='   → exact match on slot AND sub-slot (bind marker ignored)
#
# pkg_slot may be 'NAME' or 'NAME/SUB'. A bare-NAME constraint accepts a
# pkg_slot with any sub-slot. A NAME/SUB constraint requires the pkg to
# advertise its sub-slot — a pkg_slot of just 'NAME' does NOT match
# 'NAME/SUB' (we cannot prove sub-slot identity without the data).
#
# If pkg_slot is empty (slot unknown), only matches when dep_spec is the
# any-slot form. This is the conservative call for revdep filtering: we
# don't claim a match we can't prove.
function slot_satisfies() {
	local pkg_slot=$1 dep_spec=$2
	[[ -z "$dep_spec" || "$dep_spec" == "=" || "$dep_spec" == "*" ]] && return 0
	dep_spec=${dep_spec%=}
	[[ -z "$pkg_slot" ]] && return 1
	if [[ "$dep_spec" == */* ]]; then
		[[ "$pkg_slot" == "$dep_spec" ]]
	else
		[[ "${pkg_slot%%/*}" == "$dep_spec" ]]
	fi
}

# dep_satisfies_slot testpkg depatom [pkg_slot]
#
# Compatibility/test seam retained for callers of the former slot-only
# matcher.  All semantics now come from dep_satisfies_atom.
function dep_satisfies_slot() {
	dep_satisfies_atom "$1" "$2" "${3-}"
}

# accept_for: compute effective ACCEPT_KEYWORDS for cp/mlsr from package.{accept_keywords,keywords}; result in nameref $3.
function accept_for() {
	local cp="$1" mlsr="$2" return="${3:-RESULT}" tree=${4-}
	# package.accept_keywords is the modern canonical name; package.keywords
	# is the legacy alias and may or may not exist. Either or both can be a
	# file or a directory of files.
	local kfiles=()
	while read -r f; do kfiles+=("$f"); done < <(
		etc_portage_files package.accept_keywords
		etc_portage_files package.keywords
	)
	if (( ${#kfiles[@]} == 0 )); then
		read -a "$return" <<<"${ACCEPT_KEYWORDS[@]}"
		return 0
	fi
	accept_ks=("${ACCEPT_KEYWORDS[@]}")
	extra_ks=()
	while read -a atom_keywords; do
		(( ${#atom_keywords[@]} )) || continue
		if dep_satisfies_atom "${cp}-${mlsr}" "${atom_keywords[0]}" '' '' '' "$tree"; then
			[[ -z "${atom_keywords[*]:1}" ]] \
				&& extra_ks=("${extra_ks[@]}" "~${ARCH}") \
				|| extra_ks=("${extra_ks[@]}" "${atom_keywords[@]:1}")
		fi
	done <<<"$(
		grep -h '^[<>=~]*'$cp "${kfiles[@]}" 2>/dev/null
		)"
	for keyword in "${extra_ks[@]}"; do
		case "$keyword" in
			-\*) accept_ks[${#accept_ks[@]}]="${keyword}";;
			-*) for i in "${!accept_ks[@]}"; do [[ "-${accept_ks[$i]}" == "${keyword}" ]] && unset 'accept_ks[$i]'; done;;
			*) accept_ks[${#accept_ks[@]}]="${keyword}";;
		esac
	done
	read -a "$return" <<<"${accept_ks[@]}"
}

# ============================================================================
# === TREE LOOKUP
# === best_tree, edb_tree.
# ============================================================================

# best_tree: echo the highest-priority repo holding $1's ebuild that isn't keyword-masked (falls back to any, then PORTDIR).
function best_tree() {
	cpv="$1"
	cp="${cpv/%-$VER_SHPAT}"; mlsr="${cpv#$cp-}"; pv="${cpv#*/}"
	for tree in ${portage_trees}; do
		[[ -f ${tree}/${cp}/${pv}.ebuild ]] || continue
		is_keyword_masked $cp $mlsr $tree && continue
		echo ${tree%/}
		return 0
	done
	for tree in ${portage_trees}; do
		[[ -f ${tree}/${cp}/${pv}.ebuild ]] || continue
		echo ${tree%/}
		return 0
	done
	echo $PORTDIR
	return 1
}
# db_grep with --with-tree calls best_tree once per matching cpv; on a
# needle hitting hundreds of revdeps that's hundreds of full
# portage_trees stat-walks. Memoise.
memoise best_tree

# edb_tree: like best_tree but uses metadata/md5-cache presence instead of .ebuild; unused mlsr-version source pick.
function edb_tree() {
	cpv="$1"
	cp="${cpv/%-$VER_SHPAT}"; mlsr="${cpv#$cp-}"; pv="${cpv#*/}"
	for tree in ${portage_trees}; do
		[[ -f ${tree}/metadata/md5-cache/${cpv} ]] || continue
		is_keyword_masked $cp $mlsr $tree && continue
		echo ${tree%/}
		return 0
	done
	for tree in ${portage_trees}; do
		[[ -f ${tree}/metadata/md5-cache/${cpv} ]] || continue
		echo ${tree%/}
		return 0
	done
	echo $PORTDIR
	return 1
}

# Strip the EAPI 1+ default-state prefixes (+ for forced-on, - for forced-off)
# from a whitespace-separated IUSE list read on stdin. Hyphens inside flag names
# (e.g. native-extensions) are preserved — only prefixes after a word boundary
# are stripped.
# ============================================================================
# === VARDB / EDB METADATA + USE
# === strip_iuse_prefixes, extract_var_from_vardb, extract_var_from_edb,
# === extract_var, keywords_for, slot_for, pkginternal_use_for, dep_to_cps,
# === allvirtuals, autouse, USE-source helpers, usecomponent, dbuse.
# ============================================================================

# strip_iuse_prefixes: sed away EAPI-1+ +/- default-state prefixes on whitespace-separated IUSE list on stdin.
function strip_iuse_prefixes() {
	sed 's/[[:space:]]\+[+-]/ /g; s/^[+-]//'
}

# extract_var_from_vardb: cat /var/db/pkg/$2/$1, falling back to scraping NAME= from environment.bz2 if no plain file.
function extract_var_from_vardb() {
	local name="$1" cpv="$2"
	if [[ "$name" && -e ${VARDB_DIR}/$cpv/$name ]]; then
		cat ${VARDB_DIR}/$cpv/$name
	elif [[ -e "${VARDB_DIR}/${cpv}/environment.bz2" ]]; then
		bunzip2 -c "${VARDB_DIR}/${cpv}/environment.bz2" \
			| sed 's!^'"${name}"'=!!;t;d'
	fi
}

# Read NAME from a key=value md5-cache file at the caller-supplied path
# (serves both a repo's metadata/md5-cache and Portage's generated depcache,
# which share the format). INHERITED is reconstructed from _eclasses_
# (name<TAB>md5 pairs).
function extract_var_from_edb() {
	local name=$1 cachefile=$2
	if [[ "$name" == INHERITED ]]; then
		while IFS= read -r REPLY; do
			[[ "$REPLY" == "_eclasses_="* ]] || continue
			eclasses=(${REPLY#_eclasses_=})
			for ((i=0;i<${#eclasses[@]};i+=2)); do
				echo -n "${eclasses[$i]} "
			done
			echo
			break
		done <"$cachefile"
	else
		while IFS= read -r REPLY; do
			[[ "$REPLY" == "$name="* ]] || continue
			echo "${REPLY#$name=}"
			break
		done <"$cachefile"
	fi
}

# extract_var: echo one metadata var. --original-depends reads vardb; otherwise
# repo metadata from the in-tree metadata/md5-cache OR Portage's generated
# depcache under $EDB_DIR/dep (for overlays that ship no in-tree cache), with a
# vardb fallback when neither cache has the cpv.
function extract_var() {
	local name="$1" cpv="$2" tree=${3-}
	if [[ "$opt_arg_original_depends" && -d ${VARDB_DIR}/$cpv ]]; then
		extract_var_from_vardb "$name" "$cpv"
		return
	fi
	# Resolve the owning repo if the caller didn't name one.
	[[ -z "$tree" ]] && tree="$(best_tree "$cpv")"
	# Two cache locations, identical key=value format: the repo's own
	# metadata/md5-cache, and Portage's depcache under $EDB_DIR/dep keyed by
	# the repo's absolute path. Many overlays ship only profiles/ +
	# metadata/layout.conf and let Portage generate the latter; without it
	# every metadata read for such an overlay's uninstalled packages failed.
	local cachefile=""
	if [[ "$tree" && -f "$tree/metadata/md5-cache/$cpv" ]]; then
		cachefile="$tree/metadata/md5-cache/$cpv"
	elif [[ "$tree" && -f "${EDB_DIR}/dep$tree/$cpv" ]]; then
		cachefile="${EDB_DIR}/dep$tree/$cpv"
	fi
	if [[ "$cachefile" ]]; then
		extract_var_from_edb "$name" "$cachefile"
	elif [[ -d ${VARDB_DIR}/$cpv ]]; then
		extract_var_from_vardb "$name" "$cpv"
	else
		format_error <<<"failed extract_var $* :: ${FUNCNAME[*]}" >&2
		return 1
	fi
}

# keywords_for: store KEYWORDS array for cpv $1 (in tree $2) into nameref-named var $3 (default RESULT).
function keywords_for() {
	read -a "${3:-RESULT}" <<<"$(extract_var KEYWORDS "$1" "${2-}")"
}

# slot_for: echo SLOT for cpv $1 (in optional tree $2) via extract_var.
function slot_for() {
	extract_var SLOT "$1" "${2-}"
}

# pkginternal_use_for: echo per-line IUSE defaults for cpv $1: '+flag' -> flag, '-flag' -> -flag; strip plain entries.
function pkginternal_use_for() {
	local -a IUSE; read -a IUSE <<<"$(extract_var IUSE $1)"
	for (( i=0; i<${#IUSE[@]}; ++i )); do
		local flag=${IUSE[$i]}
		if [[ "$flag" == +* ]]; then
			echo "${flag:1}"
		elif [[ "$flag" == -* ]]; then
			echo "$flag"
		fi
	done
}

# Read a DEPEND/RDEPEND token soup on stdin; emit one bare cat/pkg per line.
# Strips USE-deps, slot suffixes, version operators, version, blockers, and
# control tokens (||, parens, use? markers).
function dep_to_cps() {
	sed '
		s/\[[^]]*\]//g
		s/:[^][[:space:]()|]*//g
	' | tr -s ' \t()' '\n' \
	| grep -v '^\(||\|[^/]*?\|\)$' \
	| grep '/' \
	| sed '
		s/^!\{1,2\}//
		s/^[<>=~]\{1,2\}//
		s/-'"$VER_REGEXP"'\*\?$//
	' | sort -u
}

# Modern virtuals model: each virtual/foo is a real package whose RDEPEND
# (often as a top-level || group) names the providers. allvirtuals walks
# the virtual/ category in every repo and emits, one per line:
#     virtual/cp  provider_cp1 provider_cp2 ...
# Replaces the old PROVIDE-scraping pipeline (PROVIDE was removed in EAPI 5,
# /var/cache/edb/virtuals doesn't get written by modern Portage, profile
# 'virtuals' files are deprecated).
function allvirtuals() {
	set_xterm_title "Calculating virtuals... walking virtual/ category"
	trap return SIGPIPE
	(
		local tree cp_dir cp ebuild cpv mlsr
		for tree in $portage_trees; do
			[[ -d "$tree/virtual" ]] || continue
			for cp_dir in "$tree"/virtual/*; do
				[[ -d "$cp_dir" ]] || continue
				cp="virtual/${cp_dir##*/}"
				# Providers may vary across versions. Include every visible
				# ebuild, while excluding versions hidden by package masks or
				# keyword policy in their originating repository.
				for ebuild in "$cp_dir"/*.ebuild; do
					[[ -f "$ebuild" ]] || continue
					cpv="virtual/${ebuild##*/}"; cpv="${cpv%.ebuild}"
					mlsr=${cpv#${cp}-}
					is_package_masked "$cp" "$mlsr" "$tree" && continue
					is_keyword_masked "$cp" "$mlsr" "$tree" && continue
					( extract_var RDEPEND "$cpv" "$tree"
					  extract_var DEPEND  "$cpv" "$tree"
					) | dep_to_cps | while read provider; do
						[[ "$provider" ]] && echo "$cp $provider"
					done
				done
			done
		done
	) | sort -u | (
		virtual=""; cps=""
		while read newv cp; do
			if [[ "$newv" == "$virtual" ]]; then
				has "$cp" $cps || cps="$cps $cp"
			else
				[[ "$virtual" ]] && echo "$virtual $cps"
				virtual="$newv"; cps="$cp"
			fi
		done
		[[ "$virtual" ]] && echo "$virtual $cps"
	)
	trap - SIGPIPE
	set_xterm_title "Calculating virtuals... done"
}
memoise allvirtuals

# autouse: echo profile use.defaults flags whose listed packages are installed (highest priority last via tac).
function autouse() {
	set_xterm_title "Calculating auto USE flags..."
	kill_comments_and_blanks $(profile_files use.defaults) \
	| while read use packages; do 
		for package in $packages; do
			[[ -z "${package}" || -d ${VARDB_DIR}/${package} || -d $(car ${VARDB_DIR}/${package}-$VER_SHPAT) ]] && echo $use
		done
	done | tac
	set_xterm_title "Calculating auto USE flags... done"
}
memoise autouse

# package_use_mask: echo merged use.mask for $1: profile package.use.mask matches stacked with unstacked use.mask.
function package_use_mask() {
	(
		kill_comments_and_blanks $(profile_files use.mask)
		if package_is_stable "$1"; then
			kill_comments_and_blanks $(profile_files use.stable.mask)
			package_use_rules package.use.stable.mask "$1"
		fi
		package_use_rules package.use.mask "$1"
	) | sed 's/[[:space:]]\+/\n/g' | stacking_sort yes
}

function package_is_stable() {
	local -a package_keywords=()
	keywords_for "$1" "" package_keywords 2>/dev/null
	has "$ARCH" "${package_keywords[@]}"
}

# config_path_files: emit the readable file(s) at directory $1 under name $2.
function config_path_files() {
	local path=$1 name=$2
	if [[ -d "$path/$name" ]]; then
		find "$path/$name" -type f -readable | LC_ALL=C sort
	elif [[ -r "$path/$name" ]]; then
		printf '%s\n' "$path/$name"
	fi
}

# split_use_tokens: normalize whitespace-separated USE changes to one per line.
function split_use_tokens() {
	sed 's/[[:space:]]\+/\n/g' | sed '/^[[:space:]]*$/d'
}

# use_tokens_at: emit global USE changes from file/directory $1/$2.
function use_tokens_at() {
	local path=$1 name=$2 file
	local use_files=()
	while IFS= read -r file; do
		[[ "$file" ]] && use_files+=("$file")
	done < <(config_path_files "$path" "$name")
	(( ${#use_files[@]} )) || return 0
	kill_comments_and_blanks "${use_files[@]}" | split_use_tokens | tac
}

# package_use_rules_at: emit matching package.* USE flags rooted at $1.
function package_use_rules_at() {
	local path=$1 name=$2 cpv=$3 tree=${4-} package flags file
	local rule_files=()
	while IFS= read -r file; do
		[[ "$file" ]] && rule_files+=("$file")
	done < <(config_path_files "$path" "$name")
	(( ${#rule_files[@]} )) || return 0
	while read -r package flags; do
		dep_satisfies_atom "$cpv" "$package" '' '' '' "$tree" \
			&& printf '%s\n' "$flags"
	done < <(kill_comments_and_blanks "${rule_files[@]}") \
		| split_use_tokens | tac
}

# package_use_rules: emit matching active-profile and package-repository rules.
# Kept as the combined interface used by mask/force evaluation.
function package_use_rules() {
	local name=$1 cpv=$2 path tree
	while IFS= read -r path; do
		[[ "$path" ]] && package_use_rules_at "$path" "$name" "$cpv"
	done <<<"$profile_stack"
	tree=$(best_tree "$cpv" 2>/dev/null)
	[[ "$tree" ]] && package_use_rules_at "$tree/profiles" "$name" "$cpv" "$tree"
}

function package_use_force() {
	(
		if package_is_stable "$1"; then
			kill_comments_and_blanks $(profile_files use.stable.force)
			package_use_rules package.use.stable.force "$1"
		fi
		kill_comments_and_blanks $(profile_files use.force)
		package_use_rules package.use.force "$1"
	) | sed 's/[[:space:]]\+/\n/g' | stacking_sort yes
}

# make_defaults_use: conservative parser for incremental USE assignments in
# profile/repository make.defaults. Quoted values and USE+= are supported;
# arbitrary shell is deliberately not evaluated.
function make_defaults_use() {
	local file=$1
	[[ -r "$file" ]] || return 0
	sed -n '
		s/^[[:space:]]*USE[[:space:]]*+\?=[[:space:]]*//
		t use
		b
		:use
		s/^["'"'"']//; s/["'"'"'][[:space:]]*$//
		# Portage clears USE from the expansion map before reading each
		# profile node (config.py), so the conventional ${USE} placeholder
		# does not become a literal flag or re-apply a parent component.
		s/${USE}//g
		p
	' "$file" | split_use_tokens | tac
}

# _repository_chain_walk: recursive worker sharing repository_chain's dynamic seen_repos.
function _repository_chain_walk() {
	local repo=$1 master i
	local -a masters=()
	[[ "$repo" && ! ${seen_repos[$repo]:-} ]] || return 0
	seen_repos[$repo]=1
	printf '%s\n' "$repo"
	read -r -a masters <<<"${repo_masters[$repo]:-}"
	for ((i=${#masters[@]}-1; i>=0; --i)); do
		master=${masters[$i]}
		_repository_chain_walk "$master"
	done
}

# repository_chain: emit a repository and its masters, highest precedence first.
function repository_chain() {
	local -A seen_repos=()
	_repository_chain_walk "$1"
}

# profile_defaults_usecomponent: mirror config.py's "defaults" USE source.
function profile_defaults_usecomponent() {
	local cpv=$1 path
	[[ "$cpv" ]] || return 0
	while IFS= read -r path; do
		[[ "$path" ]] || continue
		# package/flag-specific settings have higher priority than the
		# profile's global defaults. The profile stack itself is already
		# ordered child before parent (highest precedence first).
		if package_is_stable "$cpv"; then
			package_use_rules_at "$path" package.use.stable "$cpv"
		fi
		package_use_rules_at "$path" package.use "$cpv"
		package_is_stable "$cpv" && use_tokens_at "$path" use.stable
		make_defaults_use "$path/make.defaults"
	done <<<"$profile_stack"
}

function repo_usecomponent() {
	local cpv=$1 tree repo path
	[[ "$cpv" ]] || return 0
	tree=$(best_tree "$cpv" 2>/dev/null)
	[[ "$tree" ]] || return 0
	repo=$(repo_name_for_tree "$tree")
	# Portage config.py builds "repo" from the package repository's masters
	# followed by that repository, so emit the reverse (high-to-low) order
	# expected by stacking_sort. A tree not named in repos.conf still gets its
	# own repository-level settings as a conservative fallback.
	if [[ "$repo" ]]; then
		while IFS= read -r repo; do
			path=${repo_loc[$repo]:-}
			[[ "$path" ]] || continue
			path=$path/profiles
			if package_is_stable "$cpv"; then
				package_use_rules_at "$path" package.use.stable "$cpv" "$tree"
			fi
			package_use_rules_at "$path" package.use "$cpv" "$tree"
			package_is_stable "$cpv" && use_tokens_at "$path" use.stable
			make_defaults_use "$path/make.defaults"
		done < <(repository_chain "$repo")
	else
		path=$tree/profiles
		package_is_stable "$cpv" && package_use_rules_at "$path" package.use.stable "$cpv" "$tree"
		package_use_rules_at "$path" package.use "$cpv" "$tree"
		package_is_stable "$cpv" && use_tokens_at "$path" use.stable
		make_defaults_use "$path/make.defaults"
	fi
}

# Repeated package.use filtering revisits the same CPVs across several rule
# classes. These inputs are immutable for one dep invocation, so cache them.
memoise_predicate package_is_stable
memoise package_use_rules
memoise package_use_mask
memoise package_use_force
memoise repo_usecomponent

# user_package_usecomponent: emit matching /etc/portage/package.use changes.
function user_package_usecomponent() {
	local cpv=$1 package flags file tree
	local rule_files=()
	[[ "$cpv" ]] || return 0
	while IFS= read -r file; do
		[[ "$file" ]] && rule_files+=("$file")
	done < <(etc_portage_files package.use)
	(( ${#rule_files[@]} )) || return 0
	tree=$(best_tree "$cpv" 2>/dev/null)
	while read -r package flags; do
		dep_satisfies_atom "$cpv" "$package" '' '' '' "$tree" \
			&& printf '%s\n' "$flags"
	done < <(kill_comments_and_blanks "${rule_files[@]}") \
		| split_use_tokens | tac
}

# usecomponent: print USE flags contributed by one USE_ORDER component.
function usecomponent() {
	# return a USE component, one flag per line, highest priority first
	# TODO FIXME not correct yet - though OK for default case
	# Added placeholders for default USE flag implementation
	# See http://bugs.gentoo.org/show_bug.cgi?id=61732
	local component="$1" cpv="$2"
	case "$component" in
		env) split_use_tokens <<<"$USE" | tac;;
		pkg) user_package_usecomponent "$cpv";;
		conf) split_use_tokens <<<"$__conf_USE" | tac;;
		# config.py maps active-profile make.defaults and package.use rules
		# to "defaults"; "repo" is reserved for repository-wide rules.
		# Keep pkgprofile as a legacy alias for profile package.use only.
		pkgprofile) [[ "$cpv" ]] && while IFS= read -r path; do
			[[ "$path" ]] && package_use_rules_at "$path" package.use "$cpv"
		done <<<"$profile_stack";;
		auto) autouse;;
		defaults) profile_defaults_usecomponent "$cpv";;
		# pkginternal and env.d had empty placeholder cases above the
		# real handlers — the placeholders shadowed the implementations
		# (bash case takes the first match), so pkginternal_use_for and
		# the profile.env sed were dead code. USE_ORDER defaults to
		# 'env:pkg:conf:defaults:pkginternal:features:repo:env.d' (below in
		# dbuse), so this affected USE resolution for every package
		# whose IUSE defaults (pkginternal) or profile.env exports
		# (env.d) contributed flags. Fixed by removing the placeholders.
		pkginternal) [[ "$cpv" ]] && pkginternal_use_for "$cpv";;
		# profile.env is generated by `emerge --regen` and may legitimately
		# not exist on minimal hosts (fresh stage3, freshly-bootstrapped
		# Prefix, etc.). Suppress sed's "can't read" stderr — its absence
		# is the no-env-USE case, not an error. (Pre-case-shadow-fix in
		# 8673115 this branch was unreachable so the missing-file error
		# never surfaced; it became visible after activation.) Each USE
		# producer must still emit one token per line for stacking_sort.
		env.d) [[ -r "$ETC_PORTAGE_DIR/profile.env" ]] || return 1
			sed 's/^export USE='"'"'\(.*\)'"'"'/\1/;t;d' "$ETC_PORTAGE_DIR/profile.env" \
				| split_use_tokens | tac;;
		features) has test $FEATURES && echo test;;
		repo) repo_usecomponent "$cpv";;
		*) format_error <<<"Unknown USE component: $component" >&2;;
	esac
}

# dbuse: echo effective USE flags for cpv $1: walks USE_ORDER components, applies package.use.mask, expands USE_EXPAND; short-circuits to verbatim VARDB_DIR/$cpv/USE when --original-depends and the vardb dir exists.
function dbuse() {
	local cpv=$1
	if [[ "$cpv" && "$opt_arg_original_depends" && -d ${VARDB_DIR}/$cpv ]]; then
		sed -e 's/[[:space:]]\+/\n/g' ${VARDB_DIR}/$cpv/USE
	else
		[[ "$USE_ORDER" ]] || USE_ORDER="env:pkg:conf:defaults:pkginternal:features:repo:env.d"
		(
			echo $ARCH
			package_use_force "$cpv"
			package_use_mask "$cpv" | sed -e 's/^/-/'
			for component in ${USE_ORDER//:/ }; do
				usecomponent $component "$@"
			done
		) \
		| sed '/^-\*$/,$d' \
		| stacking_sort yes
		for x in $USE_EXPAND; do
			xl=$(lower "$x")
			# would need grab_setting "$x", but is done above
			for y in ${!x}; do
				echo "${xl}_$y"
			done
		done
	fi
}
memoise dbuse

# Compare two numbers as fractional parts of a decimal fraction.
# Returns negative-as-mod-256 (see comm_ver below for the convention).
# shellcheck disable=SC2151
# ============================================================================
# === COMM — signed-magnitude version compare
# === comm_float, comm_ver.  See ChangeLog 0.7.1 / 0.7.2 for the cumulative
# === bug haul against this code (s1_s typo, rc-suffix ordering, 1.0-vs-1.0-r0).
# ============================================================================

# comm_float: compare two digit strings as fractional decimals; return +-7 sign, 0 equal (sign via mod-256).
function comm_float() {
	local f1="$1" f2="$2" i d1 d2
	for ((i=0;i<${#f1}||i<${#f2};++i)); do
		d1=${f1:$i:1}; [[ "$d1" ]] || d1=0
		d2=${f2:$i:1}; [[ "$d2" ]] || d2=0
		((d1<d2)) && return -- -7; ((d1>d2)) && return 7
	done
	return 0
}

# Compare version specifiers s1, s2. Returns <0, 0, >0 if s1 is resp lower,
# equal, higher than s2. Note that <0 actually means >127 (-1 -> 255, etc)
# 0: equal; 1: differ in erev; 2: differ in status number; 3: differ in status;
# 4: differ in letter; 5: differ in mmm length; 6: differ in mmm
#
# This needs to be kept equivalent to portage_versions.vercmp().
#
# NOTE: Portage considers e.g. 7.0 and 7.0.0 to be equivalent. Yes, I know,
# this sucks. HATE HATE HATE
#
# status code number: alpha->0, beta->1, pre->2, rc->3, (none)->4, p->5
#
# Negative returns (-1..-7) are intentional: bash truncates them mod 256
# (so -1 -> 255), and the caller in vercmp() reads `>=128` to mean "less
# than". Documented above; shellcheck rightly flags the construct but the
# convention is load-bearing.
# shellcheck disable=SC2151
function comm_ver() {
	local s1_mlsr="$1" s2_mlsr="$2"
	[[ "$s1_mlsr" == "$s2_mlsr" ]] && return 0
	if [[ "$s1_mlsr" == */* || "$s2_mlsr" == */* ]]; then
		echo "Oops: comm_ver called with category/package: $s1_mlsr $s2_mlsr" | format_error >&2
		backtrace
		return 0
	fi
	s1_mls="${s1_mlsr/%-r+([[:digit:]])}"; s1_r="${s1_mlsr#${s1_mls}}"
	s1_r="${s1_r/#-r*(0)}"
	s1_ml="${s1_mls%%*(_@(alpha|beta|pre|rc|p)*([[:digit:]]))}"
	s1_ss="${s1_mls#${s1_ml}}"
	s1_m="${s1_ml/%[[:lower:]]}"; s1_l="${s1_ml#${s1_m}}"; s1_m=( ${s1_m//./ } )
	s2_mls="${s2_mlsr/%-r+([[:digit:]])}"; s2_r="${s2_mlsr#${s2_mls}}"
	s2_r="${s2_r/#-r*(0)}"
	s2_ml="${s2_mls%%*(_@(alpha|beta|pre|rc|p)*([[:digit:]]))}"
	s2_ss="${s2_mls#${s2_ml}}"
	s2_m="${s2_ml/%[[:lower:]]}"; s2_l="${s2_ml#${s2_m}}"; s2_m=( ${s2_m//./ } )
	local i
	for ((i=0; i<${#s1_m[@]} || i<${#s2_m[@]}; ++i)); do
		s1mi="${s1_m[$i]}"; s2mi="${s2_m[$i]}"
		[[ "$s1mi" || "$s2mi" == '0' ]] || return -- -5
		[[ "$s2mi" || "$s1mi" == '0' ]] || return 5
		if [[ "$s1mi" == 0* || "$s2mi" == 0* ]]; then
			comm_float "$s1mi" "$s2mi"; ret=$?; ((ret)) && return $ret
		else
			((s1mi < s2mi)) && return -- -6
			((s1mi > s2mi)) && return 6
		fi
	done
	# Bug fix: was `${s1_s}` / `${s2_s}` (undefined), should be the
	# status-suffix vars `${s1_ss}` / `${s2_ss}` defined above. With
	# the undefined vars expanding empty, version pairs like
	# `1.2_alpha1` vs `1.2.0_beta2` would erroneously return equal
	# (different main-array lengths trigger this branch; the empty
	# concat then matches, returning 0). With s1_ss/s2_ss present,
	# only versions with truly equal letter+status+revision short-
	# circuit to equal here.
	((${#s1_m[@]}!=${#s2_m[@]})) && [[ "${s1_l}${s1_ss}${s1_r}" == "${s2_l}${s2_ss}${s2_r}" ]] && return 0
	[[ "$s1_l" < "$s2_l" ]] && return -- -4
	[[ "$s1_l" > "$s2_l" ]] && return 4
	s1_ss=( ${s1_ss//_/ } ); s2_ss=( ${s2_ss//_/ } )
	for ((i=0; i<${#s1_ss[@]} || i<${#s2_ss[@]}; ++i)); do
		s1si="${s1_ss[$i]-}"; s2si="${s2_ss[$i]-}"
		s1sci="${s1si/%*([[:digit:]])}"; s2sci="${s2si/%*([[:digit:]])}"
		# Status-class ordering per the function header and Portage
		# spec: alpha < beta < pre < rc < release < p.  Earlier
		# revisions used a length-based formula (6-len, then
		# remap-if-ge-4) that placed rc=6 above release — wrong.
		# Explicit case statement is unambiguous and matches both
		# the docstring and the Portage Manager Specification.
		#
		# `*)` shouldn't fire in normal use: the suffix parser at
		# line ~1418 only strips _alpha|beta|pre|rc|p (so an unknown
		# suffix doesn't end up in s1_ss/s2_ss).  But if someone
		# extends the parser without updating this case statement,
		# the catch-all surfaces the bug instead of silently sorting
		# the new suffix wrong.
		case "$s1sci" in
			alpha) s1_scn=0;;
			beta)  s1_scn=1;;
			pre)   s1_scn=2;;
			rc)    s1_scn=3;;
			"")    s1_scn=4;;
			p)     s1_scn=5;;
			*) format_error <<<"comm_ver: unknown status suffix '$s1sci' in '$1'" >&2
			   return 128;;
		esac
		case "$s2sci" in
			alpha) s2_scn=0;;
			beta)  s2_scn=1;;
			pre)   s2_scn=2;;
			rc)    s2_scn=3;;
			"")    s2_scn=4;;
			p)     s2_scn=5;;
			*) format_error <<<"comm_ver: unknown status suffix '$s2sci' in '$2'" >&2
			   return 128;;
		esac
		[[ "$s1_scn" -lt "$s2_scn" ]] && return -- -3
		[[ "$s1_scn" -gt "$s2_scn" ]] && return 3
		s1_sn="${s1si##${s1sci}*(0)}"
		s2_sn="${s2si##${s2sci}*(0)}"
		[[ "$s1_sn" -lt "$s2_sn" ]] && return -- -2
		[[ "$s1_sn" -gt "$s2_sn" ]] && return 2
	done
	# Equality check before the inequality comparisons: handles the
	# case where two raw-different inputs normalise to identical r
	# (the common case is `1.0` vs `1.0-r0` — different strings but
	# both have s1_r="" after the leading -r*(0) strip).  Pre-fix
	# this hit the -lt/-gt pair below — both empty operands fail
	# both comparisons, the function fell through to `exit 128`,
	# and the entire script aborted.
	[[ "${s1_r}" == "${s2_r}" ]] && return 0
	[[ "${s1_r}" -lt "${s2_r}" ]] && return -- -1
	[[ "${s1_r}" -gt "${s2_r}" ]] && return 1
	echo "Error! comm_ver failed $1 $2" >&2
	exit 128	# should not reach here
}

# ============================================================================
# === MLSR SORTING + PACKAGE LOOKUPS
# === highest_mlsr, method_sort, is_ver_higher, mlsr_sort, has_version,
# === virtuals_from, virtual_version.
# ============================================================================

# highest_mlsr: echo the highest mlsr among $@ by repeated vercmp '>' insertions.
function highest_mlsr() {
	local highest=""
	local mlsr
	for mlsr in "$@"; do
		if ! [[ "$highest" ]]; then 
			highest=$mlsr
			continue
		fi
		vercmp $mlsr ">" $highest && highest=$mlsr
	done
	echo $highest
}

# method_sort: insertion sort lines on stdin using a custom comparator '$@ a b' returning 0 if a sorts after b.
function method_sort() {
	# An insertion sort, or something like it: we expect the input list to 
	# be largely sorted so want to compare new elements to the top end of 
	# the partial list.
	# <method>: a function which returns true if $1 sorts after $2.
	local -a method=( "$@" )
	read x && local -a list[0]="$x" || return 1
	while read x; do
		local i
		for ((i = ${#list[@]} - 1; i >= 0; --i)); do
			"${method[@]}" "$x" "${list[i]}" && break
		done \
		&& list=("${list[@]:0:i+1}" "$x" "${list[@]:i+1}") \
		|| list=("$x" "${list[@]}")
	done
	for x in "${list[@]}"; do cat <<<"$x"; done
}

# is_ver_higher: true if the leading mlsr token of $1 sorts strictly higher than that of $2 (for method_sort).
function is_ver_higher() {
	# vercmp "${1% *}" ">" "${2% *}"
	comm_ver "${1% *}" "${2% *}"; (( $? > 0 && $? < 128 ))
}

# mlsr_sort: sort mlsr lines on stdin ascending via method_sort is_ver_higher.
function mlsr_sort() {
	method_sort is_ver_higher
}

# has_version: test whether VARDB contains any pkg matching $1 (cat/pn[-ver[*]] with optional <,<=,=,~,>=,> op).
function has_version() {
	pkgspec="$1"
	if [[ "$pkgspec" == virtual/* ]]; then
		grep -q "${pkgspec}" ${VARDB_DIR}/*/*/PROVIDE
		return
	fi
	# (<|<=|=|~|>=|>)?category/package(-version)?*?
	case "$pkgspec" in
		\<=*) vs="<=";pkgspec="${pkgspec:2}";;
		\<*)  vs="<"; pkgspec="${pkgspec:1}";;
		=*)   vs="="; pkgspec="${pkgspec:1}";;
		\~*)  vs="~"; pkgspec="${pkgspec:1}";;
		\>=*) vs=">=";pkgspec="${pkgspec:2}";;
		\>*)  vs=">"; pkgspec="${pkgspec:1}";;
		*)    vs="";;
	esac
	# These globs may match multiple ebuild dirs; the [[ -d "${arr[0]}" ]]
	# check below is "did the glob expand to at least one real dir?" — with
	# bash's default (nullglob off), an unmatched pattern stays literal, so
	# arr[0] is the unexpanded pattern string and fails -d. Explicit [0]
	# index makes that intent obvious.
	case "$vs" in
		=) arr=( ${VARDB_DIR}/$pkgspec )
		[[ -d "${arr[0]}" ]] && return 0 || return 1;;
		\~) arr=( ${VARDB_DIR}/${pkgspec}?(-r+([[:digit:]])) )
		[[ -d "${arr[0]}" ]] && return 0 || return 1;;
		"") arr=( ${VARDB_DIR}/${pkgspec}-$VER_SHPAT )
		[[ -d "${arr[0]}" ]] && return 0 || return 1;;
		*)
		cp="${pkgspec/%-$VER_SHPAT}"
		verstring_req="${pkgspec#${cp}-}"
		avail=( ${VARDB_DIR}/${cp}-$VER_SHPAT )
		[[ -d "${avail[0]}" ]] || return 1
		[[ "${vs}" ]] || return 0
		for inst in "${avail[@]}"; do
			verstring_inst="${inst#${VARDB_DIR}/${cp}-}"
			vercmp "${verstring_inst}" "$vs" "${verstring_req}" && return 0
		done
		return 1;;
	esac
}

# Given a cp, list virtual/* cps that name it as a provider.
function virtuals_from() {
	local cp="$1" virtual providers p
	allvirtuals | while read virtual providers; do
		for p in $providers; do
			[[ "$p" == "$cp" ]] && { echo "$virtual"; break; }
		done
	done
}

# Modern virtuals don't bind providers to a particular version: virtual/foo
# is just a package whose RDEPEND lists candidate providers, evaluated at
# resolution time. So the answer to "given that $cp-$mlsr provides
# $virtual, what mlsr should we ascribe to the virtual?" is just the
# provider's own mlsr — there's no separate virtual-version contour.
function virtual_version() {
	local cp=$1 mlsr=$2 virtual=$3
	for v in $(virtuals_from "$cp"); do
		[[ "$v" == "$virtual" ]] && { echo "$mlsr"; return 0; }
	done
	return 1
}

# XXX outputs stonkingly big and dense graphs -- need a way to trim them down
# ============================================================================
# === DEPENDENCY GRAPH (dot output)
# === dot_depgraph — emits Graphviz .dot for visualisation of dep trees.
# ============================================================================

# dot_depgraph: emit Graphviz .dot for tree/reverse-tree/depends/rev-depends queries with SYSTEM/WORLD clusters.
function dot_depgraph() {
	local -a handled=() queue=()
	if [[ "$1" == @(""|world|system) ]]; then
		[[ "$1" == "system" ]] || for req in $(<${WORLD_FILE}); do
			queue[${#queue[@]}]="$(resolve_depatom "${req}")"
		done
		for req in ${allprofilepackages}; do
			[[ "$req" == \** ]] || continue; req="${req#\*}"
			queue[${#queue[@]}]="$(resolve_depatom "${req}")"
		done
	else for x in "$@"; do
		expand_arg "$x"
		queue[${#queue[@]}]="$RESULT"
	done; fi
	case $do_arg_info in
		tree-depends) 	echo "digraph \"deptree for ${queue[*]}\" {";;
		reverse-tree) 	echo "digraph \"reverse deptree for ${queue[*]}\" {";;
		depends) 		echo "digraph \"deplist for ${queue[*]}\" {";;
		rev-depends) 	echo "digraph \"reverse deplist for ${queue[*]}\" {"
			for node in "${queue[@]}"; do
				echo "	\"$node\" -> \"$(resolve_depatom "$node")\";"
			done;;
		*) format_error <<<"Oops: dot_depgraph unknown type" >&2; return 1;;
	esac
	has $do_arg_info tree-depends depends \
		&& local reverse="" || local reverse="yes"
	while ((${#queue[@]} > 0)); do
		node="${queue[0]}"; queue=("${queue[@]:1}")
		handled[${#handled[@]}]="$node"
		while read dep taint; do
			[[ "$dep" ]] || continue
			depend="$(resolve_depatom "${dep#!}")"
			[[ "$dep" == !virtual/* && "$depend" == "$node" ]] && continue
			[[ "$reverse" ]] \
				&& echo -n "	\"${depend:-$dep}\" -> \"$node\" [" \
				|| echo -n "	\"$node\" -> \"${depend:-$dep}\" ["
			[[ "$taint" ]] && echo -n "label=\"$taint\","
			[[ "$dep" == !* ]] && echo -n "arrowhead=\"odiamond\", color=\"red\","
			echo "];"
			if [[ "$dep" != !* && "$depend" ]] \
				&& has $do_arg_info tree-depends reverse-tree; then
				has "$depend" "${handled[@]}" "${queue[@]}" \
				|| queue[${#queue[@]}]="$depend"
			fi
		done <<<"$([[ "$reverse" ]] && _smartdep $node || resdepend $node)"
	done
	echo "	subgraph \"cluster_SYSTEM\" {"
	echo "		label=\"SYSTEM\";"
	for req in ${allprofilepackages}; do
		[[ "$req" == \** ]] || continue; req="${req#\*}"
		[[ "${handled[*]}" == *${req%-$VER_SHPAT}* ]] || continue
		depend="$(resolve_depatom "${req#\*}")"
		has "$depend" "${handled[@]}" && echo "		\"$depend\";"
	done
	echo "	}"
	echo "	subgraph \"cluster_WORLD\" {"
	echo "		label=\"WORLD\";"
	for req in $(<${WORLD_FILE}); do
		[[ "${handled[*]}" == *${req%-$VER_SHPAT}* ]] || continue
		depend="$(resolve_depatom "${req}")"
		has "$depend" "${handled[@]}" && echo "		\"$depend\";"
	done
	echo "	}"
	echo "}"
}

# ============================================================================
# === SMARTDEP / DEP EVALUATION
# === has_revdepend, add_deps_to_required, makeideal, raw_depends,
# === crunch_depends, cd_evaluate_single, cd_discard_single,
# === cd_already_installed, cd_satisfiable, cd_is_in_use, resdepend,
# === world_sets_expand, _world_sets_expand_one, db_grep, potential_revdepends,
# === info_action_rev-depends, _smartdep, _smartdep_nopv, provided_and_avail,
# === pv_to_cpv, _resolve_depatom_inner_virtual, _resolve_depatom_inner,
# === resolve_depatom.
# ============================================================================

# has_revdepend: true if _smartdep finds any reverse dependency for the given target; thin wrapper.
function has_revdepend() {
	# TODO FIXME make more efficient
	[[ "$(_smartdep "$@")" ]]
}

# add_deps_to_required: recursive: resolve depatom $1 to a cpv, append to $temp_dir/required, walk its deps; respects --depth/--unique.
function add_deps_to_required() {
	local dep="$1"; local ensure="$2"; local cpv
	required=$(<$temp_dir/required)
	cpv="$(resolve_depatom "$dep")" || return
	[[ "$cpv" ]] || return
	has $cpv $required && return
	if [[ "$opt_arg_unique_depends" && -z "$ensure" ]]; then
		has_revdepend $cpv "" "$required" && return
	fi
	echo "$cpv" >> $temp_dir/required
	if [[ "$opt_arg_for_emerge" ]]; then format_atom_for_emerge "$cpv"
	elif (( opt_arg_verbose > 0 )); then echo "$indent$(format_cpv $cpv)$(pads 43 "$indent$cpv")  $(format_depatom "$dep")"
	else echo "$indent$(format_cpv $cpv)"; fi
	[[ "$do_package_sizes" ]] && info_action_size $cpv
	if ! has $cpv $profileprovided; then
		indent="$indent  "
		{ [[ "${opt_arg_depth}" ]] && (( ${#indent} / 2 > opt_arg_depth )); } \
		|| while read dep taint; do
			[[ "$dep" && "${dep:0:1}" != "!" ]] \
				&& add_deps_to_required $dep
		done <<<"$(resdepend $cpv)"
		indent="${indent#  }"
	fi
}

# makeideal: spring-clean: build a required-set from system+world+kernel, diff against installed, then emerge -vC/-v1.
function makeideal() {
	:> $temp_dir/required
	echo "${YL}SYSTEM PROFILE${NO}:"
	for req in $(echo "${allprofilepackages}" | sed 's/\*\(.*\)/\1/;t;d');
	do
		indent="" add_deps_to_required $req
	done
	echo "${BL}WORLD FILE${NO}:"
	for req in $(sort ${WORLD_FILE}); do
		indent="" add_deps_to_required $req
	done
	all_installed_cpvs | while read cpv; do 
		is_running_kernel $cpv || continue; echo $cpv; break
	done >> $temp_dir/required
	sort -u $temp_dir/required > $temp_dir/s_required
	( all_installed_cpvs; echo "$profileprovided" ) \
		| sort -u > $temp_dir/provided
	all_installed_cpvs | sort -u > $temp_dir/installed
	my_redundant=$(comm -2 -3 $temp_dir/installed $temp_dir/s_required)
	missing=$(comm -2 -3 $temp_dir/s_required $temp_dir/provided)
	echo
	echo "${BR}To remove:${NO}"
	echo $'\t''*' $my_redundant
	echo "${BR}To install:${NO}"
	echo $'\t''*' $missing
	[[ "$my_redundant" ]] && emerge -vC $portage_action_arg $my_redundant
	[[ "$missing" ]] && emerge -v1 $portage_action_arg \
					$(echo "$missing" | sed 's/^/=/')
	# The analysis completed; return 0 rather than leaking the exit status
	# of the trailing `[[ "$missing" ]] && ...`, which is 1 whenever there
	# is nothing to install (e.g. `dep -s` on an already-tidy system).
	return 0
}
	
# raw_depends: emit RDEPEND/PDEPEND/IDEPEND (+DEPEND/BDEPEND if build-time) of cpv $1 as one tokenised entry per line.
function raw_depends() {
	cpv=$1
	(
		if [[ "$opt_arg_build_time" ]]; then
			extract_var DEPEND $cpv
			extract_var BDEPEND $cpv
		fi
		extract_var RDEPEND $cpv
		extract_var PDEPEND $cpv
		extract_var IDEPEND $cpv
	) | sed '
		# Protect the parentheses in USE dependency defaults while grouping
		# parentheses are promoted to standalone parser tokens.
		s/(+)/__UDEPT_USE_DEFAULT_ON__/g
		s/(-)/__UDEPT_USE_DEFAULT_OFF__/g
		# Slot/sub-slot/operator suffixes (:0, :*, :=, :0/2, :0=) are
		# preserved in the token stream so the shared atom matcher can enforce
		# them. Structural consumers (dep_to_cps) strip them locally.
		# Tokenise: parens become standalone tokens, whitespace -> newlines
		s/(/ ( /g;s/)/ ) /g;s/[[:space:]]\+/\n/g
		s/__UDEPT_USE_DEFAULT_ON__/(+)/g
		s/__UDEPT_USE_DEFAULT_OFF__/(-)/g
	'
}

# This is AFAICT the only formal specification of Portage dependency syntax
# in existence. Scary, huh. It seems the Portage developers are allergic to
# specifications; maybe they don't like being tied down.
# As a result, this is the product of experiment, surmise and (when all else
# fails) reading the code. It could all become totally wrong tomorrow, as when
# bracket-lists became permissible in or-nodes.
#
# depend syntax:
#
# <depend-list> ::= <depend-node>*
# <depend-node> ::= <b-atom> | <bracket-list> | <or-node> | <use-node>
# <b-atom> ::= <ATOM> | <blocker>
# <blocker> ::= "!"<ATOM>
# <bracket-list> ::= "(" <depend-list> ")"
# <or-node> ::= "||" "(" <depend-node>* ")"
# <use-node> ::= <use-selector>"?" <depend-node>
# <use-selector> ::= ["!"]<USE_FLAG>
#
# evaluation rules:
#
# evaluate(d...) ([depend-node] --> [b-atom]) ==>
#	concatenate evaluate-single(d) for each d
# evaluate-single(d) (depend-node --> [b-atom]) ==>
#	match d in
# 		use-node "u? d" ==> evaluate-single(d) if in-use(u)
# 		or-node "|| ( x... )" ==> 
#			first y where 
#				y = evaluate-single(x) 
#				and already-installed(y)
#			otherwise first y where 
#				y = evaluate-single(x) 
#				and satisfiable(y)
#			otherwise first y where
#				y = evaluate-single(x)
#		bracket-list "( x... )" ==> evaluate(x...)
#		b-atom "b" ==> [b]
# already-installed(b...) ([b-atom] --> BOOLEAN) ==>
#	conjunction match b in
#		ATOM "a" ==> a in INSTALLED_LIST
#		blocker "!a" ==> a not in INSTALLED_LIST
# satisfiable(b...) ([b-atom] --> BOOLEAN) ==>
#	conjunction match b in
#		ATOM "a" ==> a in AVAILABLE_LIST
#		blocker "!a" ==> a in AVAILABLE_LIST	// yes, this is wrong
# // note satisfiable can result in bork merge-lists 
# // e.g. "foo/bar !foo/bar" is satisfiable but not mergeable
# in-use(u) (use-selector --> BOOLEAN) ==>
#	match u in
#		"!u" ==> u not in PACKAGE_USE_LIST
#		"u" ==> u in PACKAGE_USE_LIST
#
function crunch_depends() {
	local my_use; my_use="$(dbuse "$1")"
	local crunch_cpv=$1
	ordeps="$2" # carry through
	local taint=""
	while cd_evaluate_single; do :; done
}
# cd_evaluate_single: crunch_depends inner: read one depend token from stdin and recurse into use-?, ||, ( ), atom, blocker.
function cd_evaluate_single() {
	read tok || return 1
	case "$tok" in
	"" )
		;;
	*\? )
		if cd_is_in_use "${tok%?}"; then
			taint="$taint $tok" cd_evaluate_single
		else
			cd_discard_single
		fi
		;;
	"||" )
		read tok	# (
		local orlist=() ornum=0 success=''
		local instlist=() instnum=0 i
		while orlist[$ornum]="$(taint="$taint ||" cd_evaluate_single)"
		do
			if cd_already_installed "${orlist[$ornum]}"; then
				if [[ "$ordeps" == @(safe|all) ]]; then
					instlist[$((instnum++))]="${orlist[ornum]}"
				else
					echo "${orlist[$ornum]}"
					success=yes
					while cd_discard_single; do :; done
					break
				fi
			fi
			((++ornum))
		done
		if [[ "$ordeps" == safe ]]; then
			# 1-element-array echo: explicit [0] makes intent clear
			# (the elif guarantees ornum==1 / instnum==1 at this point).
			if ((ornum == 1)); then
				echo "${orlist[0]}"
			elif ((instnum == 1)); then
				echo "${instlist[0]}"
			fi
		elif [[ "$ordeps" == all ]]; then
			for ((i=0;i<ornum;++i)); do
				echo "${orlist[$i]}"
			done
		else
			if ! [[ "$success" ]]; then
				for ((i=0;i<ornum;++i)); do
					if cd_satisfiable "${orlist[$i]}"; then
						echo "${orlist[$i]}"
						success=yes
						break
					fi
				done
			fi
			if ! [[ "$success" ]]; then
				echo "${orlist[0]}"
			fi
		fi
		;;
	'(' )
		while cd_evaluate_single; do :; done
		;;
	')' )					#'fix vim syntax
		return 1;;
	* )
		echo "$tok $taint"
		;;
	esac
	return 0
}
# cd_discard_single: skip one depend-tree branch (matching parens) without evaluating — used for the inactive use? arm.
function cd_discard_single() {
	local depth=0 tok
	while read tok; do case "$tok" in
		*\? ) ;;
		"||" ) ;;
		'(' ) ((++depth)) ;;
		')' ) ((--depth)); ((depth <= 0)) && break ;;	# 'fix vim
		* ) ((depth == 0)) && break ;;
	esac; done
	(( depth == 0 )) && [[ "$tok" ]]
}
# cd_already_installed: test whether all atoms in 'batom taint' lines on $1 resolve to an installed cpv (with blocker inversion).
function cd_already_installed() {
	echo "$1" | while read batom taint; do
		if [[ "$(resolve_depatom "${batom##+(!)}" "yes" "$crunch_cpv" 2>/dev/null)" ]]
		then
			[[ "${batom:0:1}" != "!" ]] || return 1
		else
			[[ "${batom:0:1}" == "!" ]] || return 1
		fi
	done
}
# cd_satisfiable: test whether all atoms in 'batom taint' lines on $1 resolve to *some* cpv (installed or available).
function cd_satisfiable() {
	echo "$1" | while read batom taint; do
		if [[ "$batom" == !* ]]; then
			[[ -z "$(resolve_depatom "${batom##+(!)}" yes "$crunch_cpv" 2>/dev/null)" ]] || return 1
		else
			[[ "$(resolve_depatom "$batom" "" "$crunch_cpv" 2>/dev/null)" ]] || return 1
		fi
	done
}
# cd_is_in_use: test whether use selector $1 (optionally !-prefixed) matches the caller's $my_use list.
function cd_is_in_use() {
	if has "${1#!}" $my_use; then [[ "${1:0:1}" != '!' ]]
	else [[ "${1:0:1}" == '!' ]]; fi
}

# resdepend: emit one 'atom taint' line per resolved dependency of cpv $1; raw_depends piped through crunch_depends.
function resdepend() {
	local cpv="$1" ordeps="$2"
	set_xterm_title "Calculating dependencies of: $cpv"
	# (No taint reset here — crunch_depends declares its own local taint.)
	raw_depends "$cpv" | crunch_depends "$cpv" "$ordeps" | sort -u
}
# pruneworld / depclean walk the same package's deps repeatedly across
# different needles; memoising resdepend cuts each second-and-later call
# from a full crunch_depends walk to a cat from $temp_dir.
memoise resdepend

# Recursively expand /var/lib/portage/world_sets, emitting one atom per line.
# Sets in @world_sets are looked up in /etc/portage/sets/<name> as plain
# atom files (Portage's StaticFileSet — the format users normally write).
# Built-in dynamic sets (@selected, @system, @world, @profile, …) are skipped:
# @selected duplicates WORLD_FILE, @system duplicates allprofilepackages, and
# the rest are computed from runtime state we either already cover or
# couldn't expand without re-implementing Portage's set machinery.
function world_sets_expand() {
	[[ -r "$WORLD_SETS_FILE" ]] || return 0
	local set
	declare -A seen=()
	while read -r set; do
		[[ "$set" == "@"* ]] || continue
		_world_sets_expand_one "${set#@}"
	done <"$WORLD_SETS_FILE"
}

# Recursive helper. $1 is a bare set name (no leading @). $seen tracks names
# already expanded to break cycles.
function _world_sets_expand_one() {
	local name="$1" line
	# Reject anything that could escape the sets directory or trip on shell
	# pattern characters. Real set names are [a-zA-Z0-9_-]+.
	[[ "$name" == */* || "$name" == .. || "$name" == .*/* || "$name" != +([[:alnum:]_-]) ]] && return 0
	[[ -z "${seen[$name]:-}" ]] || return 0
	seen[$name]=1
	case "$name" in
	selected|selected-packages|selected-sets|world|profile|system|installed|usersets|security|preserved-rebuild|live-rebuild|deprecated-live-rebuild|module-rebuild|x11-module-rebuild|rebuilt-binaries)
		return 0
		;;
	esac
	[[ -r "$ETC_PORTAGE_SETS_DIR/$name" ]] || return 0
	while read -r line; do
		line="${line%%#*}"
		line="${line##+([[:space:]])}"
		line="${line%%+([[:space:]])}"
		[[ -z "$line" ]] && continue
		if [[ "$line" == "@"* ]]; then
			_world_sets_expand_one "${line#@}"
		else
			echo "$line"
		fi
	done <"$ETC_PORTAGE_SETS_DIR/$name"
}
memoise world_sets_expand

# db_grep: scan packages for needle $1 in vardb attribute $attr ($3); mode-dependent — --original-depends finds files literally named $attr, --uninstalled greps md5-cache for any field, default greps the named vardb attribute file ($attr="*DEPEND" expands to DEPEND/RDEPEND/BDEPEND/IDEPEND/PDEPEND).
function db_grep() {
	local needle="$1" with_tree="$2" attr="$3" tree cpv
	if [[ "$opt_arg_original_depends" ]]; then
		# -exec ... + is null-safe vs `| xargs` (filenames in
		# /var/db/pkg are well-known but defensive shape anyway).
		find ${VARDB_DIR} -name "$attr" \
			-exec grep -l "${needle}" {} + \
		| cut -d/ -f5-6
	elif [[ "$opt_arg_uninstalled" ]]; then
		for tree in $portage_trees; do
			[[ -d "${tree}/metadata/md5-cache" ]] || continue
			# Subshell so the cd doesn't leak to the surrounding script.
			( cd "${tree}/metadata/md5-cache" || exit 0
			  grep -rl "${needle}" . 2>/dev/null \
			  | while read cpv; do
				[[ -e "${tree}/${cpv%-${VER_SHPAT}}/${cpv##*/}.ebuild" ]] \
					|| [[ -d ${VARDB_DIR}/${cpv} ]] \
					|| continue
				[[ "$with_tree" ]] && echo "${cpv:2} ${tree}" || echo "${cpv:2}"
			  done )
		done | { [[ "$with_tree" ]] && cat || sort -u; }
	else
		# Default: only installed packages. Grep their per-attribute vardb
		# files directly — vardb dep files reflect what the package was
		# actually installed with, which is the right answer for revdep.
		#
		# $attr selects which vardb file(s) to scan.  The pseudo-name
		# "*DEPEND" expands to the five dep variants (DEPEND, RDEPEND,
		# BDEPEND, IDEPEND, PDEPEND) — that's what potential_revdepends
		# wants.  Any other value (e.g. "IUSE", "KEYWORDS") matches that
		# vardb attribute literally, which is what info_action_iuse and
		# similar attribute-scoped callers want.  Empty $attr falls back
		# to the *DEPEND set so legacy two-arg callers behave as before.
		local find_names
		if [[ -z "$attr" || "$attr" == '*DEPEND' ]]; then
			find_names=( '(' -name DEPEND -o -name RDEPEND -o -name BDEPEND \
				-o -name IDEPEND -o -name PDEPEND ')' )
		else
			find_names=( -name "$attr" )
		fi
		find ${VARDB_DIR} -mindepth 3 -maxdepth 3 \
			"${find_names[@]}" \
			-exec grep -l "${needle}" {} + 2>/dev/null \
		| sed -n "s!^${VARDB_DIR}/\\([^/]*/[^/]*\\)/.*!\\1!p" \
		| sort -u \
		| while read cpv; do
			if [[ "$with_tree" ]]; then
				echo "${cpv} $(best_tree $cpv)"
			else
				echo "${cpv}"
			fi
		done
	fi
}

# potential_revdepends: echo cpvs whose *DEPEND mentions cp $1 as a leading atom, filtered by exclusion list $2.
function potential_revdepends() {
	local needle="$1" exclude="$2" excl_sed="\!^$" excl
	for excl in $exclude; do
		[[ "$excl" == =* ]] \
		&& excl_sed="$excl_sed"'\|^'"${excl:1}"'$' \
		|| excl_sed="$excl_sed"'\|^'"${excl}-$VER_REGEXP"'$'
	done
	excl_sed="$excl_sed!d"
	# An atom starting with $needle is followed by one of: -DIGIT (version),
	# space, ), end-of-line, : (slot), or [ (USE-deps).
	db_grep "${needle}"'\(-[0-9]\| \|)\|$\|:\|\[\)' "" '*DEPEND' \
	| sed -e "$excl_sed"
}

# info_action_rev-depends: --rev-depends: _smartdep on $1 + asvirtual=$2, piped through format_revdep.
function info_action_rev-depends() {
	local asvirtual="$2"
	_smartdep "$1" | format_revdep "$asvirtual"
}

# Calculate reverse dependencies of a package
function _smartdep() {
	if [[ "$1" != *-$VER_SHPAT ]]; then
		_smartdep_nopv "$@"
		return
	fi
	# If you think you can understand this code, you don't.
	# The comments were put in to enable me to write it, not to enable you
	# (or me) to read it.
	local cpv="$1"
	local asvirtual="$2" 	# a cp; get mlsr from virtual_version
	local exclude="$3"	# list first rdep not in $exclude
	local ordeps="$4"
	local no_warn_superseded="$5"
	set_xterm_title "Reverse dependencies of: $cpv"
	local cp="${cpv/%-$VER_SHPAT}"
	local mlsr="${cpv#${cp}-}"
	local installed versions
	installed="$(provided_mlsrs $cp)"
	versions="$(avail_versions $cp "" "" yes yes) $installed"
	# find a depatom this satisfies but (other) installed versions 
	# with higher priority of satisfaction do not	
	if [[ "$asvirtual" ]]; then
		# Split decl from assign so `|| return` checks virtual_version's
		# exit, not `local`'s — the combined form makes `local` swallow
		# the inner command's status (always returns 0).
		local virtual_mlsr
		virtual_mlsr=$(virtual_version $cp $mlsr $asvirtual) || return
		local virtual_cpv=$asvirtual-$virtual_mlsr
		# using tac and sort -u to take the highest package-mlsr
		# for each virtual-mlsr
		local cands
		cands="$(
		echo "${installed}" | mlsr_sort | tac \
		| while read amlsr; do
			vmlsr="$(virtual_version $cp $amlsr $asvirtual)" \
			|| continue
			echo $vmlsr $amlsr
		done | sort -s -k1,1 -u | tac | sed "/ $mlsr$/d" | cut -d' ' -f1
		)"
		# if installed, only consider higher versions as candidates 
		# with greater priority of satisfaction - otherwise any 
		# installed version has higher priority. Also applies below.
		# Also, if masked then all unmasked versions have higher 
		# priority.
		cands_="$cands"; cands=""
		if ! [[ -d ${VARDB_DIR}/$cpv ]]; then
			cands="$cands_"
		elif has $mlsr $versions; then for vmlsr in ${cands_}; do
			vercmp $vmlsr ">=" $virtual_mlsr \
				&& cands="$cands $vmlsr"
		done; else for vmlsr in ${cands_}; do
			{ vercmp $vmlsr ">=" $virtual_mlsr || has $vmlsr $versions; } \
				&& cands="$cands $vmlsr"
		done; fi
	else
		unset $virtual_mlsr; unset $virtual_cpv
		cands=""
		if [[ ! -d ${VARDB_DIR}/$cpv ]]; then for x in ${installed}; do
			[[ $x != "$mlsr" ]] && ! has $x $cands \
				&& cands="$cands $x"
		done; elif has $mlsr $versions; then for x in ${installed}; do
			[[ $x != "$mlsr" ]] && ! has $x $cands && vercmp $x ">=" $mlsr \
				&& cands="$cands $x"
		done; else for x in ${installed}; do
			[[ $x != "$mlsr" ]] && ! has $x $cands \
				&& { vercmp $x ">=" $mlsr || has $x $versions; } \
				&& cands="$cands $x"
		done; fi
	fi
	local needle=${asvirtual:-$cp}
	local ncpv=${virtual_cpv:-$cpv}
	# Optional slot suffix on the matched atom — ':slot[/sub][=]' or ':*'.
	# raw_depends now preserves these in the token stream; the regex used
	# to require a literal space immediately after the atom which would
	# silently miss every slot-bearing depatom.
	local atom_suffix='\(:[[:alnum:]_.+*/=-]\+\)\?\(::[[:alnum:]_.+-]\+\)\?\(\[[^]]*\]\)\?'
	potential_revdepends $needle \
	| while read deppkg; do
		has $deppkg $exclude && continue
		resdepend "${deppkg}" "${ordeps}" | grep '^\('"${needle}"'\|''\([<>]=\?\|[=~]\)'"${needle}-$VER_REGEXP"'\*\?''\)'"${atom_suffix}"' ' \
		| while read depatom taint; do
			if dep_satisfies_atom "${ncpv}" "$depatom" "" "" "$deppkg"; then
				if ! echo "${cands}" | while read candidate; do
					dep_satisfies_atom "${needle}-${candidate}" "$depatom" "" "" "$deppkg" && break
				done; then
					printf '%s %s%s\n' "$deppkg" "$depatom" "${taint:+ $taint}"
					[[ "$exclude" ]] && return 1
					break
				else
					[[ "$no_warn_superseded" ]] || echo "$ncpv superseded on $depatom ($deppkg) by one of" $cands | format_error >&2
				fi
			fi
		done || return 1
	done || return 0
	echo "${allprofilepackages}" | grep '^\*\('"${needle}"'\|''\([<>]=\?\|[=~]\)'"${needle}-$VER_REGEXP"'\*\?''\)'"${atom_suffix}"'[[:space:]]*$' \
	| while read depatom; do
		depatom=${depatom#\*}
		if dep_satisfies_atom "$ncpv" "$depatom"; then
			if ! echo "${cands}" | while read candidate; do
				dep_satisfies_atom "${needle}-${candidate}" "$depatom" && break
			done; then
				echo SYSTEM $depatom
				break
			fi
		fi
	done
	{ cat ${WORLD_FILE}; world_sets_expand; } \
	| grep '^\('"${needle}"'\|''\([<>]=\?\|[=~]\)'"${needle}-$VER_REGEXP"'\*\?''\)'"${atom_suffix}"'[[:space:]]*$' \
	| while read depatom; do
		if dep_satisfies_atom "$ncpv" "$depatom"; then
			if ! echo "${cands}" | while read candidate; do
				dep_satisfies_atom "${needle}-${candidate}" "$depatom" && break
			done; then
				echo WORLD $depatom
				break
			fi
		fi
	done
	[[ "${asvirtual}" ]] || for virtual in $(virtuals_from $cp); do
		_smartdep $cpv $virtual "$exclude" "$ordeps" "$no_warn_superseded"
	done
	is_running_kernel $cpv && echo KERNEL
}
memoise _smartdep

# _smartdep_nopv: slot-agnostic reverse-dep search: walk potential_revdepends, resdepend filter, plus SYSTEM/WORLD/virtuals.
function _smartdep_nopv () {
	local needle="$1"	# cp
	set_xterm_title "Reverse dependencies of: $needle"
	local asvirtual="$2"
	local exclude="$3"
	local ordeps="$4"
	trap return SIGPIPE
	# Slot-agnostic: target is a cp with no version, so we can't pin a
	# specific SLOT for filtering. The regex still has to *tolerate*
	# slots in the token stream now that raw_depends preserves them.
	local atom_suffix='\(:[[:alnum:]_.+*/=-]\+\)\?\(::[[:alnum:]_.+-]\+\)\?\(\[[^]]*\]\)\?'
	potential_revdepends ${needle} "$exclude" \
	| while read deppkg; do
		resdepend "${deppkg}" "${ordeps}" | grep '^\('"${needle}"'\|''\([<>]=\?\|[=~]\)'"${needle}-$VER_REGEXP"'\*\?''\)'"${atom_suffix}"' ' \
		| if read depatom taint; then
			echo $deppkg $depatom $taint
			[[ -z "$exclude" ]] || return 1
		fi
	done || return 0
	echo "${allprofilepackages}" | grep '^\*\('"${needle}"'\|''\([<>]=\?\|[=~]\)'"${needle}-$VER_REGEXP"'\*\?''\)'"${atom_suffix}"'[[:space:]]*$' \
	| if read depatom; then echo SYSTEM $depatom; fi
	{ cat ${WORLD_FILE}; world_sets_expand; } \
	| grep '^\('"${needle}"'\|''\([<>]=\?\|[=~]\)'"${needle}-$VER_REGEXP"'\*\?''\)'"${atom_suffix}"'[[:space:]]*$' \
	| if read depatom; then echo WORLD $depatom; fi
	for virtual in $(virtuals_from $needle); do
		_smartdep_nopv "$virtual" "yes" "$exclude" "$ordeps"
	done
	for mlsr in $(installed_mlsrs $needle); do
		is_running_kernel $needle-$mlsr && echo KERNEL
	done
	trap - SIGPIPE
}

# provided_and_avail: echo injected+installed mlsrs of cp $1 via provided_mlsrs (highest first), then available mlsrs unless installed-only ($2).
function provided_and_avail() {
	trap return SIGPIPE
	provided_mlsrs "$1" | mlsr_sort | tac
	[[ "$2" ]] || avail_versions "$1" "" "" yes yes | mlsr_sort | tac
	trap - SIGPIPE
}

# pv_to_cpv: for bare pkg-version $1, echo each category/PV that has a matching package dir in any tree.
function pv_to_cpv() {
	pv="$1"
	p="${pv/%-$VER_SHPAT?(\*)}"
	for category in $categories; do
		for tree in $portage_trees; do
			if [[ -d $tree/$category/$p ]]; then
				echo "$category/$pv"
				break
			fi
		done
	done
}
# Called per emitted revdep in info_action_rev-exists; on packages with
# hundreds of revdeps that's hundreds of duplicate category-walks across
# every repo (~150 cats × 7 trees of stat()s per call). Memoise it.
memoise pv_to_cpv

# _resolve_depatom_inner_virtual: resolve_depatom helper: try v_cpv (a virtual provider) against operator/version, emit cpv on first hit.
function _resolve_depatom_inner_virtual() {
	v_cp="${v_cpv%-$VER_SHPAT?(\*)}"; v_mlsr="${v_cpv#${v_cp}?(-)}"
	while read t_mlsr; do
		[[ "$t_mlsr" ]] || continue
		{ [[ -z "$v_mlsr" ]] || dep_satisfies_mlsr "$t_mlsr" "$vs" "$v_mlsr"; }\
			&& { [[ -z "$d_mlsr" ]] || dep_satisfies_mlsr \
				"$(virtual_version $v_cp $t_mlsr $d_cp)" "$vs" "$d_mlsr"; } \
			&& { echo "$v_cp-$t_mlsr"; return 0; }
	done <<<"$(provided_and_avail "$v_cp" "$installed_only")"
	return 1
}

# _resolve_depatom_inner: resolve_depatom helper: try direct cp matches first, then walk allvirtuals for indirect providers.
function _resolve_depatom_inner() {
	d_cp="${d_cpv/%-$VER_SHPAT?(\*)}"; d_mlsr="${d_cpv##${d_cp}?(-)}"
	while read t_mlsr; do
		[[ "$t_mlsr" ]] || continue
		dep_satisfies_atom "$d_cp-$t_mlsr" "$resolve_atom" "" "" "$resolve_parent" \
			&& { echo "$d_cp-$t_mlsr"; return 0; }
	done <<<"$(provided_and_avail "$d_cp" "$installed_only")"
	for v_cpv in $(allvirtuals | sed 's!^'"$d_cp"' \(.*\)$!\1!;t;d'); do
		_resolve_depatom_inner_virtual && return 0
	done
	return 1
}

# resolve_depatom: echo first cpv satisfying depatom $1 (installed-only when
# $2), enforcing every constraint through the shared matcher; memoised.
function resolve_depatom() {
	depatom="$1"; installed_only="$2"; resolve_parent="$3"; resolve_atom="$1"
	set_xterm_title "Resolving dependency: $depatom"
	atom_parse "$depatom" || { format_error <<<"Invalid depatom $depatom" >&2; return 1; }
	d_cp=$ATOM_CP; d_mlsr=$ATOM_VERSION; vs=$ATOM_OP; d_cpv=$d_cp${d_mlsr:+-$d_mlsr}
	if [[ "$d_cpv" == */* ]]; then
		_resolve_depatom_inner && return 0
	else
		while read d_cpv; do
			[[ "$d_cpv" ]] || continue
			resolve_atom=$d_cpv
			_resolve_depatom_inner && return 0
		done <<<"$(pv_to_cpv "$d_cpv")"
	fi
	format_error <<<"Cannot resolve depatom $depatom" >&2
	echo "${FUNCNAME[@]}" >&2
	return 1
}
memoise resolve_depatom

# ============================================================================
# === MASK / KEYWORD
# === is_in_maskfile, is_inclusion_masked, is_package_masked,
# === is_package_unmasked, get_mask_comment, keyword_sym, is_keyword_masked.
# ============================================================================

# is_in_maskfile: true if cp/mlsr ($1/$2), from optional tree $3, is
# masked by any line in mask files $4+ (after stacking_sort, !-inverts).
function is_in_maskfile() {
	local cp=$1 mlsr=$2 tree=$3; shift 3
	kill_comments_and_blanks "$@" 2>/dev/null | grep -F "$cp" | stacking_sort yes \
	| while read depatom; do
		atom_parse "$depatom" || continue
		[[ "$ATOM_CP" == "$cp" ]] || continue
		! dep_satisfies_atom "${cp}-${mlsr}" "$depatom" '' '' '' "$tree" || return 1
	done || return 0; return 1
}

# is_inclusion_masked: true if cp has an include-atom in profile 'packages' but no include-atom matches this specific mlsr (i.e. mlsr is excluded from the inclusion set).
function is_inclusion_masked() {
	local cp=$1 mlsr=$2 tree=${3-}
	grep -F "$cp" <<<"${allprofilepackages}" \
	| while read depatom; do
		depatom="${depatom#\*}"
		atom_parse "$depatom" || continue
		[[ "$ATOM_CP" == "$cp" ]] || continue
		dep_satisfies_atom "${cp}-${mlsr}" "$depatom" '' '' '' "$tree" || return 1
	done || return 0; return 1
}

# is_package_masked: true if cp/mlsr is masked by profile inclusion or package.mask (unless covered by package.unmask, ret 2).
function is_package_masked() {
	local cp=$1 mlsr=$2 tree=${3-}
	is_inclusion_masked "$cp" "$mlsr" "$tree" && return 0
	is_in_maskfile "$cp" "$mlsr" "$tree" $(etc_portage_files package.unmask) && return 2
	is_in_maskfile "$cp" "$mlsr" "$tree" $(profile_files_extra package.mask)
}

# is_package_unmasked: true if cp/mlsr is in profile package.mask AND in /etc/portage/package.unmask.
function is_package_unmasked() {
	local cp=$1 mlsr=$2 tree=${3-}
	is_in_maskfile "$cp" "$mlsr" "$tree" $(profile_files_extra package.mask) \
		&& is_in_maskfile "$cp" "$mlsr" "$tree" $(etc_portage_files package.unmask)
}

# get_mask_comment: echo coloured mask provenance for cp/mlsr: SYSTEM PROFILE or atom+commentary from each profile package.mask.
function get_mask_comment() {
	local cp=$1 mlsr=$2 tree=${3-} depatom

	grep -F "$cp" <<<"${allprofilepackages}" \
	| while read depatom; do
		depatom="${depatom#\*}"
		atom_parse "$depatom" || continue
		[[ "$ATOM_CP" == "$cp" ]] || continue
		if ! dep_satisfies_atom "${cp}-${mlsr}" "$depatom" '' '' '' "$tree"; then
			echo "${RD}SYSTEM PROFILE${NO}"
			return 1
		fi
	done || return 0
	local x; local -a exclude=( )
	for x in $(profile_files_extra package.mask); do
		local state=""
		while read line; do
			case "$state" in
			"")
				if [[ "$line" == -* ]]; then
					depatom=${line#-}
					atom_parse "$depatom" && [[ "$ATOM_CP" == "$cp" ]] \
						&& dep_satisfies_atom "${cp}-${mlsr}" "$depatom" '' '' '' "$tree" \
						&& exclude[${#exclude[@]}]="$depatom"
				else
					atom_parse "$line" && [[ "$ATOM_CP" == "$cp" ]] \
						&& dep_satisfies_atom "${cp}-${mlsr}" "$line" '' '' '' "$tree" \
						&& ! has "$line" "${exclude[@]}" \
						&& { state="found"; format_depatom "$line"; }
				fi;;
			"found") 
				[[ "$line" == *([[:space:]]) ]] && break
				[[ "$line" == "#"* ]] && { state="comment"; echo "${RD}$line${NO}"; };;
			"comment")
				[[ "$line" == "#"* ]] || break
				echo "${RD}$line${NO}";;
			esac
		done <<<"$(tac "$x")"
		if [[ "$state" ]]; then
			[[ "$x" == "$PORTDIR/profiles/package.mask" ]] \
				|| echo "[${Rd}${x}${NO}]"
		fi
	done | tac
}

# keyword_sym: echo a one-char keyword status sym (' ', '~', '-') for cp/mlsr/tree; return code encodes accept origin.
function keyword_sym() {
	local cp=$1 mlsr=$2 tree=$3
	local my_keywords my_accept k_unstable="" k_masked=""
	keywords_for $cp-$mlsr "$tree" my_keywords
	has '*' "${my_keywords[@]}" && { echo " "; return 1; }
	accept_for "$cp" "$mlsr" my_accept "$tree"
	has '*' "${my_accept[@]}" && for keyword in "${my_keywords[@]}"; do
		[[ "$keyword" != [~-]* ]] && { echo " "; return 3; }
	done
	has '~*' "${my_accept[@]}" && for keyword in "${my_keywords[@]}"; do
		[[ "$keyword" == \~* ]] && k_unstable="~"
	done
	for keyword in "${my_keywords[@]}"; do
		has "$keyword" "${my_accept[@]}" || continue
		case "$keyword" in
			-* ) k_masked="-";;
			\~* ) k_unstable="~";;
			* ) echo " "; return 2;;
		esac
	done
	[[ "$k_unstable" ]] && { echo "~"; return 2; }
	[[ "$k_masked" ]] && { echo "-"; return 2; }
	for keyword in "${my_keywords[@]}"; do
		[[ "$keyword" != [~-]* ]] && { echo " "; return 0; }
	done
	for keyword in "${my_keywords[@]}"; do
		[[ "$keyword" == \~* ]] && { echo "~"; return 0; }
	done
	echo "-"; return 0;
}

# is_keyword_masked: true (return 0) if cp/mlsr ($1/$2) in tree $3 isn't accepted by ACCEPT_KEYWORDS+package.accept_keywords.
function is_keyword_masked() {
	local cp=$1 mlsr=$2 tree=$3
	local my_keywords my_accept
	keywords_for $cp-$mlsr "$tree" my_keywords
	has '*' "${my_keywords[@]}" && return 1 
	accept_for "$cp" "$mlsr" my_accept "$tree"
	has '*' "${my_accept[@]}" && for keyword in "${my_keywords[@]}"; do
		[[ "$keyword" != [~-]* ]] && return 3
	done
	has '~*' "${my_accept[@]}" && for keyword in "${my_keywords[@]}"; do
		[[ "$keyword" == \~* ]] && return 3
	done
	for keyword in "${my_keywords[@]}"; do
		has "$keyword" "${my_accept[@]}" && return 2
	done
	return 0
}

# ============================================================================
# === PACKAGE INVENTORY
# === avail_versions, provided_mlsrs, injected_mlsrs, installed_mlsrs,
# === all_installed_cpvs, all_installed_cp_mlsrs, is_running_kernel,
# === not_in_tree.
# ============================================================================

# avail_versions: for cp $1 walk all trees' ebuilds; emit each mlsr (+tree when $2); optionally drop pmask/kmask via $4/$5.
function avail_versions() {
	local cp="$1" showtree="$2" _unused="$3"
	local excl_pmask="$4" excl_kmask="$5"
	local any_printed="" tree ebuild mlsr pn=${cp#*/}
	for tree in $portage_trees; do
		for ebuild in ${tree%/}/${cp}/${pn}-$VER_SHPAT.ebuild; do
			[[ -f "$ebuild" ]] || continue
			mlsr=${ebuild#${tree%/}/${cp}/${pn}-}
			mlsr=${mlsr%.ebuild}
			[[ "$excl_pmask" ]] && is_package_masked "$cp" "$mlsr" "$tree" && continue
			[[ "$excl_kmask" ]] && is_keyword_masked $cp $mlsr $tree && continue
			[[ "$showtree" ]] && echo $mlsr ${tree%/} || echo $mlsr
			any_printed="yes"
		done
	done
	[[ "$any_printed" ]]
}
memoise avail_versions

# provided_mlsrs: echo injected_mlsrs followed by installed_mlsrs (both for cp $1).
function provided_mlsrs() {
	injected_mlsrs "$@"
	installed_mlsrs "$@"
}

# injected_mlsrs: echo each mlsr declared by profile package.provided for cp $1.
function injected_mlsrs() {
	cp="$1"
	for x in $profileprovided; do
		[[ "$x" == "$cp"-$VER_SHPAT ]] && echo "${x#${cp}-}"
	done
}

# installed_mlsrs: echo each installed mlsr (vardb dir) for cp $1, optionally skipping masked ones when $2.
function installed_mlsrs() {
	cp="$1"; remove_masked="$2"
	for dir in ${VARDB_DIR}/$cp-$VER_SHPAT; do
		[[ -d "$dir" ]] || continue
		mlsr=${dir#${VARDB_DIR}/${cp}-}
		if [[ "$remove_masked" ]]; then
			is_package_masked "$cp" "$mlsr" '' && continue
			is_keyword_masked $cp $mlsr && continue
		fi
		echo $mlsr
	done
}
memoise installed_mlsrs

# all_installed_cpvs: echo every installed cpv (sorted) by listing vardb cat/pkg-ver dirs.
function all_installed_cpvs() {
	find ${VARDB_DIR} -mindepth 2 -maxdepth 2 -type d \
	| cut -c13- \
	| sort
}

# all_installed_cp_mlsrs: emit one 'cp mlsr mlsr...' line per installed cp, grouping mlsrs by their shared cp.
function all_installed_cp_mlsrs() {
	oldcp=""
	all_installed_cpvs | while read cpv; do
		cp="${cpv/%-$VER_SHPAT}"
		if [[ "$oldcp" == "$cp" ]]; then
			echo -n ${cpv#$cp-} ''
		else
			echo -n ${oldcp:+$'\n'}$cp ${cpv#$cp-} ''
			oldcp=$cp
		fi
	done
	echo
}

# is_running_kernel: true if cpv $1 is installed, provides virtual/linux-sources, and its KV matches uname -r.
function is_running_kernel() {
	cpv=$1
	[[ -d ${VARDB_DIR}/$cpv ]] \
		&& has virtual/linux-sources $(virtuals_from "${cpv%-$VER_SHPAT}") \
		&& [[ "$(extract_var_from_vardb KV $cpv)" == "$(uname -r)" ]]
}

# not_in_tree: warn on stderr when cp/mlsr is installed but masked/kmasked/missing-ebuild; advisory only.
function not_in_tree() {
	cp=$1; mlsr=$2
	if tree=$(best_tree $cp-$mlsr); then
		if is_package_masked "$cp" "$mlsr" "$tree"; then
			format_error >&2 <<END
The package $(format_cpv $cp-$mlsr) is installed, but is masked. ${BR}Things will break.${NO} Please correct this to ensure sensible results.
END
		elif is_keyword_masked $cp $mlsr $tree; then
			format_error >&2 <<END
The package $(format_cpv $cp-$mlsr) is installed, but is keyword masked. ${BR}Things will break.${NO} Please correct this to ensure sensible results.
END
		else
			format_error >&2 <<END
Oops: not_in_tree $cp $mlsr called on valid unmasked package
END
		fi
	elif avail_versions $cp >/dev/null; then
		format_error >&2 <<END
The package $(format_cpv $cp-$mlsr) is installed, but does not have a corresponding ebuild in an accessible portage tree. ${BR}Things will break.${NO} Please correct this to ensure sensible results.
END
	else
		: # no ebuilds for this package in trees - perhaps a g-cpan.pl
	fi
}

# ============================================================================
# === INFO ACTIONS — TREE-DEPENDS / DEPENDS / EXISTS
# === rtnode, info_action_tree-depends, info_action_reverse-tree,
# === print_depstring, info_action_depstrings, info_action_depends,
# === info_action_exists, info_action_rev-exists, redundant_of_all_cp_mlsrs,
# === redundant.
# ============================================================================

# rtnode: reverse-tree recursion: walk _smartdep of $1, format each, recurse on non-SYSTEM/WORLD/KERNEL; flags circular.
function rtnode() {
	local node="$1" noworld="$2" forcircular="$3" ordeps="$4"
	local allcircular=0
	[[ "${opt_arg_depth}" ]] && (( ${#indent} / 2 >= opt_arg_depth )) && return
	# note that unrooted revdeps count as circular. this makes sense for
	# the pruneworld case; we don't want to remove sth from world and
	# then have depclean remove it
	while read deppkg depatom taint; do
		[[ "$deppkg" ]] || continue
		if [[ "$opt_arg_for_emerge" ]]; then
			# Flat atom list; skip non-atom sentinels.
			[[ "$deppkg" == @(WORLD|SYSTEM|KERNEL) ]] || format_atom_for_emerge "$deppkg"
		else echo "$deppkg $depatom $taint" | format_revdep "" "$indent  "; fi
		if has "$deppkg" $rt_encountered; then
			[[ "$forcircular" ]] || format_error <<<"circular dependency: $rt_encountered $deppkg" >&2
		else
			if [[ "$deppkg" == SYSTEM ]]; then
				allcircular=1
			elif [[ "$deppkg" == WORLD ]]; then
				[[ "$noworld" ]] || allcircular=1
			elif [[ "$deppkg" == KERNEL ]]; then
				:
			else
				rt_encountered="$rt_encountered $deppkg" indent="$indent  " rtnode "$deppkg" "" "$forcircular" ""
				((allcircular |= $?))
			fi
		fi
		[[ "$forcircular" ]] && ((allcircular > 0)) && break
	done <<<"$(_smartdep "$node" "" "" "$ordeps" "no")"
	return $allcircular
}

# info_action_tree-depends: --tree-depends: reset $temp_dir/required and recursively add_deps_to_required for $1.
function info_action_tree-depends() {
	set_xterm_title "Displaying dependency tree of $1"
	indent=""
	:> $temp_dir/required
	add_deps_to_required "$1" yes
}

# info_action_reverse-tree: --reverse-tree: initialise rt_encountered (resolving star_arg if no version), recurse via rtnode.
function info_action_reverse-tree() {
	set_xterm_title "Displaying reverse dependency tree of $1"
	indent=""
	if [[ "$1" == *-$VER_SHPAT ]]; then
		rt_encountered="$1"
	else
		star_arg "$1" yes yes
		rt_encountered="$RESULT"
	fi
	rtnode "$@"
}

# print_depstring: pretty-print one named DEPEND var ($1) of cpv $2 with indented parens, taint, resolved cpv per atom.
function print_depstring() {
	local name=$1; local cpv="$2"
	local indent="    "; local taint=""; local or=""
	echo ${BL}$name${NO}:
	extract_var $name $cpv \
	| sed 's/(/( /g;s/)/ )/g;s/[[:space:]]\+/\n/g' \
	| while read tok; do case "$tok" in
		""  ) continue;;
		\)  ) indent="${indent#    }"; echo "$indent$tok";;
		*\? ) taint="$tok ";;
		\(  ) 
		echo "$indent$(format_taint "$cpv" "$taint")${or:+${FC}||${NO} }$tok"
		indent="$indent    "; taint=""; or="";;
		"||"  ) or="$tok ";;
		\!* )
		echo "$indent$(format_taint "$cpv" "$taint")${or:+${FC}||${NO} }${RD}$tok${NO}"
		taint=""; or="";;
		*   )
		dcpv="$(resolve_depatom "${tok}")" \
		&& dcpv="$(format_cpv $dcpv)" || dcpv="${RD}!!!${NO}"
		echo "$indent$(format_taint "$cpv" "$taint")${or:+${FC}||${NO} }$(format_depatom "$tok")$(pads 40 "$indent$taint$or$tok") $dcpv"
		taint=""; or="";;
	esac; done
}

# info_action_depstrings: --depstrings: print_depstring for RDEPEND/PDEPEND/IDEPEND; DEPEND+BDEPEND added when $opt_arg_build_time.
function info_action_depstrings() {
	set_xterm_title "Displaying raw dependencies of $1"
	local cpv="$1"
	if [[ "$opt_arg_build_time" ]]; then
		print_depstring DEPEND $cpv
		print_depstring BDEPEND $cpv
	fi
	print_depstring RDEPEND $cpv
	print_depstring PDEPEND $cpv
	print_depstring IDEPEND $cpv
	echo
}

# info_action_depends: --depends: resdepend + format each atom with taint padding and resolved cpv; --unique-depends filters.
function info_action_depends() {
	set_xterm_title "Displaying dependencies of $1"
	local cpv="$1" excl="" x
	for x in "${@:2}"; do 
		expand_arg "${x#=}"; excl="$excl ${RESULT[*]}"
	done
	resdepend $cpv \
	| while read depatom taint; do
		[[ "$depatom" ]] || continue
		taint="${taint:+$taint }"
		if [[ "${depatom:0:1}" == "!" ]]; then
			[[ "$opt_arg_unique_depends" ]] && continue
			f_cpv=""
		else
			tcpv="$(resolve_depatom "$depatom")" \
			&& f_cpv="$(format_cpv $tcpv)" || f_cpv="${RD}!!!${NO}"
			if [[ "$opt_arg_unique_depends" ]]; then
				has_revdepend $tcpv "" "$excl" && continue
			fi
		fi
		if [[ "$opt_arg_for_emerge" ]]; then
			[[ "$tcpv" ]] && format_atom_for_emerge "$tcpv"
		else
			echo "    $(format_taint "$cpv" "$taint")$(pads 16 "$taint")$(format_depatom "$depatom")$(pads 24 "${taint:16}${depatom}") $f_cpv"
		fi
	done
	echo
}

# info_action_exists: --exists: report which resolved deps of $1 are themselves satisfied by any of the trailing args.
function info_action_exists() {
	local cpv="$1"
	resdepend "$cpv" \
	| ( local any=""
	while read depatom taint; do
		[[ "$depatom" ]] || continue
		[[ "$depatom" == !* ]] && continue
		tcpv="$(resolve_depatom "$depatom")"
		for x in "${@:3}"; do
			[[ "$x" == */* ]] || x="$(pv_to_cpv $x)"
			if dep_satisfies_atom "$tcpv" "$x"; then
				echo "    $(format_taint "$cpv" "$taint")$(pads 16 "$taint")$(format_depatom "$depatom")$(pads 24 "${taint:16}${depatom}") $(format_cpv "$tcpv")"
				any=yes
			fi
		done
	done; [[ "$any" ]]; )
}

# info_action_rev-exists: --rev-exists: report which reverse deps of $1 are pulled in by any of the trailing args.
function info_action_rev-exists() {
	_smartdep "$1" \
	| ( local any=""
	while read pkg atom taint; do
		for x in "${@:3}"; do
			[[ "$x" == */* ]] || x="$(pv_to_cpv $x)"
			if dep_satisfies_atom "$pkg" "$x"; then
				format_revdep <<<"$pkg $atom $taint"
				any=yes
			fi
		done
	done; [[ "$any" ]]; )
}

# redundant_of_all_cp_mlsrs: for cp $1 and each mlsr in $2+: echo redundant cpv (no revdep), also write 'cp mlsr' to stderr.
function redundant_of_all_cp_mlsrs() {
	cp=$1; shift; mlsrs="$*"
	for mlsr in $mlsrs; do
		has_revdepend $cp-$mlsr "" "yes" "" "yes" && continue
		echo $cp-$mlsr
		echo $cp $mlsr >&2
	done
}

# redundant: drive depclean/purge selection: list redundant cpvs across all installed cps (or filtered by $@).
function redundant() {
	if [[ -z "$*" ]]; then
		all_installed_cp_mlsrs
	else
		for cp in "$@"; do
			[[ "$cp" == */* ]] && echo $cp || pv_to_cpv $cp
		done | while read cp; do
			echo $cp $(installed_mlsrs $cp)
		done
	fi | while read cp mlsr more_mlsrs; do
		[[ "$do_arg_action" == "purge" ]] && [[ -z "$more_mlsrs" ]] && continue
		redundant_of_all_cp_mlsrs $cp $mlsr $more_mlsrs
	done
}

# ============================================================================
# === INFO ACTIONS — METADATA / USE / IUSE / KEYWORDS / VERSIONS
# === info_action_changelog, use_desc, info_action_usedesc, info_action_iuse,
# === eval_ru_list, eval_ru_expr, info_action_required-use, metadata_extract,
# === info_action_info, sort_trees, mlsr_trees_sorted, info_action_keywords,
# === info_action_versions.
# ============================================================================

# info_action_changelog: --changelog: print the relevant ChangeLog entries (filtered by version cutoff or N entries) with colour.
function info_action_changelog() {
	local cpv="$1"
	local tree cp="${cpv%-$VER_SHPAT}"
	tree="$(best_tree $cpv)"
	local pn=${cp#*/} ver="${cpv#$cp-}" ready="" entries=0
	# Modern Portage trees no longer ship per-package ChangeLog files (the
	# history lives in git instead), so the redirect below would otherwise
	# leak a raw bash "No such file or directory" for every package.
	if [[ ! -f "$tree/$cp/ChangeLog" ]]; then
		echo "${RD}!!!${NO} No ChangeLog available for ${BR}$cp${NO}"
		return
	fi
	echo "From ${BR}$tree/$cp/ChangeLog${NO}:"
	while read; do
		[[ "$REPLY" == \#* ]] && continue
		if [[ "$REPLY" == \*$pn-$VER_SHPAT* ]]; then
			line=${REPLY##\*$pn-$VER_SHPAT}; sp=${REPLY%$line}
			linever=${sp#\*$pn-}
			if [[ "$changelog_entries" ]]; then
				(( ++entries > changelog_entries )) && break
			elif vercmp $linever "<" $ver; then
				[[ "$ready" ]] && break
			else
				ready=yes
				while [[ "$REPLY" == \** ]]; do
					echo "$REPLY"; read
				done
			fi
		fi
		echo "$REPLY"
	done <$tree/$cp/ChangeLog | sed -e '
s|^\(\*.* \)\((.*)\)$|'"$Fc"'\1'"$NO$Rd"'\2'"$NO"'|;t
s|^  \([.-]*[0-9]\+ ... [0-9]\{4\}; \(.* \)\?\)\(<.*>\)|  '"$Rd"'\1'"$NO$Fc"'\3'"$NO"'|
T;:a;/:/bb;/\n$/bb;N;ba;:b;
s| \(-[[:graph:]]\+\)\([,:]\)| '"$Gr"'\1'"$NO"'\2|g
s| \(+[[:graph:]]\+\)\([,:]\)| '"$Bl"'\1'"$NO"'\2|g
s| \([[:graph:]]\+\)\([,:]\)| '"$Cy"'\1'"$NO"'\2|g
'
}

# use_desc: echo package-local description for USE flag $1 in cpv $2 (use.local.desc with use.desc fallback).
function use_desc() {
	local flag="$1" cpv="$2"
	sed -e 's!^\('${cpv%-$VER_SHPAT}':\)\?'$flag' - !!;t;d' \
		$(profile_files_extra use.desc) \
		$(profile_files_extra use.local.desc) \
	| sort -u \
	| while read; do echo "${REPLY//!!/${RD}!!${NO}}"; false; done \
	&& echo "${RD}!!!${NO} No description available"
}

# info_action_usedesc: --usedesc: per-flag for IUSE of cpv $1, mark +/-/(masked)/changed-from-original and print description.
function info_action_usedesc() {
	set_xterm_title "Displaying USE flags for $1"
	local cpv="$1"
	local alluse my_use ouse=""
	alluse="$(dbuse)"
	my_use=$(dbuse "$cpv")
	[[ -d ${VARDB_DIR}/$cpv ]] && ouse=$(<${VARDB_DIR}/$cpv/USE) || unset ouse
	pusemask=$(package_use_mask "$cpv")
	for x in $(extract_var IUSE $cpv | strip_iuse_prefixes | sed 's/[[:space:]]/\n/g' | sort -u)
	do
		if has $x $pusemask; then
			echo -n "($x)$(pads 10 $x): "; use_desc $x $cpv
		else
			if has $x $my_use; then
				sym="+"
				if [[ "${ouse+set}" ]] && ! has $x ${ouse}; then
				col=GR; dsym="*"; else col=RD; dsym=""; fi
				has $x $alluse && psym="" || psym="^"
			else
				sym="-"
				if [[ "${ouse+set}" ]] && has $x ${ouse}; then
				col=GR; dsym="*"; else col=BL; dsym=""; fi
				! has $x $alluse && psym="" || psym="^"
			fi
			echo -n "${!col}$sym$x$NO$dsym$psym$(pads 12 $sym$x$dsym$psym): "; use_desc $x $cpv
		fi | fmt_w $COLUMNS 0 14
	done
}

# info_action_iuse: --iuse: list installed/available cpvs whose IUSE contains flag $1; verbose mode appends descriptions.
function info_action_iuse() {
	set_xterm_title "Listing packages with $1 in IUSE"
	db_grep "\\<$1\\>" "yes" IUSE \
	| while read x tree; do
		has $1 $(extract_var IUSE $x $tree | strip_iuse_prefixes) || continue
		echo -n $'\t'"$(format_cpv "$x")"
		(( opt_arg_verbose > 0 )) && echo ": $(use_desc $1 $x)" || echo
	done
}

# REQUIRED_USE evaluator (per PMS — || ^^ added in EAPI 4, ?? in EAPI 5).
#
# Grammar (whitespace-separated tokens):
#   expr  := flag                    # flag must be set
#         := !flag                   # flag must not be set
#         := flag? ( exprs )         # if flag set, all exprs must hold
#         := !flag? ( exprs )        # if flag not set, all exprs must hold
#         := || ( exprs )            # at-least-one
#         := ^^ ( exprs )            # exactly-one
#         := ?? ( exprs )            # at-most-one
#         := ( exprs )               # group; all hold
#   exprs := expr*
# Top-level is implicit AND.
#
# The evaluator is intentionally separate from crunch_depends — REQUIRED_USE
# has its own grammar (no atoms, but adds ^^ and ??), and the dep parser is
# the most fragile part of the script. Sharing it would couple two distinct
# concerns.
#
# Inputs (set by caller before invoking eval_ru_list):
#   RU_TOKS   — tokenized REQUIRED_USE string (array)
#   RU_ACTIVE — active USE flags (space-separated string, suitable for `has`)
#   ru_idx    — current token index (init 0)
#   RU_FAIL   — accumulator for failing-clause descriptions (init empty)
# eval_ru_list returns 0 if all top-level exprs hold, 1 otherwise; RU_FAIL
# holds one entry per top-level violation. Inside ||/^^/?? groups, child
# failures don't propagate — only the group's own truth value matters.
function eval_ru_list() {
	local result=0
	while ((ru_idx < ${#RU_TOKS[@]})); do
		[[ "${RU_TOKS[ru_idx]}" == ")" ]] && break
		eval_ru_expr || result=1
	done
	return $result
}

# eval_ru_expr: evaluate one REQUIRED_USE expression from RU_TOKS at ru_idx; appends failing clause to RU_FAIL.
function eval_ru_expr() {
	local tok="${RU_TOKS[ru_idx]}"
	case "$tok" in
		"||"|"^^"|"??")
			local head="$tok" span_start=$ru_idx hits=0 saved=${#RU_FAIL[@]}
			((ru_idx++))
			[[ "${RU_TOKS[ru_idx]}" == "(" ]] || {
				format_error <<<"REQUIRED_USE: '$head' not followed by '('" >&2
				return 1
			}
			((ru_idx++))
			while ((ru_idx < ${#RU_TOKS[@]})); do
				[[ "${RU_TOKS[ru_idx]}" == ")" ]] && break
				eval_ru_expr && ((hits++))
			done
			((ru_idx++))
			# Drop child failures; only the group's own truth matters.
			RU_FAIL=("${RU_FAIL[@]:0:saved}")
			case "$head" in
				"||") (( hits >= 1 )) && return 0 ;;
				"^^") (( hits == 1 )) && return 0 ;;
				"??") (( hits <= 1 )) && return 0 ;;
			esac
			RU_FAIL+=("${RU_TOKS[*]:span_start:ru_idx-span_start}")
			return 1
			;;
		"(")
			((ru_idx++))
			eval_ru_list; local r=$?
			((ru_idx++))
			return $r
			;;
		*"?")
			local cond="${tok%\?}" negated=
			[[ "$cond" == "!"* ]] && { negated=1; cond="${cond#!}"; }
			((ru_idx++))
			[[ "${RU_TOKS[ru_idx]}" == "(" ]] || {
				format_error <<<"REQUIRED_USE: '$tok' not followed by '('" >&2
				return 1
			}
			local active=0 should_check=
			has "$cond" $RU_ACTIVE && active=1
			if [[ "$negated" ]]; then
				((active == 0)) && should_check=1
			else
				((active == 1)) && should_check=1
			fi
			if [[ "$should_check" ]]; then
				eval_ru_expr
				return $?
			fi
			# Skip the ( ... ) block without evaluating it.
			local depth=0
			while ((ru_idx < ${#RU_TOKS[@]})); do
				case "${RU_TOKS[ru_idx]}" in
					"(") ((depth++)) ;;
					")") ((depth--)); ((depth == 0)) && { ((ru_idx++)); break; } ;;
				esac
				((ru_idx++))
			done
			return 0
			;;
		"!"*)
			local flag="${tok#!}"
			((ru_idx++))
			has "$flag" $RU_ACTIVE && { RU_FAIL+=("$tok"); return 1; }
			return 0
			;;
		*)
			((ru_idx++))
			has "$tok" $RU_ACTIVE && return 0
			RU_FAIL+=("$tok")
			return 1
			;;
	esac
}

# info_action_required-use: --required-use: parse and eval REQUIRED_USE of cpv $1 against active USE, report violations, bump counter.
function info_action_required-use() {
	local cpv="$1"
	set_xterm_title "Checking REQUIRED_USE for $cpv"
	local ru
	ru="$(extract_var REQUIRED_USE $cpv 2>/dev/null)"
	if [[ -z "${ru// /}" ]]; then
		(( opt_arg_verbose > 0 )) \
			&& echo "$(format_cpv "$cpv") ${GR}OK${NO} (no REQUIRED_USE)"
		return 0
	fi
	local RU_TOKS=($ru) RU_ACTIVE
	RU_ACTIVE="$(dbuse "$cpv")"
	local -i ru_idx=0
	local RU_FAIL=()
	eval_ru_list
	if ((${#RU_FAIL[@]} == 0)); then
		(( opt_arg_verbose > 0 )) \
			&& echo "$(format_cpv "$cpv") ${GR}OK${NO}"
		return 0
	fi
	echo -n "$(format_cpv "$cpv") ${RD}FAIL${NO}: "
	local first=1 f
	for f in "${RU_FAIL[@]}"; do
		((first)) || echo -n "; "
		echo -n "$f"
		first=0
	done
	echo
	required_use_violations=$((${required_use_violations:-0}+1))
	return 1
}

# Consider doing this in xslt - too expensive?
function metadata_extract() {
	local tree="$1" cp="$2" tag="$3"
	[[ -e $tree/$cp/metadata.xml ]] || return
	sed -n -e "s!^\\s*<$tag>\\(.*\\)</$tag>\$!$Fc$(pad 12 $tag)$NO: \\1!;T;p" \
		$tree/$cp/metadata.xml
}

# info_action_info: --info: print metadata block for cpv $1 (URLs, DESCRIPTION, RESTRICT, license, INHERITED, ebuild path, herd/email, patches, logs).
function info_action_info() {
	set_xterm_title "Displaying information for $1"
	local cpv="$1"; local cp=${cpv%-$VER_SHPAT} pv=${cpv#*/}
	for x in SRC_URI RESTRICT HOMEPAGE LICENSE DESCRIPTION INHERITED; do
		(echo -n "$Bl$(pad 12 $x)$NO: "; extract_var $x $cpv) \
		| fmt_w $COLUMNS 0 14
	done
	local tree; tree="$(best_tree $cpv)"
	echo "$Fc$(pad 12 ebuild)$NO: $tree/$cp/$pv.ebuild" | fmt_w $COLUMNS 0 14
	metadata_extract $tree $cp herd
	metadata_extract $tree $cp email
	local cat=${cp%/*} pn=${cp#*/} p=${pv%-r+([0-9])}
	local pr=${pv#$p-}; [[ "$pr" == "$pv" ]] && pr="r0"
	local slot; slot="$(slot_for "$cpv")"
	local patches=()
	for d in $ETC_PORTAGE_DIR/patches/$cat/$pn*; do
		dn="${d##*/}"
		# Last clause uses unquoted RHS deliberately: $dn may be a
		# patch-dir name with version wildcards (e.g. 'foo-1.2*'),
		# and the intent is glob match.
		# shellcheck disable=SC2053
		[[ "$dn" == "$pn" || "$dn" == "$p" || "$dn" == "$p-$pr" \
			|| "$dn" == "${pn}[$slot]" || "${pv#$pn-}" == ${dn#$pn-} ]] \
			|| continue
		for x in "$d"/*; do [[ -f "$x" ]] && patches[${#patches[@]}]="$x"; done
	done
	if ((${#patches[@]})); then
		echo -n "$Rd$(pad 12 patches)$NO: "
		for x in "${patches[@]}"; do echo "$x"; done
	fi | fmt_w $COLUMNS 0 14
	if [[ -d ${VARDB_DIR}/$cpv ]]; then
		local counter; counter=$(extract_var_from_vardb COUNTER $cpv)
		local logs=()
		for ((i=counter-1;i<=counter+1;++i)); do
			x=${PORTAGE_LOG_DIR}/$i-$pv.log
			[[ -f "$x" ]] && logs[${#logs[@]}]="$x"
		done
		if ((${#logs[@]})); then
			echo -n "$Rd$(pad 12 logs)$NO: "
			for x in "${logs[@]}"; do echo "$x"; done
		fi | fmt_w $COLUMNS 0 14
	fi
}

# sort_trees: echo input trees ordered: unknown first, then portage_trees ascending priority, INJECTED last.
function sort_trees() {
	# sort: other <= portage <= overlay <= INJECTED (last best)
	local -a t=("$@") pt=(); local x i
	for x in INJECTED $portage_trees; do
		for ((i=0;i<$#;++i)); do
			[[ "${x%/}" == "${t[$i]%/}" ]] || continue
			pt[${#pt[@]}]="${t[$i]}"; t[$i]=""
		done
	done
	for x in "${t[@]}"; do
		[[ "$x" ]] && echo "$x"
	done
	for ((i=${#pt[@]}-1;i>=0;--i)); do
		echo "${pt[$i]}"
	done
}

# mlsr_trees_sorted: emit 'mlsr tree' pairs for cp $1 (available + installed + injected), sorted by mlsr then sort_trees.
function mlsr_trees_sorted() {
	local cp="$1"
	( 
		avail_versions "$cp" yes yes
		for inst in ${VARDB_DIR}/$cp-$VER_SHPAT; do
			[[ -d "$inst" ]] || continue
			cpv=${inst#${VARDB_DIR}/}
			ebuild=$(extract_var_from_vardb EBUILD $cpv)
			echo "${cpv#$cp-} ${ebuild%/$cp/${cpv#*/}.ebuild}"
		done
		for mlsr in $(injected_mlsrs "$cp"); do echo "${mlsr} INJECTED"; done
	) \
	| mlsr_sort \
	| ( 
		mlsr=""; trees=()
		while read new_mlsr tree; do
			if [[ "$new_mlsr" == "$mlsr" ]]; then
				has "$tree" "${trees[@]}" || trees[${#trees[@]}]="$tree"
			else
				[[ "$mlsr" ]] && \
					for x in $(sort_trees "${trees[@]}"); do
						echo "$mlsr $x"
					done
				mlsr="$new_mlsr"; trees=(); trees[0]="$tree"
			fi
		done
		[[ "$mlsr" ]] && for x in $(sort_trees "${trees[@]}"); do
			echo "$mlsr $x"
		done
	)
}

# info_action_keywords: --keywords: render the eshowkw-style cross-arch keyword table for cp $1 (one row per mlsr).
function info_action_keywords() {
# thanks ciaranm for eshowkw
	set_xterm_title "Displaying cross-arch keywords for $1"
	local cp="$1"; local pn=${cp#*/}

	local mlsrs trees lmlsr=0 mlsr tree
	mlsrs=(); trees=()
	while read mlsr tree; do
		mlsrs[${#mlsrs[@]}]="$mlsr"; trees[${#trees[@]}]="$tree"
		(( ${#mlsr} > lmlsr )) && lmlsr=${#mlsr}
	done <<<"$(mlsr_trees_sorted "$cp")"
	local installed; installed="$(installed_mlsrs "$cp")"
		
	local archs larch=0 arch
	mapfile -t archs < "$PORTDIR/profiles/arch.list"
	for arch in "${archs[@]}"; do 
		(( ${#arch} > larch )) && larch=${#arch}
	done

	local i
	for ((i=larch;i>0;--i)); do
		echo -n "${spaces:0:$lmlsr} |"
		for arch in "${archs[@]}"; do
			[[ "$arch" == "$ARCH" ]] && echo -n "$BR"
			((i > ${#arch})) && echo -n "  " \
				|| echo -n " ${arch:$((${#arch}-i)):1}"
			[[ "$arch" == "$ARCH" ]] && echo -n "$NO"
		done
		echo
	done
	
	for ((i=0;i<=lmlsr;++i)); do echo -n "-"; done
	echo -n "+"
	for arch in "${archs[@]}"; do
		[[ "$arch" == "$ARCH" ]] && echo -n "-v" || echo -n "--"
	done
	echo

	for ((i=0;i<${#mlsrs[@]};++i)); do
		mlsr=${mlsrs[$i]}; tree=${trees[$i]}
		cpv=$cp-$mlsr; ebuild=$tree/$cp/$pn-$mlsr.ebuild
		[[ "$tree" == "INJECTED" ]] && inj="yes" || inj=""
		if is_package_masked "$cp" "$mlsr" "$tree"; then col="$RD"; sym="x"
		elif has $mlsr $installed && [[ ! -e $ebuild || $ebuild == $(extract_var_from_vardb EBUILD $cpv) ]]; then col="$BR"; sym=">"
		elif [[ "$inj" ]]; then col="$Cy"; sym="J"
		else col=""; sym="|"; fi
		echo -n "$col$(pad $lmlsr $mlsr)${col:+$NO} $sym"
		local keyword keywords=()
		[[ "$inj" ]] || keywords_for $cpv "$tree" keywords
		for arch in "${archs[@]}"; do
			local sym=" "
			has '-*' "${keywords[@]}" && sym="$RD*$NO"
			has "-$arch" "${keywords[@]}" && sym="$Yl-$NO"
			has "~$arch" "${keywords[@]}" && sym="$YL~$NO"
			has "$arch" "${keywords[@]}" && sym="$GR+$NO"
			echo -n " $sym"
		done
		local slot
		[[ "$inj" ]] || slot=$(slot_for $cpv $tree)
		[[ "$slot" && "$slot" != 0 ]] && echo -n " [$slot]"
		[[ "$tree" == "$PORTDIR" ]] && echo || echo " $tree"
	done
}

# info_action_versions: --versions: per available/installed mlsr of cp $1, print [MKI keyword] line with mask comment.
function info_action_versions() {
	set_xterm_title "Displaying versions of $1"
	local cp="$1"; local pn=${cp#*/}
	local installed; installed="$(installed_mlsrs "$cp")"
	local tree mlsr
	mlsr_trees_sorted "$cp" | while read mlsr tree; do
		cpv=$cp-$mlsr; ebuild=$tree/$cp/$pn-$mlsr.ebuild
		[[ "$tree" == "INJECTED" ]] && inj="yes" || inj=""
		[[ "$inj" ]] && S=" " || S="$(keyword_sym $cp $mlsr $tree)"
		mask_comment=""
		if [[ "$S" == "~" ]]; then COL="$YL"; S="$YL$S$NO"
		elif [[ "$S" == "-" ]]; then COL="$Yl"; S="$Yl$S$NO"
		else COL="$GR"; fi
		I=" "; M=" "
		if is_package_masked "$cp" "$mlsr" "$tree"; then
			M="${RD}M$NO"; COL="$RD"
			mask_comment="$(get_mask_comment "$cp" "$mlsr" "$tree")"
		elif [[ -z "$inj" ]] && is_keyword_masked $cp $mlsr $tree; then 
			M="${RD}K$NO"; COL="$RD"
			keywords_for $cpv "$tree"
			mask_comment="${RD}keywords: ${RESULT[*]}${NO}"
		elif is_package_unmasked "$cp" "$mlsr" "$tree"; then
			M="${Rd}U$NO"
		fi
		if has "$mlsr" $installed && [[ ! -e $ebuild \
			|| $ebuild == $(extract_var_from_vardb EBUILD $cpv) ]]; then
			I="${CY}I$NO"; COL="$CY"
		elif [[ "$inj" ]]; then
			I="${Cy}J$NO"; COL="$Cy"
		fi
		if [[ "$inj" ]]; then
			P="$(pads 12 "$mlsr")"
			slot=""
		else
			slot="$(slot_for $cpv $tree)"
			P="$(pads 12 "$mlsr$slot")"
			slot="($COL$slot$NO)"
		fi
		[[ -f $ebuild ]] || tree="($RD$tree$NO)"
		[[ "$tree" == "$PORTDIR" ]] && tree=""
		echo $'\t'"[$M$S$I] $COL$mlsr$NO $slot$P $tree"
		[[ "$mask_comment" ]] && echo "$mask_comment"
	done
}

# ============================================================================
# === INFO ACTIONS — SIZE / CONTENTS / OWNERS / SEARCH
# === format_bytes, info_action_size, pkgsize_arg, pkgsize_summary,
# === formatcontentsentry, info_action_contents, canonicalize_path,
# === info_action_owners, info_action_owners_match, info_action_category,
# === info_action_catpackages, info_action_virtuals, info_action_provides,
# === star_arg, info_action_search.
# ============================================================================

# format_bytes: echo $1 as human-readable size (bytes/KiB/MiB/.../PiB) with 0..2 fractional digits.
function format_bytes() {
	bytes=$1
	units=( bytes KiB MiB GiB TiB PiB )
	if (( bytes < 1024 )); then
		(( bytes == 1 )) && echo "1 byte" || echo "$bytes ${units[0]}"
		return
	fi
	for ((i=1; i<=5; ++i)); do
		(( bytes >= 1024 ** (i + 1) )) && continue
		(( ii = 1024 ** i, i2 = 512 * 1024 ** (i - 1) ))
		if (( bytes / 100 >= ii )); then
			(( int = (bytes + i2) / ii ))
			echo "$int ${units[i]}"
		elif (( bytes / 10 >= ii )); then
			(( int = bytes / ii ))
			(( fr = ((bytes - int * ii) * 10 + i2) / ii ))
			echo "$int.$fr ${units[i]}"
		else
			(( int = bytes / ii ))
			(( fr = ((bytes - int * ii) * 100 + i2) / ii ))
			[[ ${#fr} == 1 ]] && fr=0$fr
			echo "$int.$fr ${units[i]}"
		fi
		break
	done
}

pkgsize_tpkgs=0
pkgsize_tfiles=0
pkgsize_tinacc=0
pkgsize_tbytes=0
# info_action_size: --size: count CONTENTS files of cpv $1, sum sizes, accumulate into pkgsize_t* totals.
function info_action_size() {
	cpv="$1"
	set_xterm_title "Calculating disk usage of $cpv..."
	local files=0 bytes=0 inacc=0 file entry
	while IFS= read -r entry || [[ "$entry" ]]; do
		case "$entry" in
			obj\ *)
				[[ "$entry" =~ ^obj\ (.*)\ [[:xdigit:]]+\ [[:digit:]]+$ ]] || continue
				file=${BASH_REMATCH[1]};;
			sym\ *)
				[[ "$entry" =~ ^sym\ (.*)\ -\>\ .*\ [[:digit:]]+$ ]] || continue
				file=${BASH_REMATCH[1]};;
			dir\ *) file=${entry#dir };;
			*) continue;;
		esac
		(( ++files ))
		[[ -r "$file" ]] && (( bytes += $(stat -c%s -- "$file") )) \
			|| (( ++inacc ))
	done <"${VARDB_DIR}/$cpv/CONTENTS"
	(( inacc > 0 )) \
		&& finacc=" (${BR}$inacc${NO} inaccessible)" || finacc=""
	echo "${BR}$files${NO} files$finacc: ${BR}$(format_bytes $bytes)${NO}"
	(( ++pkgsize_tpkgs, pkgsize_tfiles += files ))
	(( pkgsize_tinacc += inacc, pkgsize_tbytes += bytes ))	
}

# pkgsize_arg: print a 'Size of CPV:' header and call info_action_size $1.
function pkgsize_arg() {
	set_xterm_title "Calculating size of $1"
	echo "Size of $(format_cpv $1):"
	info_action_size $1
}

# pkgsize_summary: if more than one package was sized, print the total files+inaccessible+bytes summary.
function pkgsize_summary() {
	(( pkgsize_tpkgs <= 1 )) && return
	echo
	(( pkgsize_tinacc > 0 )) \
		&& finacc=" ($BR$pkgsize_tinacc$NO inaccessible)" || finacc=""
	bytes="$(format_bytes $pkgsize_tbytes)"
	echo "Total: $BR$pkgsize_tfiles$NO files$finacc: $BR$bytes$NO"
}

# formatcontentsentry: sed-colour CONTENTS lines: obj -> path, sym -> CY src -> tgt, dir -> bold path.
function formatcontentsentry() {
	sed -e "s:^obj \(.*\) [[:xdigit:]]\+ [[:digit:]]\+$:\1:;
		s:^sym \(.*\) -> \(.\+\) [[:digit:]]\+$:$CY\1$NO -> \2:;
		s:^dir \(.*\)$:$BR\1$NO:"
}

# info_action_contents: --contents: grep -v debug entries from $1's CONTENTS, pipe through formatcontentsentry.
function info_action_contents() {
	set_xterm_title "Displaying contents of $1"
	grep -v '^\(obj\|sym\|dir\) /usr/src/debug\(/\|$\)' \
		${VARDB_DIR}/$1/CONTENTS | formatcontentsentry
}

# Canonicalize a path by removing //, . and .. segments; but don't resolve 
# symlinks.
# TODO this may be broken, prove it. (find a path canonicalization algorithm?)
function canonicalize_path() {
	path="$1"
	[[ "$path" == .?(.)/* ]] && path="$PWD/$path"
	path="${path//\/+(\/)//}"
	path="${path//\/+(.\/)//}"
	path="${path%/.}"
	while [[ "$path" == */../* ]]; do
		path="${path/\/+([^\/])\/..\///}"
		if [[ "$path" == /..?(/*) ]]; then
			echo "$path"
			echo "Invalid path: $path" | format_error >&2
			return 1
		fi
	done
	path="${path%/+([^/])/..}"
	echo "${path:-/}"
}

# info_action_owners: --owners: canonicalise path $1 and look up its owner; falls back to usr-merge twins and realpath.
function info_action_owners() {
	path="$(canonicalize_path "$1")"
	local result
	result="$(info_action_owners_match "$path")"
	# /usr-merge: CONTENTS may record /bin/bash while the caller queries
	# /usr/bin/bash (or vice versa) — those are hardlinks on a merged-/usr
	# system, so realpath can't follow them. Fall back to the other side
	# of the well-known usrmerge pairs. Also try the realpath in case the
	# path was a symlink (the non-merged case).
	if [[ -z "$result" && "$path" == /* ]]; then
		local alt=""
		case "$path" in
		/usr/bin/*)	alt="/bin/${path#/usr/bin/}";;
		/usr/sbin/*)	alt="/sbin/${path#/usr/sbin/}";;
		/usr/lib/*)	alt="/lib/${path#/usr/lib/}";;
		/usr/lib64/*)	alt="/lib64/${path#/usr/lib64/}";;
		/bin/*)		alt="/usr/bin/${path#/bin/}";;
		/sbin/*)	alt="/usr/sbin/${path#/sbin/}";;
		/lib/*)		alt="/usr/lib/${path#/lib/}";;
		/lib64/*)	alt="/usr/lib64/${path#/lib64/}";;
		esac
		[[ "$alt" ]] && result="$(info_action_owners_match "$alt")"
		if [[ -z "$result" ]]; then
			local realpath_target
			realpath_target="$(readlink -f "$path" 2>/dev/null)"
			[[ "$realpath_target" && "$realpath_target" != "$path" \
				&& "$realpath_target" != "$alt" ]] \
				&& result="$(info_action_owners_match "$realpath_target")"
		fi
	fi
	[[ "$result" ]] && printf '%s\n' "$result"
}

# info_action_owners_match: grep all CONTENTS for path $1; emit owning cpvs (with file detail when $1 is not an absolute path).
function info_action_owners_match() {
	local path="$1"
	# Escape characters with meaning in basic regex so a path containing
	# e.g. '[' or '*' doesn't turn into an unintended pattern. '/' is not
	# special in BRE — leave it alone (escaping it produces grep warnings).
	local rx; rx="$(printf '%s' "${path%/}" | sed 's/[][\\.*^$]/\\&/g')"
	set_xterm_title "Finding owners of $path..."
	if [[ "$path" == /* ]]; then
		grep -lx "obj ${rx} [[:xdigit:]]\+ [[:digit:]]\+\
\|sym ${rx} -> .\+ [[:digit:]]\+\
\|dir ${rx}" ${VARDB_DIR}/*/*/CONTENTS | while read x ; do
			x=${x#${VARDB_DIR}/}; x=${x%/CONTENTS}
			if [[ "$opt_arg_for_emerge" ]]; then
				format_atom_for_emerge "$x"
			else
				echo -n "    "; format_cpv $x
			fi
		done
	else
		grep -x "obj .*/${rx} [[:xdigit:]]\+ [[:digit:]]\+\
\|sym .*/${rx} -> .\+ [[:digit:]]\+\
\|dir .*/${rx}" ${VARDB_DIR}/*/*/CONTENTS \
		| sed "s!${VARDB_DIR}/\\([^/]\\+/[^/]\\+\\)/CONTENTS:!\\1 !" \
		| ( oldx=""
		while read x rest; do
			if [[ "$opt_arg_for_emerge" ]]; then
				# Same cpv may match multiple files; emit each
				# atom once. grep walks ${VARDB_DIR}/*/*/CONTENTS
				# in glob-sorted (cat/pkg) order, so dedup against
				# the immediate prior cpv is sufficient.
				[[ "$oldx" == "$x" ]] || format_atom_for_emerge "$x"
			else
				[[ "$oldx" == "$x" ]] || echo "$(format_cpv $x):"
				echo -n "    "; formatcontentsentry <<<"$rest"
			fi
			oldx="$x"
		done
		)
	fi
}

# info_action_category: --category: echo coloured category prefix of cpv/atom $1.
function info_action_category() {
	echo "    ${CY}${1%/*}${NO}"
}

# info_action_catpackages: --catpackages: list packages in category $1 (installed; +tree packages if --uninstalled).
function info_action_catpackages() {
	if ! has $1 $categories; then
		echo "not a recognised category: $1" | format_error >&2
		return 1
	fi
	(
		find ${VARDB_DIR}/$1 -mindepth 1 -maxdepth 1 -type d \
		| while read x; do
			x=${x##*/}
			echo ${x%-$VER_SHPAT}
		done
		if [[ "$opt_arg_uninstalled" ]]; then
			for x in $portage_trees; do
				find $x/$1 -mindepth 1 -maxdepth 1 -type d -not -name '.*' 2>/dev/null\
				| while read y; do echo ${y##*/}; done
			done
		fi
	) | sort -u | while read x; do echo -n "    "; format_cpv $1/$x; done
}

# List packages providing the specified virtual. With the modern virtual/*
# model, providers are bare cps named in the virtual's RDEPEND/DEPEND, so
# there are no per-provider version operators to honour — we just print the
# provider name and its installed/available mlsrs. Default mode shows
# installed-only mlsrs; --uninstalled also folds in available versions.
function info_action_virtuals() {
	set_xterm_title "Displaying packages providing $1"
	local cpv="$1" cp="${1%-$VER_SHPAT}" virtual providers provider mlsrs mlsr
	allvirtuals | while read virtual providers; do
		[[ "$virtual" == "$cp" ]] || continue
		for provider in $providers; do
			if [[ "$opt_arg_uninstalled" ]]; then
				mlsrs="$( ( provided_mlsrs "$provider"
				            avail_versions "$provider" "" "" yes yes
				          ) | sort -u | mlsr_sort)"
			else
				mlsrs="$(provided_mlsrs "$provider" | sort -u | mlsr_sort)"
			fi
			if [[ "$mlsrs" ]]; then
				echo -n $'\t'"${BR}$(pad 35 $provider)${NO}"
				for mlsr in $mlsrs; do echo -n " $mlsr"; done
			else
				echo -n $'\t'"$(pad 35 $provider)"
			fi
			echo
		done
		break
	done
}

# info_action_provides: --provides: list virtuals that cp $1 provides, each resolved to a concrete cpv (or '!!!').
function info_action_provides() {
	set_xterm_title "Displaying virtuals provided by $1"
	local cpv=$1 cp=${1%-$VER_SHPAT} virtual fcpv vcpv
	for virtual in $(virtuals_from "$cp"); do
		vcpv="$(resolve_depatom "$virtual")" \
			&& fcpv="$(format_cpv $vcpv)" \
			|| fcpv="${RD}!!!${NO}"
		echo -n $'\t'"$(pad 24 $virtual)"
		echo "$fcpv"
	done
}

# star_arg: expand a partial pkg arg into RESULT[] of matching cpvs; with $2 keeps only highest, $3 limits to installed.
function star_arg() {
	target=${1%-}; highest_only=$2; installed_only=$3
	category=${target%/*}
	ptarget=${target#*/}
	package=${ptarget%-$VER_SHPAT}
	vtarget=${ptarget/#$package?(-)}
	cp=$category/$package
	RESULT=()
	while read mlsr; do 
		[[ "$mlsr" ]] && RESULT[${#RESULT[@]}]="$cp-$mlsr"
	done <<<"$(
		(
			[[ "$installed_only" ]] \
				|| avail_versions $cp "" "" yes yes
			provided_mlsrs $cp
		) | sort -u | grep ^$vtarget | mlsr_sort \
		| if [[ "$highest_only" ]]; then tail -n 1; else cat; fi)"
	[[ "$installed_only" ]] && return
	(( ${#RESULT[@]} > 0 )) && [[ "$highest_only" ]] && return
	while read mlsr; do
		[[ "$mlsr" ]] && RESULT[${#RESULT[@]}]="$cp-$mlsr"
	done <<<"$(
		avail_versions $cp "" "" | sort -u | grep ^$vtarget \
		| mlsr_sort \
		| if [[ "$highest_only" ]]; then tail -n 1; else cat; fi)"
}

# info_action_search: --search: glob installed (+available with --uninstalled) cpvs for substring of $1, print sorted unique.
function info_action_search() {
	trap return SIGPIPE
	(
		if [[ "$1" == */* ]]; then
			cpart="${1%/*}"; ppart="${1#*/}"
		else
			cpart="*"; ppart="$1"
		fi
		if [[ "$1" != *[*?]* ]]; then
			ppart="*$ppart*"
		fi
		for x in ${VARDB_DIR}/$cpart/$ppart-$VER_SHPAT; do
			[[ -d "$x" ]] && echo "$x"
		done
		if [[ "$opt_arg_uninstalled" ]]; then
			for x in $portage_trees; do 
				for y in $x/$cpart/$ppart; do
					[[ -d "$y" ]] && echo "$y"
				done
			done
		fi
	) \
	| while read x; do y=${x%/*}; echo ${y##*/}/${x##*/}; done | sort -u \
	| while read cp; do echo -n "    "; format_cpv $cp; done
	trap - SIGPIPE
}

# ============================================================================
# === ARG EXPANSION + USER QUERY
# === expand_arg, argv_dep, lower, upper, userquery.
# ============================================================================

# expand_arg: fill RESULT[] for one user arg per shopt info-type's PNAME/PACKAGE/VIRTUAL/XPACKAGE expansion rules.
function expand_arg() {
	arg="$1"
	if [[ "${shopt_type[${do_info_shopt_idx}]}" != *@(PNAME|PACKAGE|VIRTUAL)* ]]; then
		RESULT=("$arg"); return 0
	fi
	set_xterm_title "Resolving '$arg'..."
	if [[ "$arg" != */* ]]; then
		if [[ "${shopt_type[${do_info_shopt_idx}]}" == "VIRTUAL" ]]; then
			expand_arg virtual/$arg
		else
			results=()
			for cpkg in $(pv_to_cpv $arg); do
				expand_arg $cpkg
				results=("${results[@]}" "${RESULT[@]}")
			done
			RESULT=("${results[@]}")
		fi
	elif [[ "$arg" == *\* ]]; then
		star_arg ${arg%\*}
	elif [[ "$arg" == *-$VER_SHPAT ]]; then
		RESULT=("$arg")
	else
		case "${shopt_type[${do_info_shopt_idx}]}" in
			XPACKAGE )
				star_arg $arg "yes" "yes";;
			PACKAGE | PACKAGE,PNAME )
				star_arg $arg "yes";;
			PNAME | PNAME,PACKAGE | VIRTUAL )
				RESULT=("$arg");;
			*)
				format_error <<<"Argument not implemented" >&2
				RESULT=();;
		esac
	fi
}

# argv_dep: info dispatcher: expand each argv, call info_action_$do_arg_info per match; honour LEGION/--size summary.
function argv_dep() {
	if [[ "$do_arg_info" == "tree-depends" && "$opt_arg_unique_depends" ]]; then
		format_error >&2 <<END
Note: common dependencies will be listed once, under the ${BR}last${NO} package they are depended on by.
END
	fi
	for arg in "$@"; do 
		expand_arg "${arg#=}"
		((${#RESULT[@]} > 0)) \
			|| echo "No matches for '$arg'" | format_error >&2
		for arg2 in "${RESULT[@]}"; do 
			(( opt_arg_verbose > 0 )) && echo "$arg2:"; 
			info_action_$do_arg_info $arg2 "$@"
		done
		[[ "${shopt_itype[${do_info_shopt_idx}]}" == LEGION ]] && break
	done
	[[ "$do_package_sizes" ]] && pkgsize_summary
	# Propagate --required-use violations as a non-zero exit code so the
	# action composes cleanly with shell pipelines / Makefile targets.
	(( ${required_use_violations:-0} > 0 )) && return 1
	return 0
}

# lower: echo $* lowercased via tr.
function lower() {
	echo "$*" | tr '[[:upper:]]' '[[:lower:]]'
}

# upper: echo $* uppercased via tr.
function upper() {
	echo "$*" | tr '[[:lower:]]' '[[:upper:]]'
}

# Pretty much a straight port of the function of the same name in emerge.
# Only difference is in the order of arguments: call as:
# userquery "Make your system ROCK LIKE NINJA?" Yes GR 'Hell Yeah!' CY No RD
# See above for colour codes, or add your own.
function userquery() {
	prompt="${BR}$1${NO} "
	shift
	if [[ $# -eq 0 ]]; then
		rprompt="[${GR}Yes${NO}/${RD}No${NO}] "
		responses=( Yes No )
	else
		rprompt="["
		responses=()
		((n=$#/2))
		for ((i=0; i<n; ++i)); do
			local response=$1; local colour=$2; shift; shift
			[[ $i -eq 0 ]] || rprompt="$rprompt/"
			responses=( "${responses[@]}" $response )
			rprompt="$rprompt${!colour}$response${NO}"
		done
		rprompt="$rprompt] "
	fi
	echo -n "$prompt"
	# Ctrl-C
	trap "echo 'Interrupted.' >&2; exit 0" INT
	while true; do
		if read -e -p "$rprompt"; then
			for ((i=0; i<${#responses[@]}; ++i)); do
				response="${responses[$i]}"
				[[ "$REPLY" == "${response:0:${#REPLY}}" ]] \
				&& return $i
			done
			for ((i=0; i<${#responses[@]}; ++i)); do
				response="${responses[$i]}"
				[[ "$(upper "$REPLY")" == "$(upper "${response:0:${#REPLY}}")" ]] \
				&& return $i
			done
			echo "Sorry, response '$REPLY' not understood." >&2
		else
			# Ctrl-D
			echo "Interrupted." >&2
			exit 0
		fi
	done
	trap - INT
}

# ============================================================================
# === ETC/PORTAGE FILTERS  (depclean output processing)
# === install_new_file, filter_world, filter_etc_file, package_star_filter,
# === package_use_filter, package_mask_filter_inner, package_mask_filter,
# === package_unmask_filter, package_keywords_filter, profile_packages_filter,
# === bashrc_filter, filter_etc_portage, print_stats, ask_install_new_file.
# ============================================================================

# _path_is_within: true when canonical path $1 is root $2 or below it.
function _path_is_within() {
	local path=${1%/} root=${2%/}
	[[ -n "$root" ]] || root=/
	[[ "$root" == / ]] || [[ "$path" == "$root" || "$path" == "$root/"* ]]
}

# _resolve_install_target: canonicalise a write target and enforce the root
# boundary. Existing symlinks are preserved by atomically replacing their
# referent; dangling/cyclic or out-of-root links are rejected.
function _resolve_install_target() {
	local target=$1 root=$2 resolved canonical_root
	canonical_root=$(realpath -m -- "$root") || {
		format_error <<<"cannot resolve write root '$root'" >&2
		return 1
	}
	if [[ -L "$target" ]]; then
		resolved=$(readlink -f -- "$target") || {
			format_error <<<"refusing dangling or cyclic symlink '$target'" >&2
			return 1
		}
		[[ -e "$resolved" ]] || {
			format_error <<<"refusing dangling or cyclic symlink '$target'" >&2
			return 1
		}
	else
		resolved=$(realpath -m -- "$target") || {
			format_error <<<"cannot resolve write target '$target'" >&2
			return 1
		}
	fi
	_path_is_within "$resolved" "$canonical_root" || {
		format_error <<<"refusing write through '$target' outside '$canonical_root'" >&2
		return 1
	}
	[[ ! -e "$resolved" || -f "$resolved" ]] || {
		format_error <<<"refusing to replace non-regular file '$target'" >&2
		return 1
	}
	printf '%s\n' "$resolved"
}

# _install_new_file_atomic: copy candidate content to a same-directory
# temporary, retain the target's metadata, validate and flush it, then rename.
# The old file remains intact on every failure before mv(1).
function _install_new_file_atomic() {
	local new=$1 target=$2 dir base tmp rc preserve
	[[ -f "$new" && -r "$new" ]] || return 1
	dir=${target%/*}; [[ "$dir" == "$target" ]] && dir=.
	base=${target##*/}
	tmp=$(mktemp -- "$dir/.${base}.udept.XXXXXX") || {
		rc=$?; return "$rc"
	}
	cat -- "$new" >"$tmp" || {
		rc=$?; command rm -f -- "$tmp"; return "$rc"
	}
	# Copy metadata only after staging the new content. Copying the old data is
	# wasted I/O, and --preserve=all asks non-root users to retain ownership
	# they cannot set even when the directory is otherwise writable.
	if [[ -e "$target" ]]; then
		preserve=mode,timestamps
		(( EUID == 0 )) && preserve=all
		cp --attributes-only --preserve="$preserve" -- "$target" "$tmp" || {
			rc=$?; command rm -f -- "$tmp"; return "$rc"
		}
	fi
	cmp -s -- "$new" "$tmp" || {
		rc=$?; command rm -f -- "$tmp"; return "$rc"
	}
	sync -f -- "$tmp" 2>/dev/null || sync || {
		rc=$?; command rm -f -- "$tmp"; return "$rc"
	}
	mv -f -- "$tmp" "$target" || {
		rc=$?; command rm -f -- "$tmp"; return "$rc"
	}
	sync -f -- "$dir" 2>/dev/null || true
}

# install_new_file: safely replace $2 with $1.  Direct writes and elevated
# writes use the same atomic helper; elevation is attempted once, so a denied
# authentication cannot create an unbounded prompt loop.
function install_new_file() {
	local new=$1 target=$2 root resolved helper quoted rc
	case "$target" in
		"$ETC_PORTAGE_DIR"|"$ETC_PORTAGE_DIR"/*)
			root="${PORTAGE_CONFIGROOT}${EPREFIX}"
			[[ "$root" ]] || root=/;;
		"$PORTAGE_LIB_DIR"|"$PORTAGE_LIB_DIR"/*) root=${EROOT:-/};;
		*) root=${UDEPT_WRITE_ROOT:-${target%/*}};;
	esac
	[[ "$root" ]] || root=.
	resolved=$(_resolve_install_target "$target" "$root") || return 1
	if (( EUID == 0 )) || [[ -w "${resolved%/*}" ]]; then
		_install_new_file_atomic "$new" "$resolved"
		rc=$?
	else
		helper="$(declare -f _install_new_file_atomic); _install_new_file_atomic \"\$1\" \"\$2\""
		if command -v doas >/dev/null 2>&1; then
			doas bash -c "$helper" _ "$new" "$resolved"; rc=$?
		elif command -v sudo >/dev/null 2>&1; then
			sudo bash -c "$helper" _ "$new" "$resolved"; rc=$?
		elif command -v su >/dev/null 2>&1; then
			echo "Please enter your root password or Ctrl+C, Enter to cancel."
			printf -v quoted 'bash -c %q _ %q %q' "$helper" "$new" "$resolved"
			su -c "$quoted"; rc=$?
		else
			format_error >&2 <<<"no doas/sudo/su found; cannot install '$target' as root"
			return 1
		fi
	fi
	if (( rc != 0 )); then
		format_error <<<"failed to install '$target' from '$new' (status $rc)" >&2
	fi
	return "$rc"
}

# filter_world: pruneworld: drop entries from $WORLD_FILE whose reverse-tree is empty, then ask_install_new_file the rewrite.
function filter_world() {
	# Operates only on the world file ($WORLD_FILE — atom entries). The
	# companion world_sets file ($WORLD_SETS_FILE, set references like
	# @kde-meta) is user-curated; pruneworld doesn't touch it. world_sets
	# *contents* still count as "WORLD" in revdep walks, see _smartdep_nopv.
	cat ${WORLD_FILE} \
	| sort \
	| tee $temp_dir/oldworld \
	| ( 
		while read; do
# a problem: the context in which world revdeps should be evaluated is that of
# depclean, but we can't access that without a full tree walk. Only practical
# difference is that || groups are evaluated to the first already-encountered
# member, not the first already-installed member. Since we can't hope to 
# calculate what that is, we exclude || revdeps.
			if revdeps=$(info_action_reverse-tree "$REPLY" "no" "yes" "safe")
			then 
				echo "$REPLY"
			else
				(
					echo "${RD}!!!REDUNDANT ENTRY!!!${NO} ${BR}$REPLY${NO} ${BL}depended on by${NO}:"
					echo "$revdeps"
				) >&2
			fi
		done | tee $temp_dir/newworld
	)
	print_stats
	ask_install_new_file $temp_dir/oldworld $temp_dir/newworld "$WORLD_FILE" "world file"
}

# filter_etc_file: drive one /etc/portage file's filter: preserve comments, run filter[] callback per line, write to $newfile.
function filter_etc_file() {
	local filename="$1" filter=("${@:2}")
	local newfile="${temp_dir}/${1//\//_}"
	[[ "$filename" == /* ]] || filename="$ETC_PORTAGE_DIR/$filename"
	if ! [[ -e "$filename" ]]; then
		return 0
	elif [[ -d "$filename" ]]; then
		while read -u 3 subfile; do
			filter_etc_file "$subfile" "${filter[@]}"
		done 3< <(find "$filename" -type f -readable)
		return 0
	fi
	echo >&2
	echo "${BR}Checking $filename for redundant entries...${NO}" >&2
	local comments="" attached="" result line args
	# Group the loop so the EOF flush below runs in the SAME subshell
	# (the one piped to tee) where $comments is accumulated.
	{ while read -r; do
		if [[ "${REPLY}" == "#"* ]]; then
			comments="${comments}${REPLY}"$'\n'
		elif [[ -z "${REPLY}" ]]; then
			echo "${comments}"
			comments=""; attached=""
		else
			line="$REPLY"
			while [[ "$REPLY" == *'\' ]]; do 
				read -r; line="$line"$'\n'"$REPLY"
			done
			[[ "$comments" ]] && attached="$comments"; comments=""
			line_no_comments="${line%%*([[:space:]])#*}"
			inline_comments="${line:${#line_no_comments}}"
			if result="$("${filter[@]}" "${line_no_comments}")"; then
				echo -n "${attached}"
				[[ "$result" ]] && echo "${result}${inline_comments}" \
					|| echo "${line}"
				attached=""
			else
				echo "${RD}!!!REDUNDANT ENTRY!!!${NO} ${BR}${line_no_comments}${NO}" >&2
				echo "${RD}${result}${NO}" >&2
				# Discard the comment block that introduced this now-removed
				# entry so it doesn't migrate onto the next kept line.
				attached=""
			fi
		fi
	done <"$filename"
	# Flush a comment block still pending at EOF. Without this, a trailing
	# comment block (or a file consisting entirely of comments) is silently
	# dropped: comments are otherwise emitted only on a blank line or when
	# attached to a kept entry. That was data loss in -E (force) mode.
	[[ "$comments" ]] && printf '%s' "$comments"
	} | tee "$newfile"
	ask_install_new_file "$filename" "$newfile" "$filename" "$1"
}

# package_star_filter: filter_etc dispatcher: expand depatom + args, call test fn per cp/mlsr, retain only effectual args.
function package_star_filter() {
	local test="$1" installed_only="$2" message="$3" line="$4"
	local depatom_args; read -a depatom_args <<<"$line"
	local depatom="${depatom_args[0]}" args=("${depatom_args[@]:1}")
	d_cpv="${depatom/#@(<|<=|=|~|>=|>)}"
	vs="${depatom%${d_cpv}}"
	local effectual_args=() effectual=""
	for d_cpv in $([[ "$d_cpv" == */* ]] && echo "$d_cpv" || pv_to_cpv "$d_cpv"); do
		d_cp="${d_cpv/%-$VER_SHPAT?(\*)}"
		d_mlsr="${d_cpv##${d_cp}?(-)}"
		cp="$d_cp"
		if [[ "$installed_only" ]]; then
			mlsrs=$(provided_mlsrs "$cp")
		else
			mlsrs=$(avail_versions "$cp" "" "" "" "")
		fi
		any_processed=""
		while read mlsr; do
			[[ "$mlsr" ]] || continue
			[[ "$d_mlsr" ]] && ! dep_satisfies_mlsr "$mlsr" "$vs" "$d_mlsr" && continue
			any_processed="yes"
			used_args=()
			${test} "$depatom" "$cp" "$mlsr" "${args[@]}" || continue
			effectual="yes"
			[[ -z "${args[*]}" ]] && break
			for ((i=0; i<${#args[@]}; ++i)); do
				[[ "${effectual_args[$i]}" ]] && continue
				has "${args[$i]}" "${used_args[@]}" || continue
				effectual_args[$i]="${args[$i]}"
			done
		done <<<"$mlsrs"
	done
	if [[ "$effectual" ]]; then
		if [[ "${args[*]}" && "${effectual_args[*]}" != "${args[*]}" ]]; then
			local rest_of_line="${line#*([[:space:]])$depatom}"
			local space="${rest_of_line%%[^[:space:]]*}"
			echo "$depatom$space${effectual_args[*]}"
		fi
		return 0
	fi
	if [[ "$any_processed" ]]; then echo "$message"
	elif [[ "$installed_only" ]]; then echo "no matching packages installed"
	else echo "no matching packages"; fi
	return 1
}

# package_use_filter: drop USE flags from package.use line that already match dbuse — i.e. are already on/off naturally.
function package_use_filter() {
	local depatom="$1" cp="$2" mlsr="$3" flags=("${@:4}")

	alluse=$(dbuse)
	local newflags=()
	for flag in "${flags[@]}"; do
		if { [[ "$flag" == -* ]] && has "${flag#-}" $alluse; } \
			|| { [[ "$flag" != -* ]] && ! has "${flag}" $alluse; }; then
			newflags[${#newflags[@]}]="$flag"
		else
			format_error <<<"flag redundant: ${BR}$cp-$mlsr $flag${NO}" >&2
		fi
	done
	used_args=("${newflags[@]}")
	[[ "${newflags[*]}" ]]
}

# package_mask_filter_inner: package.mask line keepable for cp/mlsr? false if already kw-masked, inclusion-masked, unmasked, or otherwise-masked.
function package_mask_filter_inner() {
	local depatom="$1" cp="$2" mlsr="$3" args=("${@:4}")
	if is_keyword_masked $cp $mlsr $tree; then
		log_message 1 "$cp-$mlsr keyword masked"
	elif is_inclusion_masked "$cp" "$mlsr" "$tree"; then
		log_message 1 "$cp-$mlsr inclusion masked"
	elif is_in_maskfile "$cp" "$mlsr" "$tree" $(etc_portage_files package.unmask); then
		log_message 1 "$cp-$mlsr unmasked"
	elif is_in_maskfile "$cp" "$mlsr" "$tree" "$newfile" $(profile_files_extra package.mask | grep -v "$ETC_PORTAGE_DIR/package.mask"); then
		log_message 1 "$cp-$mlsr otherwise masked"
	else
		return 0
	fi
	return 1
}

# package_mask_filter: package.mask filter: bare '-atom' kept iff still on stack; otherwise delegate to star_filter+inner.
function package_mask_filter() {
	local depatom="$1"
	if [[ "$depatom" == -* ]]; then
		# is the exact depatom in a profile mask?
		if kill_comments_and_blanks "$newfile" $(profile_files_extra package.mask | grep -vF "$filename") 2>/dev/null | stacking_sort yes | grep -qF "${depatom#-}"; then
			return 0
		else
			echo "no matching line to remove from stack"; return 1
		fi
	fi
	package_star_filter package_mask_filter_inner "" "all matching available packages unmasked or otherwise masked" "$depatom"
}

# package_unmask_filter: package.unmask line keepable? false if cp/mlsr is kw-masked, inclusion-masked, already unmasked, or not actually masked.
function package_unmask_filter() {
	local depatom="$1" cp="$2" mlsr="$3" args=("${@:4}")
	if is_keyword_masked $cp $mlsr $tree; then
		log_message 1 "$cp-$mlsr keyword masked"
	elif is_inclusion_masked "$cp" "$mlsr" "$tree"; then
		log_message 1 "$cp-$mlsr inclusion masked"
	elif is_in_maskfile "$cp" "$mlsr" "$tree" "$newfile"; then
		log_message 1 "$cp-$mlsr already unmasked"
	elif ! is_in_maskfile "$cp" "$mlsr" "$tree" $(profile_files_extra package.mask); then
		log_message 1 "$cp-$mlsr not masked"
	else
		return 0
	fi
	return 1
}

# package_keywords_filter: drop keywords from package.accept_keywords lines that are redundant w.r.t. KEYWORDS + ACCEPT_KEYWORDS.
function package_keywords_filter() {
	local depatom="$1" cp="$2" mlsr="$3" keywords=("${@:4}")
	# do any keywords affect this package?
	local my_keywords
	keywords_for $cp-$mlsr "" my_keywords
	has '*' "${my_keywords[@]}" && return 1
	if [[ -z "${keywords[*]}" ]]; then
		# atom only in package.keywords: is ~ARCH in keywords and not ARCH?
		has "~${ARCH}" "${my_keywords[@]}" || return 1
		has "${ARCH}" "${my_keywords[@]}" && return 1
		return 0
	fi
	for keyword in "${keywords[@]}"; do 
		case "$keyword" in
		-\*) # -* in package.keywords: is -* in keywords and no other accept?
			has "$keyword" "${my_keywords[@]}" || continue
			( for my_keyword in "${my_keywords[@]}"; do
				has "$my_keyword" "${ACCEPT_KEYWORDS[@]}" || continue
				return 1
			done ) || continue;;
		-*) # -x in package.keywords: is x in keywords and in accept?
			has "${keyword#-}" "${my_keywords[@]}" || continue
			has "${keyword#-}" "${ACCEPT_KEYWORDS[@]}" || continue;;
		\*) # * in package.keywords: is a stable in keywords and not in accept?
			( for my_keyword in "${my_keywords[@]}"; do
				[[ "$my_keyword" == -* ]] && continue
				[[ "$my_keyword" == ~* ]] && continue
				has "$my_keyword" "${ACCEPT_KEYWORDS[@]}" && continue
				return 1
			done ) && continue;;
		~\*) # ~* in package.keywords: anything in keywords not in accept?
			( for my_keyword in "${my_keywords[@]}"; do
				[[ "$my_keyword" == -* ]] && continue
				has "$my_keyword" "${ACCEPT_KEYWORDS[@]}" && continue
				return 1
			done ) && continue;;
		*) # a positive keyword: in keywords not in accept?
			has "$keyword" "${my_keywords[@]}" || continue
			has "$keyword" "${ACCEPT_KEYWORDS[@]}" && continue;;
		esac
		used_args[${#used_args[@]}]="$keyword"
	done
	[[ "${used_args[*]}" ]]
}

# profile_packages_filter: profile/packages line keepable iff its '-X' removal still has an effect (X is on stack) or its '+X' addition still has an effect (X is NOT on stack).
function profile_packages_filter() {
	local pline="$1"
	if [[ "$pline" == -* ]]; then
		if kill_comments_and_blanks "$newfile" $(profile_files packages | grep -vF "$filename") 2>/dev/null | stacking_sort yes | grep -qF "${pline#-}"; then
			return 0
		else
			echo "no matching line to remove from stack"; return 1
		fi
	else
		if kill_comments_and_blanks "$newfile" $(profile_files packages | grep -vF "$filename") 2>/dev/null | stacking_sort yes | grep -qF "${pline#-}"; then
			echo "already on stack"; return 1
		else
			return 0
		fi
	fi
}

# bashrc_filter: rewrite a bashrc '|| [[ $CATEGORY/$P == foo ]] && ...' chain, keeping only branches whose ebuild env matches an installed pkg.
function bashrc_filter() {
	# $list is a scalar here. Shellcheck's cross-function inference
	# sees an array named 'list' in stacking_sort (~line 1481) and
	# flags both the declaration (SC2178) and the redirect below
	# (SC2128) as if they were array operations.
	# shellcheck disable=SC2178
	local list="$1" out="" omitted=""
	local branch_re='^(\|\| )?\[\[ ("?)([^ ]*)\2 == ("?)([^ ]*/[^ ]*)\4 \]\] \\'
	# Supported syntax: [[ "$CATEGORY/$P" == app-foo/bar-2.1 ]] \
	# || [[ "$CATEGORY/$PN" == sys-baz/zork ]] \
	# && ...
	# Note on `done <<<"$list"` below: $list here is the scalar local
	# declared just above. Shellcheck's cross-function inference sees
	# an array named 'list' in stacking_sort (~line 1481) and flags
	# the redirect as SC2128 false-positive on the array shape.
	# shellcheck disable=SC2128
	while read -r; do
		if [[ "$REPLY" =~ $branch_re ]]; then
			local match="${BASH_REMATCH[3]}" target="${BASH_REMATCH[5]}"
			local cp="${target%-$VER_SHPAT*}" found="" mlsr
			for mlsr in $(provided_mlsrs "$cp"); do 
				if (
					mls="${mlsr%-r+([[:digit:]])}"; rev="${mlsr#$mls-}"
					PN="${cp##*/}"; P="$PN-$mls"; PV="$mls"; PR="${rev:-r0}"
					# Portage env-var injection consumed by the `eval [[
					# "$match" == "$target" ]]` below — user-supplied
					# match patterns reference $P / $PV / $PF / $CATEGORY
					# etc. Static analysis can't trace the eval link,
					# hence SC2034 on the seemingly-unused names.
					# shellcheck disable=SC2034
					{ PVR="$mlsr"; PF="$PN-$mlsr"; CATEGORY="${cp%/*}"; }
					for x in ${VARDB_DIR}/$cp-$mlsr/+([[:upper:]]); do
						[[ -r "$x" ]] && read ${x##*/} <<<"$(<"$x")"
					done
					eval [[ "$match" == "$target" ]]
				); then found="yes"; break; fi
			done
			if [[ "$found" ]]; then
				log_message 2 "$match == $target found in installed packages"
				out="${out}${out:+$'\n'}${REPLY}"
			else
				log_message 1 "no installed package with $match == $target"
				omitted="yes"
			fi
		elif [[ -z "$omitted" || "$out" || "$REPLY" == '|| [['* || "$REPLY" == '[['* ]]; then
			out="${out}${out:+$'\n'}${REPLY}"
		else
			echo "All tests failed"; return 1
		fi
	done <<<"$list"
	[[ "$omitted" ]] && echo "${out#|| }"
	return 0
}

# filter_etc_portage: --filter-etc-portage: run package.use / package.mask / package.unmask / package.accept_keywords / package.keywords (legacy) / profile/packages / bashrc.
function filter_etc_portage() {
	filter_etc_file package.use package_star_filter package_use_filter yes "all use flags redundant"
	filter_etc_file package.mask package_mask_filter
	filter_etc_file package.unmask package_star_filter package_unmask_filter "" "no matching available packages masked by a package.mask"
	# package.accept_keywords is the canonical modern name; legacy
	# package.keywords still works if present.
	filter_etc_file package.accept_keywords package_star_filter package_keywords_filter "" "all keywords redundant"
	filter_etc_file package.keywords package_star_filter package_keywords_filter "" "all keywords redundant"
	filter_etc_file profile/packages profile_packages_filter
	filter_etc_file bashrc bashrc_filter
}
	
# print_stats: to stderr: counts and percentages of world/system/installed pkgs after filter_world runs.
function print_stats() {
	n=$(wc -l <$temp_dir/newworld)
	world=$(wc -l <$temp_dir/oldworld)
	red=$((world - n))
	sys=$(echo "${allprofilepackages}" | wc -l)
	inst=$(echo ${VARDB_DIR}/*/*/PF | wc -w)
	(
		echo
		echo \
	"${space::5-${#world}}${BR}$world${NO} packages in ${YL}world${NO}: " \
	"${BR}$n${NO} ${GR}valid${NO}, " \
	"${BR}$red${NO} ${RD}redundant${NO};"
		echo \
	"${space::5-${#sys}}${BR}$sys${NO} packages in ${YL}system${NO};"
		echo \
	"${space::5-${#inst}}${BR}$inst${NO} packages installed:" \
	"${BR}$(($sys * 100 / $inst))%${NO} in ${YL}system${NO}," \
	"${BR}$(($world * 100 / $inst))%${NO} in ${YL}world${NO}," \
	"${BR}$((($inst - $sys - $world + $red) * 100 / $inst))%${NO} ${FC}deps${NO}."
	) >&2
}
	
# ask_install_new_file: if old/new differ, prompt Install/Skip/Diff/Merge (or honor --pretend/--ask/--force) and install_new_file.
function ask_install_new_file() {
	local old="$1" new="$2" target="$3" name="$4"
	local merged="$temp_dir/merged-${old//\//_}"
	diff -q "$old" "$new" >/dev/null && return
	case $do_action in
		# --pretend is a dry-run: filter_etc_file/filter_world already
		# printed the candidate file (stdout) and flagged the dropped
		# entries (stderr) before calling us. Return rather than exit, so
		# filter_etc_portage keeps walking the remaining files instead of
		# stopping at the first one that has changes.
		pretend ) return 0;;
		ask ) while :; do
			userquery "Install new $name?" Install GR Skip RD Diff BL Merge FC
			case $? in
				0 ) install_new_file "$new" "$target" && break;;
				1 ) break;;
				2 ) diff -u "$old" "$new" | ${PAGER:-less};;
				3 ) 
				sdiff -o "$merged" "$old" "$new"
				[[ $? -eq 2 ]] || cat "$merged" >"$new";;
			esac
		done;;
		force )	install_new_file "$new" "$target"; return $?;;
	esac
}

# ============================================================================
# === INSPECT — PATCH-TREE / OVERLAY
# === inspect_patch_tree_check_data_is_highest_patched,
# === inspect_patch_tree_check_slots, inspect_patch_tree_check_arches,
# === inspect_patch_tree, inspect_overlay_best_in_slot,
# === inspect_overlay_best_in_slot_arches, inspect_overlay, overlay_clean.
# ============================================================================

# inspect_patch_tree_check_data_is_highest_patched: populate mlsrs/mlsr_trees/mlsr_slots/mlsr_pmask/mlsr_match arrays for cp by matching dn against avail ebuilds.
function inspect_patch_tree_check_data_is_highest_patched() {
	while read _mlsr mlsr_tree; do
		mlsr=$_mlsr
		i=${#mlsrs[@]}
		mlsrs[$i]=$mlsr
		mlsr_trees[$i]=$mlsr_tree
		mlsr_slots[$i]=$(slot_for "$cp-$mlsr" "$mlsr_tree")
		is_package_masked "$cp" "$mlsr" "$mlsr_tree" && mlsr_pmask[$i]="yes"
		mls="${mlsr%-r+([[:digit:]])}"; rev="${mlsr#$mls-}"
		# Locals P/PN/PV/PR/PVR/PF/SLOT mirror Portage's standard
		# ebuild env-var set. Only some are read by the pattern match
		# below (PN, P, PR, PVR, SLOT); PV and PF stay declared for
		# symmetry with the established convention — easier to read
		# the whole block as "the ebuild env" than to elide names.
		# shellcheck disable=SC2034
		local P="$pn-$mls" PN="$pn" PV="$mls" PR="${rev:-r0}" PVR="$mlsr"
		# shellcheck disable=SC2034
		local PF="$pn-$mlsr" SLOT="${mlsr_slots[$i]}"
		# Same intentional pattern match as inspect_patch_tree above —
		# $dn may carry a version wildcard.
		# shellcheck disable=SC2053
		[[ "$dn" == "$PN" || "$dn" == "$P" || "$dn" == "$P-$PR" \
			|| "$dn" == "${PN}[$SLOT]" || "$PVR" == ${dn#$PN-} ]] \
			&& mlsr_match[$i]=$mlsr
	done <<<"$(avail_versions "$cp" yes | mlsr_sort)"
}

# inspect_patch_tree_check_slots: true if any mlsr in the populated arrays is best-in-slot under given arches/pmask/portdir-only constraints.
function inspect_patch_tree_check_slots() {
	local arches=$1 excl_pmask=$2 pd_only=$3
	local patch_used="" oldslot; unset oldslot
	[[ "$arches" ]] && local ACCEPT_KEYWORDS=( $arches )
	for ((i=${#mlsrs[@]}-1; i>=0; --i)); do
		mlsr=${mlsrs[$i]}; slot=${mlsr_slots[$i]}
		[[ "${oldslot+set}" && "$slot" == "$oldslot" ]] && continue
		[[ "$pd_only" && "${mlsr_trees[$i]}" != "$PORTDIR" ]] && continue
		[[ "$excl_pmask" && "${mlsr_pmask[$i]}" ]] && continue
		[[ "$arches" ]] && is_keyword_masked "$cp" "$mlsr" && continue
		[[ "${mlsr_match[$i]}" ]] && { patch_used="yes"; break; }
		oldslot=$slot
	done
	[[ "$patch_used" ]]
}

# inspect_patch_tree_check_arches: iterate /profiles/arch.list and return on first arch where _check_slots passes (stable then ~arch).
function inspect_patch_tree_check_arches() {
	local pd_only=$1
	for arch in $(< $PORTDIR/profiles/arch.list); do
		inspect_patch_tree_check_slots "$arch" "yes" "$pd_only" && break
		stable="$arch"; arch="~$arch"
		inspect_patch_tree_check_slots "$stable $arch" "yes" "$pd_only" && break
	done
}

# inspect_patch_tree: walk an /etc/portage/patches-style tree; echo svn/git/rm commands for patchdirs that are empty, have no matching ebuild, or whose match is no longer best-in-slot.
function inspect_patch_tree() {
	local tree="$1" rm_command rmdir_command patchdir patches
	if [[ -d "$tree/.svn" ]]; then
		rm_command="svn rm"; rmdir_command="svn rm"
	elif [[ -d "$tree/.git" || -d "$tree/../.git" ]]; then
		rm_command="git rm"; rmdir_command="git rm -r"
	else
		rm_command="rm"; rmdir_command="rm -r"
	fi
	for patchdir in $tree/*/*; do
		[[ -d "$patchdir" ]] || continue
		local cdn dn cp pn mlsr="" tree mls rev slot
		local mlsrs=() mlsr_trees=() mlsr_slots=() mlsr_match=() mlsr_pmask=()
		cdn=${patchdir#$tree/}; dn=${cdn##*/}
		cp=${cdn%@(\[*\]|-${VER_SHPAT}?(?(.)\*))}; pn=${cp##*/}
		patches=("$patchdir"/*)
		# Same glob-presence pattern: with nullglob off, unmatched glob
		# stays literal so patches[0] fails -e and we hit the "no
		# patches" branch.
		if [[ ! -e "${patches[0]}" ]]; then
			log_message 1 "$patchdir does not contain any patches"
			echo "$rmdir_command '$patchdir'"
		elif [[ "$cp" == "$cdn" ]]; then
			log_message 1 "$cdn is a package name, retaining"
		elif inspect_patch_tree_check_data_is_highest_patched; then
			log_message 1 "$cdn matches $mlsr, highest version"
		elif (( ${#mlsr_match[@]} == 0 )); then
			log_message 1 "$cdn does not match any ebuilds"
			echo "$rmdir_command '$patchdir'"
		elif inspect_patch_tree_check_slots "" "" ""; then
			log_message 1 "$cdn matches $mlsr, best in slot $slot"
		elif inspect_patch_tree_check_slots "" "yes" ""; then
			log_message 1 "$cdn matches $mlsr, best unmasked in slot $slot"
		elif inspect_patch_tree_check_arches ""; then
			log_message 1 "$cdn matches $mlsr, best in slot $slot on $arch"
		elif inspect_patch_tree_check_slots "" "" "yes"; then
			log_message 1 "$cdn matches $mlsr, best in slot $slot in \$PORTDIR"
		elif inspect_patch_tree_check_slots "" "yes" "yes"; then
			log_message 1 "$cdn matches $mlsr, best unmasked in slot $slot in \$PORTDIR"
		elif inspect_patch_tree_check_arches "yes"; then
			log_message 1 "$cdn matches $mlsr, best in slot $slot on $arch in \$PORTDIR"
		else
			echo "$rmdir_command '$patchdir'"
		fi
	done
}

# inspect_overlay_best_in_slot: true if overlay's mlsr is >= every PORTDIR mlsr in the same slot (with optional arch/pmask filters).
function inspect_overlay_best_in_slot() {
	local arch=$1 cp=$2 overlay_mlsr=$3 overlay_slot=$4 excl_pmask=$5
	if [[ "$arch" ]]; then
		local ACCEPT_KEYWORDS=( $arch )
		is_keyword_masked "$cp" "$overlay_mlsr" "$overlay" && return 1
	fi
	for ((i=${#mlsrs[@]}-1; i>=0; --i)); do
		local mlsr=${mlsrs[$i]} slot=${mlsr_slots[$i]}
		[[ "$slot" == "$overlay_slot" ]] || continue
		[[ "$excl_pmask" && "${mlsr_pmask[$i]}" ]] && continue
		[[ "$arch" ]] && is_keyword_masked "$cp" "$mlsr" "$PORTDIR" && continue
		vercmp "$mlsr" "<=" "$overlay_mlsr"; return $?
	done
	return 0
}

# inspect_overlay_best_in_slot_arches: iterate /profiles/arch.list and return on first arch where _best_in_slot passes (stable then ~arch).
function inspect_overlay_best_in_slot_arches() {
	for arch in $(< $PORTDIR/profiles/arch.list); do
		inspect_overlay_best_in_slot "$arch" "$@" "yes" && break
		stable="$arch"; arch="~$arch"
		inspect_overlay_best_in_slot "$stable $arch" "$@" "yes" && break
	done
}

# inspect_overlay: walk overlay $1's cat/pkg dirs; echo rm/manifest commands for ebuilds superseded in PORTDIR.
function inspect_overlay() {
	local overlay="${1%/}"
	for ebdir in "$overlay"/*/*; do
		[[ -d "$ebdir" ]] || continue
		local delete_mlsrs=() keep_any=""
		cp=${ebdir#$overlay/}; cat=${cp%/*}; pn=${cp#*/}
		local mlsrs=() mlsr_slots=() mlsr_pmask=()
		if [[ ! -d "$PORTDIR/$cp" ]]; then
			log_message 2 "$cp not in \$PORTDIR; ignoring"
			continue
		fi
		while read mlsr mlsr_tree; do
			[[ "$mlsr_tree" == "$PORTDIR" ]] || continue
			i=${#mlsrs[@]}
			mlsrs[$i]=$mlsr
			mlsr_slots[$i]=$(slot_for "$cp-$mlsr" "$mlsr_tree")
			is_package_masked "$cp" "$mlsr" "$mlsr_tree" && mlsr_pmask[$i]="yes"
		done <<<"$(avail_versions "$cp" yes | mlsr_sort)"
		if (( "${#mlsrs[@]}" == 0 )); then
			log_message 2 "$cp not in \$PORTDIR; ignoring"
			continue
		fi
		for ebuild in "$ebdir"/*.ebuild; do
			[[ -f "$ebuild" ]] || continue
			ebuild=${ebuild#$ebdir/}; pv=${ebuild%.ebuild}; cpv=$cat/$pv
			mlsr=${pv#$pn-}; slot=$(slot_for "$cp-$mlsr" "$overlay")
			if vercmp "$mlsr" ">=" "${mlsrs[$((${#mlsrs[@]}-1))]}"; then
				in_message=""
			elif inspect_overlay_best_in_slot "" "$cp" "$mlsr" "$slot" ""; then
				in_message="in slot $slot "
			elif inspect_overlay_best_in_slot "" "$cp" "$mlsr" "$slot" yes; then
				in_message="unmasked in slot $slot "
			elif inspect_overlay_best_in_slot_arches "$cp" "$mlsr" "$slot"; then
				in_message="unmasked in slot $slot on $arch "
			else
				delete_mlsrs[${#delete_mlsrs[@]}]=$mlsr
				log_message 1 "$cp-$mlsr ebuild is redundant"
				continue
			fi
			log_message 1 "$cp-$mlsr best ${in_message}against \$PORTDIR"
			keep_any="$mlsr"
		done
		if [[ -d "$ebdir/.svn" ]]; then
			rm_command="svn rm"; rmdir_command="svn rm"
		elif [[ -d "$ebdir/.git" || -d "$ebdir/../../.git" ]]; then
			rm_command="git rm"; rmdir_command="git rm -r"
		else
			rm_command="rm"; rmdir_command="rm -r"
		fi
		if [[ ! -f "$ebdir/$ebuild" ]]; then
			log_message 1 "$ebdir does not contain any ebuilds"
			echo "$rmdir_command '$ebdir'"
		elif [[ "$keep_any" ]]; then
			# Manifest2 keeps all hashes (DIST + EBUILD + AUX) in a single
			# top-level 'Manifest' file regenerated by 'ebuild ... manifest';
			# no separate files/digest-* to delete (those were Manifest1).
			for mlsr in "${delete_mlsrs[@]}"; do
				echo "$rm_command '$ebdir/$pn-$mlsr.ebuild'"
			done
			echo "ebuild '$ebdir/$pn-$keep_any.ebuild' manifest"
		else
			echo "$rmdir_command '$ebdir'"
		fi
	done
}

# overlay_clean: --overlay-clean: dispatch each arg to inspect_patch_tree or inspect_overlay; default to first non-PORTDIR repo.
function overlay_clean() {
	if (( $# )); then
		for overlay in "$@"; do
			if ! [[ -d "$overlay" ]]; then
				format_error <<<"no such directory: $overlay" >&2
				continue
			elif [[ "$overlay" == */patches ]]; then
				inspect_patch_tree $overlay
			else
				inspect_overlay $overlay
			fi
		done
	else
		# No overlay argument: pick the highest-priority non-main repo.
		# After phase 1, $portage_trees is priority-ordered, with $PORTDIR
		# (main-repo) somewhere in the list — usually last.
		local tree
		for tree in $portage_trees; do
			[[ "$tree" == "$PORTDIR" ]] && continue
			inspect_overlay "$tree"
			return
		done
		format_error <<<"no overlay specified and no non-main repo found in repos.conf" >&2
		return 1
	fi
}

# ============================================================================
# === MAIN
# === main — the dispatch entry point.  Parses argv, runs resolve_eroot_paths
# === post help/version short-circuit, dispatches to info_action_* / action_* /
# === filter_etc_portage based on the parsed flag set.
# ============================================================================

# main: entry point: probe paths, load Portage config if needed, dispatch on do_arg_action to filter/redundant/info/etc.
function main() {
	# All real actions need the install-prefix paths, even owners (which
	# otherwise skips load_portage_config to save the heavier setup).
	resolve_eroot_paths || exit 2
	if [[ "$load_config" ]]; then
		set_xterm_title "Loading Portage configuration..."
		load_portage_config
	fi
	set_xterm_title "Processing commands..."
	case "$do_arg_action" in
		exec )
			# Intentional eval: --exec passes a single argv element
			# that's a literal shell snippet, which must be re-parsed
			# to run as a command. SC2294 hints at dropping eval to
			# preserve array semantics, but here we WANT string re-eval.
			# shellcheck disable=SC2294
			time eval "${args[@]}"
			echo $'\n'"Return value: $?; RESULT: ${RESULT[*]}" >&2;;
		purge | depclean )
			my_redundant="$(redundant "${args[@]}")"
			[[ "${my_redundant}" ]] \
				&& emerge -vC $portage_action_arg $my_redundant \
				|| echo "No redundant packages found." | format_error >&2;;
		spring-clean )
			makeideal;;
		pruneworld )
			filter_world;;
		filter-etc-portage )
			filter_etc_portage;;
		overlay-clean )
			overlay_clean "${args[@]}";;
		info )
			argv_dep "${args[@]}";;
		* )
			echo "Nothing to do." | format_error >&2
			exit 1
	esac
}

[[ "$0" == */dep ]] && main
