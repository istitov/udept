dist_noinst_SCRIPTS = depman.sh
dist_man1_MANS = dep.1
# dep.1 ships pre-generated in the tarball (dist_man1_MANS) but is also
# rebuilt in $(builddir) when src/dep changes. CLEANFILES wipes the
# builddir copy on `make clean` / `make distclean` so distcheck's
# distcleancheck doesn't see it as a leftover. In an in-tree build,
# srcdir == builddir, so `make clean` removes it and the next `make`
# regenerates it from src/dep.
CLEANFILES = dep.1

# src/dep is generated by config.status from src/dep.in, so it lives in
# the builddir — not the srcdir. Using $(top_srcdir) here breaks under
# distcheck's split srcdir/builddir layout (the unpacked tarball has
# only dep.in). depman.sh itself is dist_noinst and stays in srcdir.
dep.1: $(top_builddir)/src/dep $(srcdir)/depman.sh
	$(srcdir)/depman.sh $(top_builddir)/src/dep >dep.1

