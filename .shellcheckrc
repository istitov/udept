# shellcheck configuration for the udept source tree.
# https://github.com/koalaman/shellcheck/wiki/Directive
#
# CI enforces `shellcheck --severity=error src/dep` — so warnings
# and below do not block builds. This file lowers the noise floor
# for developers running plain `shellcheck src/dep` locally.
#
# Inline `# shellcheck disable=...` directives in src/dep.in cover
# the per-site cases (intentional patterns, false positives from
# cross-function inference). The disables below are for systemic
# styles the author leaned on consistently across the script —
# mechanical "fixes" would be invasive and regress behaviour.

# SC2046 — Quote this to prevent word splitting.
# dep.in deliberately uses unquoted command substitution to feed
# space-separated lists of atoms / file paths / tokens as separate
# arguments to the following command, e.g.:
#
#   kill_comments_and_blanks $(etc_portage_files package.use)
#   is_in_maskfile "$cp" "$mlsr" $(etc_portage_files package.unmask)
#
# Quoting would collapse each list to a single argument. This is
# the project's read-input-to-args idiom; ~27 sites.
disable=SC2046

# SC2206 — Quote to prevent word splitting/globbing on array
# assignment from $(...) or word-split strings.
# Same intent as SC2046, expressed as array construction:
#
#   s1_m=( ${s1_m//./ } )        # split version on '.'
#   s1_ss=( ${s1_ss//_/ } )      # split status suffix on '_'
#   ACCEPT_KEYWORDS=( $arches )  # split arches into array
#   eclasses=(${REPLY#_eclasses_=})  # split eclass list
#
# ~20 sites; all are intentional whitespace-split into arrays.
disable=SC2206

# SC2229 — read into $var (where $var holds a name).
# Two sites in get_accept_keywords use `read -a "$return"` for
# indirect array assignment — the caller passes the name of the
# output variable and the callee reads into that name. This is the
# pre-`declare -n` pattern bash had before nameref support, and
# converting it would touch every caller. Shellcheck suggests
# `${var?}` to quote, which would just change the false-positive
# message without addressing intent.
disable=SC2229
