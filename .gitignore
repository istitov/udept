.DS_Store
*.backup
*.diff
*.orig
*.patch
*.swp
autom4te.cache/

# autotools build artefacts — generated by `autoreconf -i`; shipped in the
# release tarball by `make dist` but regenerated by CI, so not tracked.
configure
configure~
aclocal.m4
config.log
config.status
install-sh
missing
Makefile
Makefile.in
*/Makefile
*/Makefile.in
src/dep
completion/dep
completion/_dep

# regenerated by automake --add-missing; LICENSE is the canonical file
COPYING

# editor / IDE / agent state
.claude/

# local smoke-test baselines — per-host snapshots that include the
# system's installed-package inventory and aren't portable between
# machines. 'make smoke-baseline' writes the default path here.
tests/baseline.local
tests/baseline.local.*

# local-only tooling: drives the config-mutating actions over a copy of THIS
# host's real /etc/portage, so it must never be committed (its existence and
# any output it produces are host-specific). The committed equivalent runs
# over synthetic fixtures in tests/property/.
/scripts/verify-local.sh
